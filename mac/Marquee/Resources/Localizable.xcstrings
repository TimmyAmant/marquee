    "Sends a push notification through Pushover whenever something is grabbed, downloaded, or a request is approved/rejected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt eine Push-Benachrichtigung über Pushover, sobald etwas gegrabbt oder heruntergeladen oder eine Anfrage genehmigt bzw. abgelehnt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía una notificación push con Pushover cada vez que algo se captura o se descarga, o una solicitud se aprueba o se rechaza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie une notification push via Pushover chaque fois qu’un élément est récupéré ou téléchargé, ou qu’une demande est approuvée ou refusée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia uma notificação push pelo Pushover sempre que algo é capturado, baixado ou um pedido é aprovado/recusado."
          }
        }
      }
    },
    "Sends a push notification via ntfy.sh (or a self-hosted ntfy server) for the events picked under Household events." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt für die unter „Ereignisse im Haushalt“ gewählten Ereignisse eine Push-Benachrichtigung über ntfy.sh (oder einen eigenen ntfy-Server) an dein Handy oder deinen Computer. Mitglieder können auf diesem Server ihr eigenes Topic wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía una notificación push a tu móvil u ordenador mediante ntfy.sh (o un servidor ntfy propio) para los eventos elegidos en Eventos del hogar. Los miembros pueden elegir su propio tema en este servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie une notification push sur votre téléphone ou votre ordinateur via ntfy.sh (ou un serveur ntfy auto-hébergé) pour les événements choisis dans Événements du foyer. Les membres peuvent choisir leur propre sujet sur ce serveur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia uma notificação push para o seu celular ou computador pelo ntfy.sh (ou um servidor ntfy próprio) para os eventos escolhidos em Eventos da casa. Os membros podem escolher o próprio tópico neste servidor."
          }
        }
      }
    },
