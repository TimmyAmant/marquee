    "Anyone your provider lets in gets a member account on first sign-in. Off: only accounts that linked it can use it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder, den dein Anbieter reinlässt, bekommt bei der ersten Anmeldung ein Mitgliedskonto. Aus: Nur Konten, die es verknüpft haben, können es nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera a quien tu proveedor deje entrar obtiene una cuenta de miembro al iniciar sesión por primera vez. Desactivado: solo pueden usarlo las cuentas que lo hayan vinculado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne acceptée par votre fournisseur obtient un compte membre à sa première connexion. Désactivé : seuls les comptes qui l’ont associé peuvent l’utiliser."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa que o seu provedor deixar entrar ganha uma conta de membro no primeiro login. Desativado: só as contas que o vincularam podem usá-lo."
          }
        }
      }
    },
