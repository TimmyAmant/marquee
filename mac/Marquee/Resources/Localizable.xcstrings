    "Choose where each kind of notification goes. The bell is the list at the top of every page; devices are the browsers, Macs and PCs you turned notifications on for." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg fest, wohin jede Art von Benachrichtigung geht. Die Glocke ist die Liste oben auf jeder Seite; Geräte sind die Browser, Macs und PCs, auf denen du Benachrichtigungen eingeschaltet hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige adónde va cada tipo de notificación. La campana es la lista de la parte superior de cada página; los dispositivos son los navegadores, Macs y PCs en los que activaste las notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez où va chaque type de notification. La cloche est la liste en haut de chaque page ; les appareils sont les navigateurs, Mac et PC sur lesquels vous avez activé les notifications."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha para onde vai cada tipo de notificação. O sino é a lista no topo de cada página; os dispositivos são os navegadores, Macs e PCs em que você ativou as notificações."
          }
        }
      }
    },
