    "The built-in rows go back to their usual order, all shown. Your own rows stay, after them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die eingebauten Reihen kehren in ihre übliche Reihenfolge zurück und werden alle angezeigt. Deine eigenen Reihen bleiben, dahinter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las filas integradas vuelven a su orden habitual y se muestran todas. Tus propias filas se mantienen, después de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rangées intégrées reprennent leur ordre habituel, toutes affichées. Vos propres rangées restent, après elles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fileiras padrão voltam à ordem de sempre, todas visíveis. As suas próprias fileiras continuam, depois delas."
          }
        }
      }
    },
    "The download didn't finish. Check your internet connection and try again." : {
      "localizations" : {
        "de" : {
