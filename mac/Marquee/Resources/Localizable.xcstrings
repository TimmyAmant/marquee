    "Marquee at %@ isn't answering right now. If it's restarting or updating, this reconnects by itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquee unter %@ antwortet gerade nicht. Wenn es neu startet oder aktualisiert wird, verbindet sich die App von selbst wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquee en %@ no responde en este momento. Si se está reiniciando o actualizando, se volverá a conectar solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquee à %@ ne répond pas pour le moment. S’il redémarre ou se met à jour, la connexion reviendra toute seule."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Marquee em %@ não está respondendo agora. Se ele estiver reiniciando ou atualizando, a conexão volta sozinha."
          }
        }
      }
    },
