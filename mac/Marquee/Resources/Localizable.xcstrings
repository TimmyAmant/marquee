    "iOS is blocking Marquee from your home network. Turn it on in Settings, then try again." : {
      "comment" : "Marquee for iPhone only.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS blockiert den Zugriff von Marquee auf dein Heimnetz. Schalte ihn in den Einstellungen ein und versuch es dann noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS está bloqueando el acceso de Marquee a tu red doméstica. Actívalo en Ajustes e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS empêche Marquee d’accéder à votre réseau domestique. Activez-le dans Réglages, puis réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS está bloqueando o acesso do Marquee à sua rede doméstica. Ative nos Ajustes e tente de novo."
          }
        }
      }
    },
    "iOS will ask for permission first. Tap Allow so Marquee can reach your server." : {
      "comment" : "Marquee for iPhone only.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS fragt zuerst nach deiner Erlaubnis. Tippe auf „Erlauben“, damit Marquee deinen Server erreichen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pedirá permiso primero. Toca Permitir para que Marquee pueda acceder a tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS vous demandera d’abord l’autorisation. Touchez Autoriser pour que Marquee puisse joindre votre serveur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS vai pedir permissão primeiro. Toque em Permitir para o Marquee acessar seu servidor."
          }
        }
      }
    },
