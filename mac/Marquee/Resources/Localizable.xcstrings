        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está vinculado. Ya puedes iniciar sesión con él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est associé. Vous pouvez maintenant vous connecter avec."
