    "Quickest: open the household's bot, @%@, press Start, and come back. Marquee finds your chat by itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am schnellsten: Öffne den Bot des Haushalts, @%@, tippe auf „Starten“ und komm zurück. Marquee findet deinen Chat von selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo más rápido: abre el bot del hogar, @%@, pulsa Iniciar y vuelve. Marquee encuentra tu chat por sí solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus rapide : ouvrez le bot du foyer, @%@, appuyez sur Démarrer et revenez. Marquee trouve votre conversation tout seul."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mais rápido: abra o bot da casa, @%@, toque em Iniciar e volte. O Marquee encontra seu chat sozinho."
