    "Emails one or more addresses through your own mail server (SMTP) whenever something is grabbed, downloaded, or a request is approved/rejected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt über deinen eigenen Mailserver (SMTP) E-Mails an eine oder mehrere Adressen, sobald etwas gegrabbt oder heruntergeladen oder eine Anfrage genehmigt/abgelehnt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía correos a una o más direcciones mediante tu propio servidor de correo (SMTP) cada vez que algo se captura o se descarga, o se aprueba/rechaza una solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie un e-mail à une ou plusieurs adresses via votre propre serveur de messagerie (SMTP) dès que quelque chose est récupéré ou téléchargé, ou qu’une demande est approuvée/refusée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia e-mails para um ou mais endereços pelo seu próprio servidor de e-mail (SMTP) sempre que algo é capturado ou baixado, ou um pedido é aprovado/recusado."
          }
        }
      }
    },
    "Emby speaks the same language as Jellyfin, so either works here — connected to %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emby spricht dieselbe Sprache wie Jellyfin, daher funktioniert hier beides – verbunden mit %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emby habla el mismo idioma que Jellyfin, así que aquí sirve cualquiera de los dos. Conectado a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emby parle le même langage que Jellyfin : l’un ou l’autre fonctionne ici — connecté à %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emby fala a mesma língua do Jellyfin, então qualquer um funciona aqui — conectado a %@."
