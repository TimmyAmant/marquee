    "%@ answered with an error (%@). If Marquee is starting up, try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat mit einem Fehler geantwortet (%@). Wenn Marquee gerade startet, versuch es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ respondió con un error (%@). Si Marquee se está iniciando, vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a répondu par une erreur (%@). Si Marquee est en train de démarrer, réessayez dans un instant."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ respondeu com um erro (%@). Se o Marquee estiver iniciando, tente novamente em instantes."
          }
        }
      }
    },
    "%@ can be added once the admin sets it up for the household." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann hinzugefügt werden, sobald der Admin es für den Haushalt eingerichtet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se podrá añadir cuando el administrador lo configure para el hogar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pourra être ajouté une fois que l’administrateur l’aura configuré pour le foyer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ poderá ser adicionado quando o administrador configurá-lo para a casa."
          }
        }
      }
    },
    "%@ can be added once the admin sets them up for the household." : {
