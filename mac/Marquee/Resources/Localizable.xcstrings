    "%@ responded, but it isn't a Marquee server. Check the address and port." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat geantwortet, ist aber kein Marquee-Server. Prüf Adresse und Port."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ respondió, pero no es un servidor Marquee. Comprueba la dirección y el puerto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a répondu, mais ce n’est pas un serveur Marquee. Vérifiez l’adresse et le port."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ respondeu, mas não é um servidor Marquee. Verifique o endereço e a porta."
          }
        }
      }
    },
    "%@ stops tracking it on every server that has it. Its approved requests are marked removed, so it can be requested again. Deleting the files removes them from the disk for good — Plex and Jellyfin lose it too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deja de seguirlo en todos los servidores que lo tienen. Sus solicitudes aprobadas quedan como quitadas, así que se puede volver a pedir. Borrar los archivos los elimina del disco para siempre; Plex y Jellyfin también lo pierden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ arrête de le suivre sur tous les serveurs qui l’ont. Ses demandes approuvées sont marquées comme retirées, il peut donc être redemandé. Supprimer les fichiers les efface définitivement du disque — Plex et Jellyfin le perdent aussi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verfolgt ihn auf keinem Server mehr. Genehmigte Anfragen dafür werden als entfernt markiert, er kann also wieder angefragt werden. Das Löschen der Dateien entfernt sie endgültig von der Festplatte – auch Plex und Jellyfin verlieren ihn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ deixa de acompanhá-lo em todos os servidores que o têm. Os pedidos aprovados ficam como removidos, então ele pode ser pedido de novo. Apagar os arquivos os tira do disco de vez — o Plex e o Jellyfin também o perdem."
          }
        }
      }
    },
    "%@ username" : {
      "localizations" : {
