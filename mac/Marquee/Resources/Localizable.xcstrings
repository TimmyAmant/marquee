          }
        }
      }
    },
    "The download didn't match what GitHub says it should be, so Marquee didn't install it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Download stimmte nicht mit den Angaben von GitHub überein, deshalb hat Marquee ihn nicht installiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga no coincidía con lo que indica GitHub, así que Marquee no la instaló."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléchargement ne correspondait pas à ce qu’indique GitHub, donc Marquee ne l’a pas installé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O download não bateu com o que o GitHub informa, então o Marquee não o instalou."
          }
        }
      }
    },
    "The download isn't a Marquee app this Mac can trust (%@), so it wasn't installed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
