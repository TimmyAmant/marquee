    "Adds “Sign in with …” for your own identity provider — Authentik, Authelia, Pocket ID, Keycloak, Google, or anything else that speaks OpenID Connect — on the website and the Mac, iPhone and Windows apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt „Anmelden mit …“ für deinen eigenen Identitätsanbieter hinzu – Authentik, Authelia, Pocket ID, Keycloak, Google oder alles andere, was OpenID Connect spricht – auf der Website und in den Apps für Mac, iPhone und Windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade «Iniciar sesión con…» para tu propio proveedor de identidad (Authentik, Authelia, Pocket ID, Keycloak, Google o cualquier otro que hable OpenID Connect) en la web y en las apps de Mac, iPhone y Windows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute « Se connecter avec … » pour votre propre fournisseur d’identité — Authentik, Authelia, Pocket ID, Keycloak, Google ou tout autre qui parle OpenID Connect — sur le site et dans les applications Mac, iPhone et Windows."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona “Entrar com…” para o seu próprio provedor de identidade — Authentik, Authelia, Pocket ID, Keycloak, Google ou qualquer outro que fale OpenID Connect — no site e nos apps para Mac, iPhone e Windows."
          }
        }
      }
    },
