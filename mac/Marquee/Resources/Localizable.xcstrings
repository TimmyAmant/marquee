    "New here? Use Sign in with %@ (or %@) — your account is made for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu hier? Nutze „Mit %@ anmelden“ (oder %@) – dein Konto wird automatisch erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eres nuevo? Usa Iniciar sesión con %@ (o %@): tu cuenta se crea automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveau ici ? Utilisez Se connecter avec %@ (ou %@) : votre compte est créé pour vous."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É novo por aqui? Use Entrar com %@ (ou %@) — sua conta é criada para você."
          }
        }
      }
    },
    "New here? Use Sign in with %@ — your account is made for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu hier? Nutze „Mit %@ anmelden“ – dein Konto wird automatisch erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
