    "Every title that matches can't be requested — you can still add it yourself. Preview shows what it would catch among the titles Marquee has looked up." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se podrá pedir ningún título que coincida; tú aún puedes añadirlo. La vista previa muestra lo que bloquearía entre los títulos que Marquee ya ha consultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun titre correspondant ne pourra être demandé — vous pouvez toujours l’ajouter vous-même. L’aperçu montre ce qui serait bloqué parmi les titres déjà consultés par Marquee."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passende Titel können nicht angefragt werden – du kannst sie weiterhin selbst hinzufügen. Die Vorschau zeigt, was es unter den Titeln träfe, die Marquee schon kennt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum título que corresponda poderá ser pedido — você ainda pode adicioná-lo. A prévia mostra o que seria bloqueado entre os títulos que o Marquee já consultou."
          }
        }
      }
    },
