    "Let %@ know why \"%@\" isn't being added. They'll see it under Declined on their Requests page and in the notification." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag %1$@, warum „%2$@“ nicht hinzugefügt wird. Die Person sieht es unter „Abgelehnt“ auf ihrer Anfragen-Seite und in der Benachrichtigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntale a %1$@ por qué «%2$@» no se va a añadir. Lo verá en Rechazadas en su página de Solicitudes y en la notificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expliquez à %1$@ pourquoi « %2$@ » ne sera pas ajouté. Cette personne le verra sous Refusées dans sa page Demandes et dans la notification."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga a %1$@ por que “%2$@” não vai ser adicionado. A pessoa vai ver isso em Recusados na página Pedidos e na notificação."
          }
        }
      }
    },
    "Let dashboards like Homepage or Homarr, scripts and other apps use Marquee. A key works like signing in, so keep it secret." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Dashboards wie Homepage oder Homarr, Skripte und andere Apps Marquee nutzen. Ein Schlüssel wirkt wie eine Anmeldung – halte ihn also geheim."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que paneles como Homepage u Homarr, scripts y otras apps usen Marquee. Una clave funciona como iniciar sesión, así que mantenla en secreto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permettez à des tableaux de bord comme Homepage ou Homarr, à des scripts et à d’autres applications d’utiliser Marquee. Une clé équivaut à une connexion : gardez-la secrète."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe painéis como Homepage ou Homarr, scripts e outros apps usarem o Marquee. Uma chave funciona como entrar na conta, então mantenha-a em segredo."
          }
        }
      }
    },
