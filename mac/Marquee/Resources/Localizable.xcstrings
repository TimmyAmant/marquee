        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Aprobadas y estrenadas, pero Sonarr/Radarr sigue sin tener nada %lld hora o más después de aprobarlas. Casi siempre es porque ningún indexador tiene una copia todavía."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Aprobadas y estrenadas, pero Sonarr/Radarr sigue sin tener nada %lld horas o más después de aprobarlas. Casi siempre es porque ningún indexador tiene una copia todavía."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
