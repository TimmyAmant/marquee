    "Approved and released, but Sonarr/Radarr still has nothing %lld hours or more after approval. Most often no indexer has a copy yet." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Genehmigt und erschienen, aber Sonarr/Radarr hat %lld Stunde oder länger nach der Genehmigung noch nichts. Meistens hat noch kein Indexer eine Kopie."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Genehmigt und erschienen, aber Sonarr/Radarr hat %lld Stunden oder länger nach der Genehmigung noch nichts. Meistens hat noch kein Indexer eine Kopie."
                }
              }
