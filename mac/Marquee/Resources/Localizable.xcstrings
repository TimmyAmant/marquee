    },
    "Your Marquee server is running an older version. Update it, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Marquee-Server läuft eine ältere Version. Aktualisiere ihn und versuch es dann noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor de Marquee tiene una versión anterior. Actualízalo e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Marquee exécute une version plus ancienne. Mettez-le à jour, puis réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor do Marquee está com uma versão mais antiga. Atualize e tente de novo."
          }
        }
      }
    },
    "Your Marquee server needs updating before titles can be sent to people here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Marquee-Server muss aktualisiert werden, bevor hier Titel an Leute geschickt werden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor de Marquee necesita actualizarse para poder enviar títulos a personas desde aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Marquee doit être mis à jour avant de pouvoir envoyer des titres à des personnes d’ici."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor do Marquee precisa ser atualizado antes que títulos possam ser enviados a pessoas por aqui."
          }
        }
      }
    },
    "Your Marquee server ran into a problem. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Marquee-Server hatte ein Problem. Versuch es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor de Marquee tuvo un problema. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Marquee a rencontré un problème. Réessayez dans un instant."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor do Marquee teve um problema. Tente de novo daqui a pouco."
          }
        }
      }
    },
    "Your Marquee server runs these maintenance tasks on a schedule. Change how often each one runs or give it a time of day, or run one now — that doesn't change its schedule. What they did, and any errors, shows up in Settings › Logs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Marquee-Server führt diese Wartungsaufgaben nach Zeitplan aus. Du kannst einstellen, wie oft jede läuft oder zu welcher Uhrzeit, oder eine sofort starten – das ändert ihren Zeitplan nicht. Was sie getan haben und etwaige Fehler stehen unter Einstellungen › Protokolle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor de Marquee ejecuta estas tareas de mantenimiento de forma programada. Cambia cada cuánto se ejecuta cada una o fíjale una hora del día, o lanza una ahora; eso no cambia su programación. Lo que hicieron, y cualquier error, aparece en Ajustes › Registros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Marquee exécute ces tâches de maintenance selon un calendrier. Changez la fréquence de chacune ou fixez-lui une heure de la journée, ou lancez-en une maintenant – cela ne modifie pas son calendrier. Ce qu'elles ont fait, et les éventuelles erreurs, apparaît dans Paramètres › Journaux."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor do Marquee executa estas tarefas de manutenção de forma programada. Mude a frequência de cada uma ou defina um horário do dia, ou execute uma agora — isso não muda a programação dela. O que elas fizeram, e qualquer erro, aparece em Configurações › Logs."
          }
        }
      }
    },
    "Your Marquee server sent a Plex sign-in link this app couldn't open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Marquee-Server hat einen Plex-Anmeldelink geschickt, den diese App nicht öffnen konnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor de Marquee envió un enlace de inicio de sesión de Plex que esta app no pudo abrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Marquee a envoyé un lien de connexion Plex que cette application n’a pas pu ouvrir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor do Marquee enviou um link de login do Plex que este app não conseguiu abrir."
          }
        }
      }
    },
    "Your Marquee server sent a response this version of the app couldn't read." : {
      "localizations" : {
