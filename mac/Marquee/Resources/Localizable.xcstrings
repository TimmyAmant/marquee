    "You have %@. Marquee downloads the update, checks it, and quits and reopens to finish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %@. Marquee lädt das Update herunter, prüft es und wird zum Abschluss beendet und neu geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes la %@. Marquee descarga la actualización, la comprueba y se cierra y se vuelve a abrir para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez la %@. Marquee télécharge la mise à jour, la vérifie, puis quitte et se rouvre pour terminer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem a %@. O Marquee baixa a atualização, verifica e fecha e reabre para terminar."
          }
        }
      }
    },
    "You haven't requested anything yet — find a title and hit Request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast noch nichts angefragt – such dir einen Titel aus und klick auf Anfragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no has solicitado nada: busca un título y pulsa Solicitar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez encore rien demandé – trouvez un titre et cliquez sur Demander."
