    "Your server can't reach its database right now, so signing in may fail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server erreicht seine Datenbank gerade nicht, deshalb kann die Anmeldung fehlschlagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor no puede acceder a su base de datos ahora mismo, así que el inicio de sesión podría fallar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur ne peut pas joindre sa base de données pour le moment, la connexion risque donc d’échouer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor não consegue acessar o banco de dados agora, então o login pode falhar."
          }
        }
      }
    },
    "Your server couldn't get anything back from TMDb. Check its internet connection or the TMDb credential in Settings → General, then reload (⌘R)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server hat von TMDb nichts zurückbekommen. Prüf seine Internetverbindung oder die TMDb-Zugangsdaten unter Einstellungen → Allgemein und lade dann neu (⌘R)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor no obtuvo nada de TMDb. Comprueba su conexión a internet o la credencial de TMDb en Ajustes → General y vuelve a cargar (⌘R)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur n’a rien reçu de TMDb. Vérifiez sa connexion Internet ou l’identifiant TMDb dans Paramètres → Général, puis actualisez (⌘R)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor não recebeu nada do TMDb. Verifique a conexão com a internet dele ou a credencial do TMDb em Configurações → Geral e recarregue (⌘R)."
          }
        }
      }
    },
    "Your server couldn't get anything back from TMDb. Check its internet connection or the TMDb credential in Settings → General, then try again." : {
      "comment" : "Marquee for iPhone only.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server hat von TMDb nichts zurückbekommen. Prüf seine Internetverbindung oder die TMDb-Zugangsdaten unter Einstellungen → Allgemein und versuch es dann noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor no obtuvo nada de TMDb. Comprueba su conexión a internet o la credencial de TMDb en Ajustes → General e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur n’a rien reçu de TMDb. Vérifiez sa connexion Internet ou l’identifiant TMDb dans Paramètres → Général, puis réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor não recebeu nada do TMDb. Verifique a conexão com a internet dele ou a credencial do TMDb em Configurações → Geral e tente de novo."
          }
        }
      }
    },
