    "%@ has no quality profiles or root folders yet — add them there, then Test again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat noch keine Qualitätsprofile oder Stammordner – leg sie dort an und klick dann erneut auf „Testen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no tiene perfiles de calidad ni carpetas raíz: añádelos allí y vuelve a pulsar Probar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas encore de profils de qualité ni de dossiers racines — ajoutez-les là-bas, puis cliquez de nouveau sur Tester."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ainda não tem perfis de qualidade nem pastas raiz — adicione-os lá e clique em Testar de novo."
          }
        }
      }
    },
    "%@ is linked. You can sign in with it now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist verknüpft. Du kannst dich jetzt damit anmelden."
