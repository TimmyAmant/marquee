    "Approve, decline and change other people's requests, and handle Can't find and Couldn't add." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfragen anderer genehmigen, ablehnen und ändern und sich um „Nicht gefunden“ und „Hinzufügen fehlgeschlagen“ kümmern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprobar, rechazar y cambiar las solicitudes de otros, y gestionar No se encuentra y No se pudo añadir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuver, refuser et modifier les demandes des autres, et gérer Introuvable et Ajout impossible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprovar, recusar e alterar pedidos de outras pessoas e cuidar de Não encontrado e Não foi possível adicionar."
          }
        }
      }
    },
