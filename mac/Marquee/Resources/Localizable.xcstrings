    "Your Marquee server is newer than this app. Update Marquee for Mac, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Marquee-Server ist neuer als diese App. Aktualisiere Marquee für Mac und versuch es dann noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor de Marquee es más nuevo que esta app. Actualiza Marquee para Mac e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Marquee est plus récent que cette application. Mettez à jour Marquee pour Mac, puis réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor do Marquee é mais novo que este app. Atualize o Marquee para Mac e tente de novo."
          }
        }
      }
    },
    "Your Marquee server is newer than this app. Update Marquee for iPhone, then try again." : {
      "comment" : "Marquee for iPhone only.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
