    "Every poster, search result, and title page comes from TMDb. Add a free API key or read access token in Settings → General." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Poster, jedes Suchergebnis und jede Titelseite kommt von TMDb. Füg in Einstellungen → Allgemein einen kostenlosen API-Schlüssel oder ein Lesezugriffstoken hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada póster, resultado de búsqueda y página de título viene de TMDb. Añade una clave de API gratuita o un token de acceso de lectura en Ajustes → General."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque affiche, résultat de recherche et page de titre vient de TMDb. Ajoutez une clé d’API gratuite ou un jeton d’accès en lecture dans Paramètres → Général."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo pôster, resultado de busca e página de título vem do TMDb. Adicione uma chave de API gratuita ou um token de acesso de leitura em Configurações → Geral."
          }
        }
      }
    },
    "Every request" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
