    "Your server is on %@; %@ is out. Update it by pulling the new Docker image (on Unraid: the Docker tab › Check for Updates, then apply the update)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server läuft mit %@; %@ ist erschienen. Aktualisiere ihn, indem du das neue Docker-Image ziehst (in Unraid: Tab „Docker“ › Check for Updates, dann das Update anwenden)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor está en la %@; ya salió la %@. Actualízalo descargando la nueva imagen de Docker (en Unraid: pestaña Docker › Check for Updates y luego aplica la actualización)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur est en %@ ; la %@ est disponible. Mettez-le à jour en récupérant la nouvelle image Docker (sur Unraid : onglet Docker › Check for Updates, puis appliquez la mise à jour)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor está na %@; a %@ já saiu. Atualize baixando a nova imagem do Docker (no Unraid: aba Docker › Check for Updates e depois aplique a atualização)."
          }
        }
      }
    },
    "Your server is up to date (Marquee %@)." : {
