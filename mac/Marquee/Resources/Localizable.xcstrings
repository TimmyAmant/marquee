    "First sign-in links an account whose username is the person's email — only when the provider says the email is verified, and never the admin account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erste Anmeldung verknüpft ein Konto, dessen Benutzername die E-Mail der Person ist – nur wenn der Anbieter die E-Mail als bestätigt meldet, und nie das Admin-Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer inicio de sesión vincula la cuenta cuyo nombre de usuario sea el correo de esa persona, solo si el proveedor indica que el correo está verificado, y nunca la cuenta del administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première connexion associe le compte dont le nom d’utilisateur est l’e-mail de la personne — seulement si le fournisseur indique que l’e-mail est vérifié, et jamais le compte administrateur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O primeiro login vincula a conta cujo nome de usuário é o e-mail da pessoa — só quando o provedor diz que o e-mail foi verificado, e nunca a conta do administrador."
          }
        }
      }
    },
