    },
    "This server is too old to send them live, so they arrive within a minute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server ist zu alt, um sie live zu senden, deshalb kommen sie innerhalb einer Minute an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor es demasiado antiguo para enviarlas al instante, así que llegan en menos de un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur est trop ancien pour les envoyer en direct, elles arrivent donc en moins d’une minute."
