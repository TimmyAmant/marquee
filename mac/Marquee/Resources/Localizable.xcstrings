    "Found Marquee at %@, but the server needs updating to %@ or later to work with the Mac app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquee unter %1$@ gefunden, aber der Server muss auf %2$@ oder neuer aktualisiert werden, damit er mit der Mac-App funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se encontró Marquee en %1$@, pero hay que actualizar el servidor a la versión %2$@ o posterior para usarlo con la app de Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquee a été trouvé à %1$@, mais le serveur doit être mis à jour en version %2$@ ou ultérieure pour fonctionner avec l’app Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Marquee foi encontrado em %1$@, mas o servidor precisa ser atualizado para a versão %2$@ ou mais recente para funcionar com o app para Mac."
          }
        }
      }
    },
    "Found Marquee at %@, but the server needs updating to %@ or later to work with the iPhone app." : {
      "comment" : "Marquee for iPhone only.",
      "localizations" : {
