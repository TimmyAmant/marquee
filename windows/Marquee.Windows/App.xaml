<?xml version="1.0" encoding="utf-8"?>
<!--
  App-wide resources: the WinUI control styles, the converters every page
  uses, the status badge palette (the library-status colors, the same as
  the website's lib/library/status-tone.ts, the Mac app and Radarr/Sonarr)
  and the navigation's glass and text colors (mac/Docs/DESIGN_TARGET.md,
  "Navigation"), in light, dark and high contrast. No RequestedTheme is
  set, so light/dark follows Windows.
-->
<Application
    x:Class="Marquee.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Marquee.Windows.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              The Marquee* navigation brushes are the website's tokens
              (app/globals.css): the .nav-glass fill and border, text
              primary / secondary / muted, bg0 for text on a solid pill,
              the accent, border and border-strong (the shelf buttons'
              rings), and the avatar's 140° accent gradient. The glass
              is in-app Acrylic tinted to the web's fill, so the page shows
              through it blurred the way backdrop-filter does on the web.

              The *Badge brushes are the library-status colors, named for
              what they mean (lib/library/status-tone.ts) and matching
              Radarr's and Sonarr's legends: Owned green, Downloading
              purple, Missing red, Unmonitored orange, Soon blue, Neutral
              grey. Info is Soon's blue for pills that aren't a status.
              Each has a foreground (text, dot, poster strip), a tinted
              background, and a border at 30% of the foreground (the
              Mac's BadgeTone palette; Neutral's border is the plain
              border color).

              The poster card's own: the solid MOVIE (blue) and SERIES
              (magenta) type pills with white text, the rating chip's bg0
              at 80%, the hover panel's overview text (text secondary) and
              its bg0 scrim, fading from 97% at the foot to 18% at the top.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OwnedBadgeForegroundBrush" Color="#2F7A52" />
                    <SolidColorBrush x:Key="OwnedBadgeBackgroundBrush" Color="#E3F3EA" />
                    <SolidColorBrush x:Key="DownloadingBadgeForegroundBrush" Color="#7048B8" />
                    <SolidColorBrush x:Key="DownloadingBadgeBackgroundBrush" Color="#F0E9FB" />
                    <SolidColorBrush x:Key="MissingBadgeForegroundBrush" Color="#C42B2B" />
                    <SolidColorBrush x:Key="MissingBadgeBackgroundBrush" Color="#FDEAEA" />
                    <SolidColorBrush x:Key="UnmonitoredBadgeForegroundBrush" Color="#B34D00" />
                    <SolidColorBrush x:Key="UnmonitoredBadgeBackgroundBrush" Color="#FFF0E5" />
                    <SolidColorBrush x:Key="SoonBadgeForegroundBrush" Color="#2F6FB0" />
                    <SolidColorBrush x:Key="SoonBadgeBackgroundBrush" Color="#E5F0FA" />
                    <SolidColorBrush x:Key="InfoBadgeForegroundBrush" Color="#2F6FB0" />
                    <SolidColorBrush x:Key="InfoBadgeBackgroundBrush" Color="#E5F0FA" />
                    <SolidColorBrush x:Key="NeutralBadgeForegroundBrush" Color="#5C574C" />
                    <SolidColorBrush x:Key="NeutralBadgeBackgroundBrush" Color="#EFECE3" />
                    <SolidColorBrush x:Key="OwnedBadgeBorderBrush" Color="#4D2F7A52" />
                    <SolidColorBrush x:Key="DownloadingBadgeBorderBrush" Color="#4D7048B8" />
                    <SolidColorBrush x:Key="MissingBadgeBorderBrush" Color="#4DC42B2B" />
                    <SolidColorBrush x:Key="UnmonitoredBadgeBorderBrush" Color="#4DB34D00" />
                    <SolidColorBrush x:Key="SoonBadgeBorderBrush" Color="#4D2F6FB0" />
                    <SolidColorBrush x:Key="InfoBadgeBorderBrush" Color="#4D2F6FB0" />
                    <SolidColorBrush x:Key="NeutralBadgeBorderBrush" Color="#E1DCCD" />

                    <SolidColorBrush x:Key="MovieTypeBadgeBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="SeriesTypeBadgeBrush" Color="#C026D3" />
                    <SolidColorBrush x:Key="TypeBadgeForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RatingChipBackgroundBrush" Color="#CCFAF8F4" />
                    <SolidColorBrush x:Key="PosterOverviewForegroundBrush" Color="#5C574C" />
                    <LinearGradientBrush x:Key="PosterHoverScrimBrush" StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop Color="#F7FAF8F4" Offset="0" />
                        <GradientStop Color="#EBFAF8F4" Offset="0.3333" />
                        <GradientStop Color="#8CFAF8F4" Offset="0.6667" />
                        <GradientStop Color="#2EFAF8F4" Offset="1" />
                    </LinearGradientBrush>

                    <AcrylicBrush
                        x:Key="MarqueeGlassBrush"
                        TintColor="#FFFFFF"
                        TintOpacity="0.74"
                        TintLuminosityOpacity="0.74"
                        FallbackColor="#F5FFFFFF" />
                    <SolidColorBrush x:Key="MarqueeGlassBorderBrush" Color="#1A211F1A" />
                    <SolidColorBrush x:Key="MarqueeNavTextBrush" Color="#211F1A" />
                    <SolidColorBrush x:Key="MarqueeNavTextSecondaryBrush" Color="#5C574C" />
                    <SolidColorBrush x:Key="MarqueeNavTextMutedBrush" Color="#8B8575" />
                    <SolidColorBrush x:Key="MarqueeNavHoverBrush" Color="#1A211F1A" />
                    <SolidColorBrush x:Key="MarqueeNavPressedBrush" Color="#29211F1A" />
                    <SolidColorBrush x:Key="MarqueeNavCurrentBrush" Color="#211F1A" />
                    <SolidColorBrush x:Key="MarqueeNavCurrentTextBrush" Color="#FAF8F4" />
                    <SolidColorBrush x:Key="MarqueeAccentBrush" Color="#B3791F" />
                    <SolidColorBrush x:Key="MarqueeBorderBrush" Color="#E1DCCD" />
                    <SolidColorBrush x:Key="MarqueeBorderStrongBrush" Color="#CCC4B0" />
                    <SolidColorBrush x:Key="MarqueeOnAccentBrush" Color="#FAF8F4" />
                    <SolidColorBrush x:Key="MarqueeAvatarRingBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="MarqueeDotRingBrush" Color="#FFFFFF" />
                    <LinearGradientBrush x:Key="MarqueeAvatarBrush" StartPoint="0.05,-0.04" EndPoint="0.95,1.04">
                        <GradientStop Color="#9C6818" Offset="0" />
                        <GradientStop Color="#B3791F" Offset="0.45" />
                        <GradientStop Color="#C2583A" Offset="1" />
                    </LinearGradientBrush>
                    <!--
                      The fades over a title's, person's or studio's artwork
                      (components/title-backdrop.tsx): named brushes, because a
                      ThemeResource on a GradientStop's Color doesn't resolve and left the
                      wash and the bottom fade transparent.
                    -->
                    <SolidColorBrush x:Key="HeroVeilBrush" Color="#1AF3F3F3" />
                    <LinearGradientBrush x:Key="HeroSideFadeBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#D1F3F3F3" Offset="0" />
                        <GradientStop Color="#A8F3F3F3" Offset="0.3" />
                        <GradientStop Color="#66F3F3F3" Offset="0.52" />
                        <GradientStop Color="#1FF3F3F3" Offset="0.74" />
                        <GradientStop Color="#00F3F3F3" Offset="0.92" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="HeroTopFadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B3F3F3F3" Offset="0" />
                        <GradientStop Color="#40F3F3F3" Offset="0.14" />
                        <GradientStop Color="#00F3F3F3" Offset="0.28" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="HeroBottomFadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00F3F3F3" Offset="0.24" />
                        <GradientStop Color="#80F3F3F3" Offset="0.54" />
                        <GradientStop Color="#E0F3F3F3" Offset="0.78" />
                        <GradientStop Color="#FFF3F3F3" Offset="0.94" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="OwnedBadgeForegroundBrush" Color="#4CAF7D" />
                    <SolidColorBrush x:Key="OwnedBadgeBackgroundBrush" Color="#14251C" />
                    <SolidColorBrush x:Key="DownloadingBadgeForegroundBrush" Color="#A98BE8" />
                    <SolidColorBrush x:Key="DownloadingBadgeBackgroundBrush" Color="#1F1830" />
                    <SolidColorBrush x:Key="MissingBadgeForegroundBrush" Color="#F25B5B" />
                    <SolidColorBrush x:Key="MissingBadgeBackgroundBrush" Color="#2C1315" />
                    <SolidColorBrush x:Key="UnmonitoredBadgeForegroundBrush" Color="#E8833A" />
                    <SolidColorBrush x:Key="UnmonitoredBadgeBackgroundBrush" Color="#2A1A0E" />
                    <SolidColorBrush x:Key="SoonBadgeForegroundBrush" Color="#5D9CEC" />
                    <SolidColorBrush x:Key="SoonBadgeBackgroundBrush" Color="#10202F" />
                    <SolidColorBrush x:Key="InfoBadgeForegroundBrush" Color="#5D9CEC" />
                    <SolidColorBrush x:Key="InfoBadgeBackgroundBrush" Color="#10202F" />
                    <SolidColorBrush x:Key="NeutralBadgeForegroundBrush" Color="#A8A4B3" />
                    <SolidColorBrush x:Key="NeutralBadgeBackgroundBrush" Color="#201F26" />
                    <SolidColorBrush x:Key="OwnedBadgeBorderBrush" Color="#4D4CAF7D" />
                    <SolidColorBrush x:Key="DownloadingBadgeBorderBrush" Color="#4DA98BE8" />
                    <SolidColorBrush x:Key="MissingBadgeBorderBrush" Color="#4DF25B5B" />
                    <SolidColorBrush x:Key="UnmonitoredBadgeBorderBrush" Color="#4DE8833A" />
                    <SolidColorBrush x:Key="SoonBadgeBorderBrush" Color="#4D5D9CEC" />
                    <SolidColorBrush x:Key="InfoBadgeBorderBrush" Color="#4D5D9CEC" />
                    <SolidColorBrush x:Key="NeutralBadgeBorderBrush" Color="#2C2A35" />

                    <SolidColorBrush x:Key="MovieTypeBadgeBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="SeriesTypeBadgeBrush" Color="#C026D3" />
                    <SolidColorBrush x:Key="TypeBadgeForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RatingChipBackgroundBrush" Color="#CC0A0A0C" />
                    <SolidColorBrush x:Key="PosterOverviewForegroundBrush" Color="#A8A4B3" />
                    <LinearGradientBrush x:Key="PosterHoverScrimBrush" StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop Color="#F70A0A0C" Offset="0" />
                        <GradientStop Color="#EB0A0A0C" Offset="0.3333" />
                        <GradientStop Color="#8C0A0A0C" Offset="0.6667" />
                        <GradientStop Color="#2E0A0A0C" Offset="1" />
                    </LinearGradientBrush>

                    <AcrylicBrush
                        x:Key="MarqueeGlassBrush"
                        TintColor="#1E1D25"
                        TintOpacity="0.68"
                        TintLuminosityOpacity="0.68"
                        FallbackColor="#F51E1D25" />
                    <SolidColorBrush x:Key="MarqueeGlassBorderBrush" Color="#17FFFFFF" />
                    <SolidColorBrush x:Key="MarqueeNavTextBrush" Color="#F3F1EA" />
                    <SolidColorBrush x:Key="MarqueeNavTextSecondaryBrush" Color="#A8A4B3" />
                    <SolidColorBrush x:Key="MarqueeNavTextMutedBrush" Color="#6F6C7D" />
                    <SolidColorBrush x:Key="MarqueeNavHoverBrush" Color="#1AF3F1EA" />
                    <SolidColorBrush x:Key="MarqueeNavPressedBrush" Color="#29F3F1EA" />
                    <SolidColorBrush x:Key="MarqueeNavCurrentBrush" Color="#F3F1EA" />
                    <SolidColorBrush x:Key="MarqueeNavCurrentTextBrush" Color="#0A0A0C" />
                    <SolidColorBrush x:Key="MarqueeAccentBrush" Color="#E0A63E" />
                    <SolidColorBrush x:Key="MarqueeBorderBrush" Color="#2C2A35" />
                    <SolidColorBrush x:Key="MarqueeBorderStrongBrush" Color="#3A3745" />
                    <SolidColorBrush x:Key="MarqueeOnAccentBrush" Color="#0A0A0C" />
                    <SolidColorBrush x:Key="MarqueeAvatarRingBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="MarqueeDotRingBrush" Color="#131217" />
                    <LinearGradientBrush x:Key="MarqueeAvatarBrush" StartPoint="0.05,-0.04" EndPoint="0.95,1.04">
                        <GradientStop Color="#F0B954" Offset="0" />
                        <GradientStop Color="#E0A63E" Offset="0.45" />
                        <GradientStop Color="#C2583A" Offset="1" />
                    </LinearGradientBrush>
                    <!--
                      The fades over a title's, person's or studio's artwork
                      (components/title-backdrop.tsx): named brushes, because a
                      ThemeResource on a GradientStop's Color doesn't resolve and left the
                      wash and the bottom fade transparent.
                    -->
                    <SolidColorBrush x:Key="HeroVeilBrush" Color="#1A202020" />
                    <LinearGradientBrush x:Key="HeroSideFadeBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#D1202020" Offset="0" />
                        <GradientStop Color="#A8202020" Offset="0.3" />
                        <GradientStop Color="#66202020" Offset="0.52" />
                        <GradientStop Color="#1F202020" Offset="0.74" />
                        <GradientStop Color="#00202020" Offset="0.92" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="HeroTopFadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B3202020" Offset="0" />
                        <GradientStop Color="#40202020" Offset="0.14" />
                        <GradientStop Color="#00202020" Offset="0.28" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="HeroBottomFadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00202020" Offset="0.24" />
                        <GradientStop Color="#80202020" Offset="0.54" />
                        <GradientStop Color="#E0202020" Offset="0.78" />
                        <GradientStop Color="#FF202020" Offset="0.94" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="OwnedBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OwnedBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DownloadingBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DownloadingBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="MissingBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MissingBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="UnmonitoredBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="UnmonitoredBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SoonBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SoonBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InfoBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InfoBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NeutralBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NeutralBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OwnedBadgeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DownloadingBadgeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MissingBadgeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="UnmonitoredBadgeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SoonBadgeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InfoBadgeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NeutralBadgeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush x:Key="MovieTypeBadgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SeriesTypeBadgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TypeBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="RatingChipBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PosterOverviewForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PosterHoverScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />

                    <!-- No translucency in high contrast: solid system colors, the current item in the highlight pair. -->
                    <SolidColorBrush x:Key="MarqueeGlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="MarqueeGlassBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MarqueeNavTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MarqueeNavTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MarqueeNavTextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MarqueeNavHoverBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="MarqueeNavPressedBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="MarqueeNavCurrentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="MarqueeNavCurrentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="MarqueeAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="MarqueeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MarqueeBorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MarqueeOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="MarqueeAvatarRingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MarqueeDotRingBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="MarqueeAvatarBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="HeroVeilBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HeroSideFadeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HeroTopFadeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HeroBottomFadeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The wordmark's serif (the website's font-display, New York on the Mac). -->
            <FontFamily x:Key="MarqueeSerifFontFamily">Georgia</FontFamily>

            <!-- Settings' cards and field captions, shared by every tab (Views/Settings). -->
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <!--
              components/shelf.tsx's round shelf buttons (the Mac's Shelf):
              a 1px ring around a chevron, ring and glyph turning accent on
              hover. MarqueeRailArrowStyle is the 28px ‹ › pair at the right
              end of a rail's header (Controls/RailArrows), faded when there
              is nothing more that way; MarqueeSeeAllButtonStyle is the 20px
              "Browse all" chevron right after a Discover shelf's title.
            -->
            <Style x:Key="MarqueeRailArrowStyle" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource MarqueeBorderBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource MarqueeNavTextSecondaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.BorderBrush" Value="{ThemeResource MarqueeAccentBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource MarqueeAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.BorderBrush" Value="{ThemeResource MarqueeAccentBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource MarqueeAccentBrush}" />
                                                <Setter Target="RootGrid.Opacity" Value="0.8" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity" Value="0.6" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource MarqueeNavTextMutedBrush}" />
                                                <Setter Target="ContentPresenter.Opacity" Value="0.6" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="Ring"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MarqueeSeeAllButtonStyle" TargetType="Button" BasedOn="{StaticResource MarqueeRailArrowStyle}">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderBrush" Value="{ThemeResource MarqueeBorderStrongBrush}" />
            </Style>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
