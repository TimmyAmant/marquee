<?xml version="1.0" encoding="utf-8"?>
<!--
  App-wide resources: the WinUI control styles, the converters every page
  uses, and the status badge palette (the Mac app's Theme.owned/tracked
  colors) in light, dark and high contrast. No RequestedTheme is set, so
  light/dark follows Windows.
-->
<Application
    x:Class="Marquee.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Marquee.Windows.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OwnedBadgeForegroundBrush" Color="#2F7A52" />
                    <SolidColorBrush x:Key="OwnedBadgeBackgroundBrush" Color="#E3F3EA" />
                    <SolidColorBrush x:Key="TrackedBadgeForegroundBrush" Color="#2F6FB0" />
                    <SolidColorBrush x:Key="TrackedBadgeBackgroundBrush" Color="#E5F0FA" />
                    <SolidColorBrush x:Key="NeutralBadgeForegroundBrush" Color="#5C574C" />
                    <SolidColorBrush x:Key="NeutralBadgeBackgroundBrush" Color="#EFECE3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="OwnedBadgeForegroundBrush" Color="#4CAF7D" />
                    <SolidColorBrush x:Key="OwnedBadgeBackgroundBrush" Color="#14251C" />
                    <SolidColorBrush x:Key="TrackedBadgeForegroundBrush" Color="#4F8FD1" />
                    <SolidColorBrush x:Key="TrackedBadgeBackgroundBrush" Color="#10202F" />
                    <SolidColorBrush x:Key="NeutralBadgeForegroundBrush" Color="#A8A4B3" />
                    <SolidColorBrush x:Key="NeutralBadgeBackgroundBrush" Color="#201F26" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="OwnedBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OwnedBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TrackedBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TrackedBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NeutralBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NeutralBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
