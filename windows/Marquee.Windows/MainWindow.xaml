<?xml version="1.0" encoding="utf-8"?>
<!--
  app/layout.tsx plus components/nav-menu.tsx and components/site-header.tsx
  (the spec is mac/Docs/DESIGN_TARGET.md, "Navigation"). Row 0 is the top
  bar: back and the wordmark over the drag region (search and the bell
  are on the rail). Row 1 holds either the shell (the content frame, 72 in from the
  left, with the frosted rail floating over its left edge) or the auth
  frame with ConnectPage (everything before sign-in). Both stay in the
  tree and swap visibility, which keeps the sign-in form's state across a
  failed attempt and lets the shell come back instantly. The rail is the
  whole menu: nothing opens over the page.

  Text, badges and the current-item styling are set from code-behind
  rather than bound: Window is not a FrameworkElement, so keeping its XAML
  to plain named elements avoids leaning on x:Bind support at the window
  level.
-->
<Window
    x:Class="Marquee.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.Resources>
            <!--
              Every pill in the navigation: a state fill (textPrimary 10% on
              hover, 16% pressed) under the content. The current item's solid
              fill is the Background, so the state fill vanishes into it.
            -->
            <ControlTemplate x:Key="NavPillTemplate" TargetType="Button">
                <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="StateFill.Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="StateFill.Opacity" Value="1" />
                                    <Setter Target="StateFill.Background" Value="{ThemeResource MarqueeNavPressedBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border
                        x:Name="StateFill"
                        Background="{ThemeResource MarqueeNavHoverBrush}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0" />
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </ControlTemplate>

            <!-- The rail's round buttons: the same, plus the icon brightening from textSecondary to textPrimary on hover. -->
            <ControlTemplate x:Key="NavRailTemplate" TargetType="Button">
                <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="StateFill.Opacity" Value="1" />
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource MarqueeNavTextBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="StateFill.Opacity" Value="1" />
                                    <Setter Target="StateFill.Background" Value="{ThemeResource MarqueeNavPressedBrush}" />
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource MarqueeNavTextBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.35" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border
                        x:Name="StateFill"
                        Background="{ThemeResource MarqueeNavHoverBrush}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0" />
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </ControlTemplate>

            <!-- Rail items (and the top bar's back and bell): 40 round, textSecondary icon. -->
            <Style x:Key="NavRailButtonStyle" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource NavRailTemplate}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource MarqueeNavTextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <!-- The rail's current item: a solid textPrimary pill with a bg0 icon. -->
            <Style x:Key="NavRailButtonCurrentStyle" TargetType="Button" BasedOn="{StaticResource NavRailButtonStyle}">
                <Setter Property="Template" Value="{StaticResource NavPillTemplate}" />
                <Setter Property="Background" Value="{ThemeResource MarqueeNavCurrentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource MarqueeNavCurrentTextBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnReloadInvoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindInvoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          components/site-header.tsx, minus search and the bell, which live on
          the rail. Only AppTitleBar is the drag region (Window.SetTitleBar
          makes its whole rectangle non-client), so the back button sits in
          its own column beside it. The last column keeps clear of the
          caption buttons, which the system draws over the right end.
        -->
        <Grid x:Name="TopBar" Grid.Row="0" Height="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="48" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <!-- Centered over the rail below it (16 in, 56 wide). -->
            <Button
                x:Name="BackButton"
                Grid.Column="0"
                Style="{StaticResource NavRailButtonStyle}"
                Width="40"
                Height="36"
                CornerRadius="18"
                Margin="24,0,8,0"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                IsEnabled="False"
                Click="OnBackClick"
                AutomationProperties.Name="Back"
                ToolTipService.ToolTip="Back (Alt+Left)">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <Grid x:Name="AppTitleBar" Grid.Column="1" Background="Transparent">
                <StackPanel
                    Orientation="Horizontal"
                    Margin="22,0,0,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <TextBlock
                        Text="Marquee"
                        FontFamily="{StaticResource MarqueeSerifFontFamily}"
                        FontSize="22"
                        FontWeight="SemiBold"
                        CharacterSpacing="-10"
                        Foreground="{ThemeResource MarqueeNavTextBrush}"
                        VerticalAlignment="Center" />
                    <Ellipse
                        Width="6"
                        Height="6"
                        Margin="4,2,0,0"
                        VerticalAlignment="Top"
                        Fill="{ThemeResource MarqueeAccentBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--
          The signed-in shell: the pages, and the rail floating beside them.
          The rail sits at the left edge unless this PC picked another
          (Settings › Account › Menu position): ApplyMenuPosition() in code
          moves it, lays its items out in a row for Top and Bottom, and moves
          the frame's 72 clearance to that edge.
        -->
        <Grid x:Name="ShellContent" Grid.Row="1" Visibility="Collapsed">
            <!-- 72 clears the rail (16 from the edge, 56 wide). -->
            <Frame x:Name="ContentFrame" Margin="72,0,0,0" Navigated="OnContentNavigated" />

            <!--
              The rail is the menu: every destination, one click away, in
              the menu's order (profile and notifications; Search, Discover;
              Movies, Series; Favorites, Calendar, Requests), groups split by a short
              hairline, and (only while a newer Marquee is out) the update
              button, which opens Settings where "Update" is.
              Hovering or focusing an icon shows its name to the right.
              Each section button's Tag is its Section.Tag(); the code-behind
              makes the current one a solid pill.
            -->
            <Border
                x:Name="Rail"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="16,0,0,0"
                Padding="7"
                CornerRadius="28"
                BorderThickness="1"
                BorderBrush="{ThemeResource MarqueeGlassBorderBrush}"
                Background="{ThemeResource MarqueeGlassBrush}">
                <StackPanel x:Name="RailItems" Spacing="4" XYFocusKeyboardNavigation="Enabled">
                    <Button
                        x:Name="RailProfileButton"
                        Style="{StaticResource NavRailButtonStyle}"
                        Margin="0,0,0,4"
                        Click="OnProfileClick"
                        AutomationProperties.Name="Account and settings"
                        ToolTipService.ToolTip="Settings"
                        ToolTipService.Placement="Right">
                        <!-- The 36 round photo (or initials on the accent gradient), inside a 2px white 15% ring. -->
                        <controls:AvatarView x:Name="RailAvatar" Diameter="40" RingThickness="2" />
                    </Button>

                    <!-- components/notifications-bell.tsx: the bell opens its list beside the rail. -->
                    <Grid>
                        <Button
                            x:Name="NotificationsButton"
                            Style="{StaticResource NavRailButtonStyle}"
                            AutomationProperties.Name="Notifications"
                            ToolTipService.ToolTip="Notifications"
                            ToolTipService.Placement="Right">
                            <FontIcon Glyph="&#xEA8F;" FontSize="19" />
                            <Button.Flyout>
                                <Flyout
                                    x:Name="NotificationsFlyoutHost"
                                    Placement="RightEdgeAlignedTop"
                                    Opened="OnNotificationsOpened"
                                    Closed="OnNotificationsClosed">
                                    <controls:NotificationsFlyout x:Name="NotificationsPanel" CloseRequested="OnNotificationsCloseRequested" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <InfoBadge
                            x:Name="NotificationsBadge"
                            Margin="0,-2,-4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>

                    <Rectangle Width="24" Height="1" Margin="0,4,0,4" HorizontalAlignment="Center" Fill="{ThemeResource MarqueeGlassBorderBrush}" />

                    <Button
                        x:Name="RailSearchButton"
                        Style="{StaticResource NavRailButtonStyle}"
                        Tag="search"
                        Click="OnSearchNavClick"
                        AutomationProperties.Name="Search"
                        ToolTipService.ToolTip="Search"
                        ToolTipService.Placement="Right">
                        <FontIcon Glyph="&#xE721;" FontSize="19" />
                    </Button>
                    <Button
                        x:Name="RailDiscoverButton"
                        Style="{StaticResource NavRailButtonStyle}"
                        Tag="discover"
                        Click="OnSectionNavClick"
                        AutomationProperties.Name="Discover"
                        ToolTipService.ToolTip="Discover"
                        ToolTipService.Placement="Right">
                        <FontIcon Glyph="&#xE909;" FontSize="19" />
                    </Button>

                    <Rectangle Width="24" Height="1" Margin="0,4,0,4" HorizontalAlignment="Center" Fill="{ThemeResource MarqueeGlassBorderBrush}" />

                    <Button
                        x:Name="RailMoviesButton"
                        Style="{StaticResource NavRailButtonStyle}"
                        Tag="movies"
                        Click="OnSectionNavClick"
                        AutomationProperties.Name="Movies"
                        ToolTipService.ToolTip="Movies"
                        ToolTipService.Placement="Right">
                        <FontIcon Glyph="&#xE714;" FontSize="19" />
                    </Button>
                    <Button
                        x:Name="RailSeriesButton"
                        Style="{StaticResource NavRailButtonStyle}"
                        Tag="series"
                        Click="OnSectionNavClick"
                        AutomationProperties.Name="Series"
                        ToolTipService.ToolTip="Series"
                        ToolTipService.Placement="Right">
                        <FontIcon Glyph="&#xE7F4;" FontSize="19" />
                    </Button>

                    <Rectangle Width="24" Height="1" Margin="0,4,0,4" HorizontalAlignment="Center" Fill="{ThemeResource MarqueeGlassBorderBrush}" />

                    <Button
                        x:Name="RailFavoritesButton"
                        Style="{StaticResource NavRailButtonStyle}"
                        Tag="favorites"
                        Click="OnSectionNavClick"
                        AutomationProperties.Name="Favorites"
                        ToolTipService.ToolTip="Favorites"
                        ToolTipService.Placement="Right">
                        <FontIcon Glyph="&#xEB51;" FontSize="19" />
                    </Button>
                    <Button
                        x:Name="RailCalendarButton"
                        Style="{StaticResource NavRailButtonStyle}"
                        Tag="calendar"
                        Click="OnSectionNavClick"
                        AutomationProperties.Name="Calendar"
                        ToolTipService.ToolTip="Calendar"
                        ToolTipService.Placement="Right">
                        <FontIcon Glyph="&#xE787;" FontSize="19" />
                    </Button>
                    <Button
                        x:Name="RailRequestsButton"
                        Style="{StaticResource NavRailButtonStyle}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Tag="requests"
                        Click="OnSectionNavClick"
                        AutomationProperties.Name="Requests"
                        ToolTipService.ToolTip="Requests"
                        ToolTipService.Placement="Right">
                        <Grid>
                            <FontIcon Glyph="&#xE8FD;" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- An admin's pending requests: an 8px accent dot with a 2px bg1 ring. -->
                            <Ellipse
                                x:Name="RailRequestsDot"
                                Width="12"
                                Height="12"
                                Margin="0,4,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Fill="{ThemeResource MarqueeAccentBrush}"
                                Stroke="{ThemeResource MarqueeDotRingBrush}"
                                StrokeThickness="2"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <!-- A newer Marquee: shown by UpdateUpdateButton() in code. -->
                    <StackPanel x:Name="RailUpdateGroup" Spacing="4" Visibility="Collapsed">
                        <Rectangle Width="24" Height="1" Margin="0,4,0,4" HorizontalAlignment="Center" Fill="{ThemeResource MarqueeGlassBorderBrush}" />
                        <Button
                            x:Name="RailUpdateButton"
                            Style="{StaticResource NavRailButtonStyle}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Click="OnRailUpdateClick"
                            AutomationProperties.Name="Update Marquee"
                            ToolTipService.ToolTip="Update Marquee"
                            ToolTipService.Placement="Right">
                            <Grid>
                                <FontIcon Glyph="&#xE896;" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    Margin="0,4,4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Fill="{ThemeResource MarqueeAccentBrush}"
                                    Stroke="{ThemeResource MarqueeDotRingBrush}"
                                    StrokeThickness="2" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Frame x:Name="AuthFrame" Grid.Row="1" />

        <!--
          A newer Marquee, offered before sign-in too: Settings (where the
          update normally lives) isn't reachable until then, and an update may
          be exactly what fixes signing in. Filled in by UpdateUpdateButton().
        -->
        <InfoBar
            x:Name="AuthUpdateBar"
            Grid.Row="1"
            MaxWidth="560"
            Margin="16,0,16,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Severity="Informational"
            IsOpen="False"
            CloseButtonClick="OnAuthUpdateBarClosed">
            <InfoBar.ActionButton>
                <Button x:Name="AuthUpdateButton" Content="Update" Click="OnAuthUpdateClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--
          components/search-bar.tsx as a floating panel over the page, opened
          by the rail's Search and Ctrl+F: type-ahead from GET
          /search/suggest, Enter opens the results page, Escape or a click
          outside closes it. Suggestions display through
          SuggestionItem.ToString() rather than a template, keeping this
          file free of bindings (see the note at the top).
        -->
        <Grid x:Name="SearchLayer" Grid.Row="1" Visibility="Collapsed" KeyDown="OnSearchLayerKeyDown">
            <Border Background="#47000000" PointerPressed="OnSearchDismissPressed" />
            <Border
                Width="560"
                Margin="0,40,0,0"
                Padding="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="18"
                BorderThickness="1"
                BorderBrush="{ThemeResource MarqueeGlassBorderBrush}"
                Background="{ThemeResource MarqueeGlassBrush}">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    FontSize="17"
                    PlaceholderText="Search an actor, a studio, a title…"
                    QueryIcon="Find"
                    AutomationProperties.Name="Search"
                    TextChanged="OnSearchTextChanged"
                    QuerySubmitted="OnSearchQuerySubmitted" />
            </Border>
        </Grid>
    </Grid>
</Window>
