<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WinUI 3 client. Everything that talks to the server lives in
    Marquee.Core; this project is the shell, the pages and the two Windows
    specific stores (credential vault, settings file).

    Unpackaged on purpose: a plain `dotnet build` produces something that
    runs, and the Windows App SDK runtime ships inside the output
    (WindowsAppSDKSelfContained), so neither a developer nor CI needs the
    framework package installed. Build with an explicit platform, e.g.
    `dotnet build -c Release -p:Platform=x64`; WinUI has no AnyCPU.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Marquee.Windows</RootNamespace>
    <AssemblyName>Marquee.Windows</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Description>Marquee for Windows: the household media dashboard as a native app.</Description>

    <!--
      The view models keep [ObservableProperty] on fields so they compile
      under C# 12 (the .NET 8 SDK) as well as newer SDKs. On a newer SDK the
      MVVM Toolkit flags that pattern as not Native AOT compatible for WinRT
      (MVVMTK0045); the app is never published with Native AOT, and warnings
      are errors here, so that one diagnostic is silenced. NETSDK1206 is the
      SDK noticing a dependency that still ships "win10-x64" assets, which is
      the package's business, not this project's.
    -->
    <NoWarn>$(NoWarn);MVVMTK0045;NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marquee.Core\Marquee.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

</Project>
