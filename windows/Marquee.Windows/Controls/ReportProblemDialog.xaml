<?xml version="1.0" encoding="utf-8"?>
<!--
  components/report-problem-button.tsx's dialog: what's wrong (the six
  kinds), for TV which season and episode, and a note. Send report sends the
  report itself and keeps the dialog open with the message on a failure,
  like the season picker.
-->
<ContentDialog
    x:Class="Marquee.Windows.Controls.ReportProblemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="Report_Dialog"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Closing="OnClosing">

    <StackPanel Spacing="14" MinWidth="380">
        <TextBlock
            x:Uid="Report_Intro"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        <RadioButtons
            x:Name="KindButtons"
            x:Uid="Report_Kind"
            SelectionChanged="OnKindChanged" />
        <Grid x:Name="EpisodeRow" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="SeasonBox"
                Grid.Column="0"
                x:Uid="Report_Season"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnSeasonChanged" />
            <TextBox
                x:Name="EpisodeBox"
                Grid.Column="1"
                x:Uid="Report_Episode"
                InputScope="Number"
                MaxLength="4"
                IsEnabled="False" />
        </Grid>
        <TextBox
            x:Name="NoteBox"
            x:Uid="Report_Note"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="72"
            MaxLength="1000" />
        <TextBlock
            x:Name="ErrorText"
            Visibility="Collapsed"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
