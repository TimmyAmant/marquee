<?xml version="1.0" encoding="utf-8"?>
<!--
  components/relink-title-form.tsx: "Wrong match? Fix ID". Fill in whichever
  id you have; the server checks tmdbId, then imdbId, then tvdbId (TV only).
-->
<ContentDialog
    x:Class="Marquee.Windows.Controls.RelinkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="Relink_Dialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="12" MinWidth="380">
        <TextBlock
            x:Uid="Relink_Intro"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        <TextBox x:Name="TmdbBox" x:Uid="Relink_TmdbBox" IsSpellCheckEnabled="False" TextChanged="OnTextChanged" />
        <TextBox x:Name="ImdbBox" x:Uid="Relink_ImdbBox" IsSpellCheckEnabled="False" TextChanged="OnTextChanged" />
        <TextBox x:Name="TvdbBox" x:Uid="Relink_TvdbBox" IsSpellCheckEnabled="False" Visibility="Collapsed" TextChanged="OnTextChanged" />
    </StackPanel>
</ContentDialog>
