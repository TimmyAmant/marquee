<?xml version="1.0" encoding="utf-8"?>
<!--
  components/notifications-bell.tsx's dropdown, hosted in the Flyout on the
  shell's bell. Each row is a Button so keyboard users can walk the list;
  clicking one opens its title and marks it read.
-->
<UserControl
    x:Class="Marquee.Windows.Controls.NotificationsFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    mc:Ignorable="d"
    Width="380">

    <StackPanel>
        <Grid Margin="4,0,4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Notifications"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                VerticalAlignment="Center" />
            <HyperlinkButton
                Grid.Column="1"
                Content="Mark all read"
                Command="{x:Bind ViewModel.MarkAllReadCommand}"
                Visibility="{x:Bind ViewModel.HasUnread, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Padding="8,4" />
        </Grid>

        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Width="28"
            Height="28"
            Margin="0,20" />

        <TextBlock
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Margin="4,8" />

        <TextBlock
            Text="No notifications yet."
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            HorizontalAlignment="Center"
            Margin="0,24" />

        <ScrollViewer
            MaxHeight="480"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="2" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationRow">
                        <Button
                            Command="{x:Bind Open}"
                            CommandParameter="{x:Bind}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            AutomationProperties.Name="{x:Bind AccessibleName}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Grid.Column="0"
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Top"
                                    Margin="0,7,0,0"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Emoji}"
                                    VerticalAlignment="Top" />
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Message}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind TimeAgo}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </StackPanel>
</UserControl>
