<?xml version="1.0" encoding="utf-8"?>
<!--
  components/decline-reason-chooser.tsx's ReasonChoices: the server's preset
  reasons plus "Other" with a free-text field. The Decline dialog requires a
  reason; the Remove from Radarr/Sonarr dialog lists "No reason" first.
-->
<UserControl
    x:Class="Marquee.Windows.Controls.ReasonChooser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="14">
        <RadioButtons
            x:Name="ReasonButtons"
            x:Uid="Decline_ReasonButtons"
            SelectionChanged="OnReasonChanged" />
        <TextBox
            x:Name="CustomReasonBox"
            x:Uid="Decline_CustomReasonBox"
            Visibility="Collapsed"
            TextChanged="OnCustomReasonChanged" />
    </StackPanel>
</UserControl>
