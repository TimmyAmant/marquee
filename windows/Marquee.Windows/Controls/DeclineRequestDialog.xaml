<?xml version="1.0" encoding="utf-8"?>
<!--
  components/request-review-row.tsx's Reject chooser: the server's preset
  reasons plus "Other" with a free-text field. Decline stays disabled until
  there is a reason to send; the server trims and caps it again either way.
-->
<ContentDialog
    x:Class="Marquee.Windows.Controls.DeclineRequestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Decline request"
    PrimaryButtonText="Decline"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="14" MinWidth="380">
        <TextBlock
            x:Name="ExplanationText"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        <RadioButtons
            x:Name="ReasonButtons"
            Header="Reason"
            SelectionChanged="OnReasonChanged" />
        <TextBox
            x:Name="CustomReasonBox"
            PlaceholderText="Tell them why"
            MaxLength="200"
            Visibility="Collapsed"
            TextChanged="OnCustomReasonChanged" />
    </StackPanel>
</ContentDialog>
