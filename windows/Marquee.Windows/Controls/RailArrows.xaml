<?xml version="1.0" encoding="utf-8"?>
<!--
  components/shelf.tsx's ShelfArrow pair (the Mac's Shelf chevrons): the
  28px round ‹ › buttons at the right end of a rail's header, paging the
  rail named by Target sideways. ‹ fades at the start, › at the end, and
  both go when the whole row already fits.
-->
<UserControl
    x:Class="Marquee.Windows.Controls.RailArrows"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel x:Name="Arrows" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
        <Button
            x:Name="PreviousButton"
            Style="{StaticResource MarqueeRailArrowStyle}"
            Click="OnPreviousClick"
            IsEnabled="False"
            AutomationProperties.Name="Scroll left"
            ToolTipService.ToolTip="Scroll left">
            <FontIcon Glyph="&#xE76B;" FontSize="12" />
        </Button>
        <Button
            x:Name="NextButton"
            Style="{StaticResource MarqueeRailArrowStyle}"
            Click="OnNextClick"
            IsEnabled="False"
            AutomationProperties.Name="Scroll right"
            ToolTipService.ToolTip="Scroll right">
            <FontIcon Glyph="&#xE76C;" FontSize="12" />
        </Button>
    </StackPanel>
</UserControl>
