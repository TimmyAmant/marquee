<?xml version="1.0" encoding="utf-8"?>
<!--
  components/studio-chip.tsx (the Mac's StudioChip): a studio's name, after
  its small logo on a white plate when it has one, so dark line-art marks stay
  readable. Every chip is the same height with or without a logo. Used on a
  title page, search results and favorites; Discover draws studios as
  LogoTiles instead.
-->
<UserControl
    x:Class="Marquee.Windows.Controls.StudioChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button
        Command="{x:Bind Item.Open, Mode=OneWay}"
        Padding="8,4,12,4"
        CornerRadius="16"
        AutomationProperties.Name="{x:Bind Item.Label, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="10" Height="32">
            <Border
                Background="White"
                CornerRadius="5"
                Padding="6,4"
                VerticalAlignment="Center"
                Visibility="{x:Bind Item.HasImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Image Source="{x:Bind Item.Image, Mode=OneWay}" Width="40" Height="24" Stretch="Uniform" />
            </Border>
            <TextBlock
                Text="{x:Bind Item.Label, Mode=OneWay}"
                VerticalAlignment="Center"
                MaxLines="1"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Button>
</UserControl>
