<?xml version="1.0" encoding="utf-8"?>
<!--
  household-members-list.tsx's edit form: name, username and a new
  password for any row the viewer may edit. "Current password" shows only
  on your own account (the server wants it with a new password there; the
  admin resetting someone else's doesn't know theirs), and for the admin
  editing a non-admin account what they can do (0.48+: a preset and the
  switches; before that the two auto-approve boxes and, 0.39+, the Role)
  with (0.39+) the request limits. The
  photo sits at the top with "Add photo" / "Change photo" and "Remove",
  saved as soon as a photo is picked (the website's form does the same;
  Save isn't involved). The code-behind picks which parts show and fills
  in the account.
-->
<ContentDialog
    x:Class="Marquee.Windows.Controls.EditMemberDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Marquee.Windows.Controls"
    xmlns:models="using:Marquee.Core.Models"
    mc:Ignorable="d"
    x:Uid="Member_EditDialog"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveClick"
    Closing="OnDialogClosing">

    <StackPanel Spacing="12" MinWidth="380">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:AvatarView x:Name="PhotoAvatar" Grid.Column="0" Diameter="64" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ChoosePhotoButton" Click="OnChoosePhotoClick" />
                    <Button x:Name="RemovePhotoButton" x:Uid="Member_RemovePhoto" Click="OnRemovePhotoClick" Visibility="Collapsed" />
                    <ProgressRing x:Name="PhotoProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock
                    x:Uid="Member_PhotoNote"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <InfoBar
            x:Name="PhotoErrorBar"
            Severity="Error"
            IsOpen="False"
            IsClosable="False" />
        <TextBox
            x:Name="DisplayNameBox"
            x:Uid="Member_EditName"
            MaxLength="80" />
        <TextBox
            x:Name="UsernameBox"
            x:Uid="Member_EditUsername"
            IsSpellCheckEnabled="False"
            MaxLength="32"
            TextChanged="OnUsernameChanged" />
        <PasswordBox
            x:Name="NewPasswordInput"
            x:Uid="Member_EditNewPassword" />
        <PasswordBox
            x:Name="CurrentPasswordInput"
            x:Uid="Member_EditCurrentPassword"
            Visibility="Collapsed" />
        <!-- Before 0.48: the two auto-approve boxes. -->
        <StackPanel x:Name="AutoApprovePanel" Visibility="Collapsed">
            <CheckBox x:Name="AutoApproveMoviesBox" x:Uid="Member_AutoApproveMovies" />
            <CheckBox x:Name="AutoApproveTvBox" x:Uid="Member_AutoApproveTv" />
        </StackPanel>
        <!--
          0.48+: app/settings/permissions-editor.tsx, for the admin editing
          another member. The preset picker fills the switches in and reads
          Custom (never picked by hand) once they match neither preset.
          MemberPermissionsEditor holds the logic; this only binds to it.
        -->
        <StackPanel x:Name="PermissionsPanel" Spacing="12" Visibility="Collapsed">
            <ComboBox
                x:Name="PresetBox"
                x:Uid="Member_Preset"
                HorizontalAlignment="Stretch"
                SelectedIndex="{x:Bind Access.PresetIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="Member_PresetMember" />
                <ComboBoxItem x:Uid="Member_PresetTrusted" />
                <ComboBoxItem x:Uid="Member_PresetCustom" IsEnabled="False" />
            </ComboBox>
            <ItemsControl ItemsSource="{x:Bind Access.Groups}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PermissionGroup">
                        <StackPanel Spacing="4" Margin="0,0,0,12">
                            <TextBlock
                                Text="{x:Bind Title}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind Items}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PermissionToggle">
                                        <CheckBox
                                            IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind Label}"
                                            Padding="8,0,0,0"
                                            Margin="0,2">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyTextBlockStyle}" />
                                                <TextBlock
                                                    Text="{x:Bind Note, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                x:Uid="Member_AdminOnlyNote"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
        <!-- 0.39+: Role (before 0.48) and request limits, for the admin editing a non-admin account. -->
        <StackPanel x:Name="AccessPanel" Spacing="12" Visibility="Collapsed">
            <ComboBox x:Name="RoleBox" x:Uid="Member_Role" HorizontalAlignment="Stretch" />
            <StackPanel Spacing="8">
                <TextBlock x:Name="LimitsHeaderText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="Member_LimitMovies" Width="80" VerticalAlignment="Center" />
                    <TextBox
                        x:Name="MovieLimitBox"
                        Width="96"
                        InputScope="Number"
                        MaxLength="4"
                        x:Uid="Member_MovieLimitBox" />
                    <TextBlock x:Uid="Member_MovieEvery" VerticalAlignment="Center" />
                    <TextBox
                        x:Name="MovieDaysBox"
                        Width="72"
                        InputScope="Number"
                        MaxLength="3"
                        x:Uid="Member_MovieDaysBox" />
                    <TextBlock x:Uid="Member_MovieDays" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="Member_LimitTv" Width="80" VerticalAlignment="Center" />
                    <TextBox
                        x:Name="TvLimitBox"
                        Width="96"
                        InputScope="Number"
                        MaxLength="4"
                        x:Uid="Member_TvLimitBox" />
                    <TextBlock x:Uid="Member_TvEvery" VerticalAlignment="Center" />
                    <TextBox
                        x:Name="TvDaysBox"
                        Width="72"
                        InputScope="Number"
                        MaxLength="3"
                        x:Uid="Member_TvDaysBox" />
                    <TextBlock x:Uid="Member_TvDays" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <TextBlock
            x:Name="PasswordNoteText"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            TextWrapping="Wrap" />
        <InfoBar
            x:Name="ErrorBar"
            Severity="Error"
            IsOpen="False"
            IsClosable="False" />
    </StackPanel>
</ContentDialog>
