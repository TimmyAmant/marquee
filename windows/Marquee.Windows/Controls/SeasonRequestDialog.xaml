<?xml version="1.0" encoding="utf-8"?>
<!--
  The website's season picker, after Seerr's: a table of every season TMDb
  lists, in the Episodes accordion's order, each with a checkbox (enabled
  when it can be picked), its episode count and a status pill. The header's
  "Select all" ticks every requestable season. Request sends the request
  itself and keeps the dialog open with the server's message on a failure;
  it stays disabled while nothing is ticked.

  The same picker changes a pending request (0.46+): "Change request", its
  seasons ticked, the scope and 4K choices above the list, "Save changes".
-->
<ContentDialog
    x:Class="Marquee.Windows.Controls.SeasonRequestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d"
    x:Uid="Season_Dialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Closing="OnClosing">

    <StackPanel Spacing="12" MinWidth="380">
        <TextBlock
            x:Name="ExplanationText"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        <!--
          Editing a pending request (0.46+, components/request-lifecycle.tsx):
          "The whole series" / "Just these seasons" for TV, and "In 4K" when
          4K is set up (always the whole show). Collapsed when requesting.
        -->
        <StackPanel x:Name="EditOptionsPanel" Spacing="2" Visibility="Collapsed">
            <RadioButton x:Name="WholeSeriesRadio" x:Uid="Season_WholeSeries" GroupName="EditRequestScope" Checked="OnScopeChecked" />
            <RadioButton x:Name="JustTheseRadio" x:Uid="Season_JustThese" GroupName="EditRequestScope" Checked="OnScopeChecked" />
            <CheckBox x:Name="FourKBox" x:Uid="Season_FourK" Click="OnFourKClick" />
            <TextBlock
                x:Name="NothingToChangeText"
                Visibility="Collapsed"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
        <!-- 0.53+: the viewer's requests are approved at once. -->
        <InfoBar x:Name="AutoApproveBar" x:Uid="Season_AutoApprove" Severity="Informational" IsClosable="False" IsOpen="False" />
        <!--
          After Seerr's: a table. The header's checkbox picks every season;
          each row is the season's checkbox, name, episode count and status.
        -->
        <Border
            x:Name="RowsBorder"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
                <Grid Padding="12,4" MinHeight="36" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectAllBox" x:Uid="Season_SelectAll" Click="OnSelectAllClick" VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        x:Uid="Season_EpisodesColumn"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="2"
                        x:Uid="Season_StatusColumn"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                <ScrollViewer x:Name="RowsScroller" MaxHeight="340" Padding="0,4">
                    <ItemsRepeater x:Name="RowsRepeater">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SeasonPickerRow">
                                <Grid Padding="12,2" MinHeight="40" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Grid.Column="0"
                                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                        IsEnabled="{x:Bind IsRequestable}"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    </CheckBox>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind EpisodeCountText}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                                    <controls:TonePill
                                        Grid.Column="2"
                                        Text="{x:Bind Pill}"
                                        Tone="{x:Bind PillTone}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <TextBlock
            x:Name="ErrorText"
            Visibility="Collapsed"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
