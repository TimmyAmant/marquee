<?xml version="1.0" encoding="utf-8"?>
<!--
  components/poster-card.tsx, drawn the way the Mac's PosterCard draws it:
  artwork with the MOVIE/SERIES pill (or, on the Movies/Series grid, the
  rating chip) top-left, the library status pill top-right and the status
  strip along the artwork's foot, then a name and a footer line. The whole
  tile is one Button so keyboard users tab through a rail card by card and
  a screen reader reads each as one item (AutomationProperties.Name).

  The status pill (and the strip under the art) is one element per palette,
  with theme brushes, rather than one whose colors are computed in code:
  {ThemeResource} keeps following light/dark switches at runtime, and
  nothing here touches resources from code. The same goes for the type
  pill's blue (MOVIE) and magenta (SERIES) fills.

  The hover panel (the overview on the Movies/Series grid, then the quick
  action: "+ Add to Radarr", "Request", the "Requested" pill) sits at the
  foot of the artwork over a bg0 scrim, like the Mac's. It is a sibling of
  the card button, not a child, so clicking the button in it never also
  opens the title (PersonCard's star does the same); the scrim and the
  overview take no clicks, so those still reach the card. The code-behind
  shows it while the pointer is over the card, while focus is anywhere in
  the card (so Tab reaches it), while it's working or showing an error, and
  the quick action always on a PC with no mouse (the website's
  [@media(hover:hover)]).

  Sizes are the Mac's points one for one: the type pill 9/bold white text,
  padding 5,3,5,2.5, radius 4, 7 in from the corner; the status pill 17
  high, 10/semibold, a 5 dot 4 from its text, 5 and 6 either side, 6 in
  from the corner, its tone's background at 94% and its tone's color at 30%
  for the ring; the strip 3 high.

  In a grid (FillsColumn) the card follows its column's width and the
  artwork keeps 2:3, so the columns stretch to the row's full width.
-->
<UserControl
    x:Class="Marquee.Windows.Controls.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="150"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    PointerCanceled="OnPointerExited"
    GotFocus="OnGotFocus"
    LostFocus="OnLostFocus">

    <UserControl.Resources>
        <!-- The MOVIE / SERIES pill. -->
        <Style x:Key="TypeBadgeStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="7" />
            <Setter Property="Padding" Value="5,3,5,2.5" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="TypeBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="50" />
        </Style>

        <!-- The status pill: a fill at 94% under a ring holding the dot and the label. -->
        <Style x:Key="StatusPillStyle" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Height" Value="17" />
        </Style>
        <Style x:Key="StatusPillFillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8.5" />
            <Setter Property="Opacity" Value="0.94" />
        </Style>
        <Style x:Key="StatusPillRingStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8.5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,0,5,0" />
        </Style>
        <Style x:Key="StatusPillDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusPillTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The strip along the artwork's foot. -->
        <Style x:Key="StatusStripStyle" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Height" Value="3" />
            <Setter Property="CornerRadius" Value="0,0,7,7" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button
            x:Name="CardButton"
            Command="{x:Bind Item.Open, Mode=OneWay}"
            CommandParameter="{x:Bind Item, Mode=OneWay}"
            Padding="0"
            Margin="0"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Top"
            ToolTipService.ToolTip="{x:Bind Item.Name, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Item.AccessibleName, Mode=OneWay}">
            <StackPanel Spacing="6">
                <Grid
                    x:Name="Artwork"
                    Height="225"
                    CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Image Source="{x:Bind Item.Poster, Mode=OneWay}" Stretch="UniformToFill" />

                    <!-- No artwork: the name stands in, like the website's grey tile. -->
                    <TextBlock
                        Text="{x:Bind Item.Name, Mode=OneWay}"
                        Visibility="{x:Bind Item.HasPoster, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="12" />

                    <!--
                      The status strip (poster-card.tsx): the pill's color, none
                      for a title not in the library. Hovering it names the status.
                    -->
                    <Border
                        Visibility="{x:Bind Item.IsOwnedTone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource StatusStripStyle}"
                        Background="{ThemeResource OwnedBadgeForegroundBrush}"
                        ToolTipService.ToolTip="{x:Bind Item.StatusName, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Item.StatusName, Mode=OneWay}" />
                    <Border
                        Visibility="{x:Bind Item.IsDownloadingTone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource StatusStripStyle}"
                        Background="{ThemeResource DownloadingBadgeForegroundBrush}"
                        ToolTipService.ToolTip="{x:Bind Item.StatusName, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Item.StatusName, Mode=OneWay}" />
                    <Border
                        Visibility="{x:Bind Item.IsMissingTone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource StatusStripStyle}"
                        Background="{ThemeResource MissingBadgeForegroundBrush}"
                        ToolTipService.ToolTip="{x:Bind Item.StatusName, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Item.StatusName, Mode=OneWay}" />
                    <Border
                        Visibility="{x:Bind Item.IsUnmonitoredTone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource StatusStripStyle}"
                        Background="{ThemeResource UnmonitoredBadgeForegroundBrush}"
                        ToolTipService.ToolTip="{x:Bind Item.StatusName, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Item.StatusName, Mode=OneWay}" />
                    <Border
                        Visibility="{x:Bind Item.IsSoonTone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource StatusStripStyle}"
                        Background="{ThemeResource SoonBadgeForegroundBrush}"
                        ToolTipService.ToolTip="{x:Bind Item.StatusName, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Item.StatusName, Mode=OneWay}" />

                    <!-- Top-left: "MOVIE" (blue) / "SERIES" (magenta) on rows that mix both. -->
                    <Border
                        Visibility="{x:Bind Item.IsMovieTypeBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource TypeBadgeStyle}"
                        Background="{ThemeResource MovieTypeBadgeBrush}">
                        <TextBlock
                            Text="{x:Bind Item.TypeLabel, Mode=OneWay}"
                            Style="{StaticResource TypeBadgeTextStyle}"
                            Foreground="{ThemeResource TypeBadgeForegroundBrush}" />
                    </Border>
                    <Border
                        Visibility="{x:Bind Item.IsSeriesTypeBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource TypeBadgeStyle}"
                        Background="{ThemeResource SeriesTypeBadgeBrush}">
                        <TextBlock
                            Text="{x:Bind Item.TypeLabel, Mode=OneWay}"
                            Style="{StaticResource TypeBadgeTextStyle}"
                            Foreground="{ThemeResource TypeBadgeForegroundBrush}" />
                    </Border>

                    <!-- Top-left instead, on the Movies/Series grid: the TMDb rating. -->
                    <Border
                        Visibility="{x:Bind Item.HasRating, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="6"
                        Padding="7,2.5"
                        CornerRadius="9"
                        Background="{ThemeResource RatingChipBackgroundBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <FontIcon
                                Glyph="&#xE735;"
                                FontSize="8"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource MarqueeAccentBrush}" />
                            <TextBlock
                                Text="{x:Bind Item.RatingLabel, Mode=OneWay}"
                                FontSize="10"
                                FontWeight="Medium"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource MarqueeAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Top-right: the library status pill ("Owned", "Coming soon"). -->
                    <Grid
                        Visibility="{x:Bind Item.IsOwnedTone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource StatusPillStyle}"
                        ToolTipService.ToolTip="{x:Bind Item.StatusName, Mode=OneWay}">
                        <Border Style="{StaticResource StatusPillFillStyle}" Background="{ThemeResource OwnedBadgeBackgroundBrush}" />
                        <Border Style="{StaticResource StatusPillRingStyle}" BorderBrush="{ThemeResource OwnedBadgeBorderBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Style="{StaticResource StatusPillDotStyle}" Fill="{ThemeResource OwnedBadgeForegroundBrush}" />
                                <TextBlock
                                    Text="{x:Bind Item.StatusLabel, Mode=OneWay}"
                                    Style="{StaticResource StatusPillTextStyle}"
                                    Foreground="{ThemeResource OwnedBadgeForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid
                        Visibility="{x:Bind Item.IsDownloadingTone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource StatusPillStyle}"
                        ToolTipService.ToolTip="{x:Bind Item.StatusName, Mode=OneWay}">
                        <Border Style="{StaticResource StatusPillFillStyle}" Background="{ThemeResource DownloadingBadgeBackgroundBrush}" />
                        <Border Style="{StaticResource StatusPillRingStyle}" BorderBrush="{ThemeResource DownloadingBadgeBorderBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Style="{StaticResource StatusPillDotStyle}" Fill="{ThemeResource DownloadingBadgeForegroundBrush}" />
                                <TextBlock
                                    Text="{x:Bind Item.StatusLabel, Mode=OneWay}"
                                    Style="{StaticResource StatusPillTextStyle}"
                                    Foreground="{ThemeResource DownloadingBadgeForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid
                        Visibility="{x:Bind Item.IsMissingTone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource StatusPillStyle}"
                        ToolTipService.ToolTip="{x:Bind Item.StatusName, Mode=OneWay}">
                        <Border Style="{StaticResource StatusPillFillStyle}" Background="{ThemeResource MissingBadgeBackgroundBrush}" />
                        <Border Style="{StaticResource StatusPillRingStyle}" BorderBrush="{ThemeResource MissingBadgeBorderBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Style="{StaticResource StatusPillDotStyle}" Fill="{ThemeResource MissingBadgeForegroundBrush}" />
                                <TextBlock
                                    Text="{x:Bind Item.StatusLabel, Mode=OneWay}"
                                    Style="{StaticResource StatusPillTextStyle}"
                                    Foreground="{ThemeResource MissingBadgeForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid
                        Visibility="{x:Bind Item.IsUnmonitoredTone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource StatusPillStyle}"
                        ToolTipService.ToolTip="{x:Bind Item.StatusName, Mode=OneWay}">
                        <Border Style="{StaticResource StatusPillFillStyle}" Background="{ThemeResource UnmonitoredBadgeBackgroundBrush}" />
                        <Border Style="{StaticResource StatusPillRingStyle}" BorderBrush="{ThemeResource UnmonitoredBadgeBorderBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Style="{StaticResource StatusPillDotStyle}" Fill="{ThemeResource UnmonitoredBadgeForegroundBrush}" />
                                <TextBlock
                                    Text="{x:Bind Item.StatusLabel, Mode=OneWay}"
                                    Style="{StaticResource StatusPillTextStyle}"
                                    Foreground="{ThemeResource UnmonitoredBadgeForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid
                        Visibility="{x:Bind Item.IsSoonTone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource StatusPillStyle}"
                        ToolTipService.ToolTip="{x:Bind Item.StatusName, Mode=OneWay}">
                        <Border Style="{StaticResource StatusPillFillStyle}" Background="{ThemeResource SoonBadgeBackgroundBrush}" />
                        <Border Style="{StaticResource StatusPillRingStyle}" BorderBrush="{ThemeResource SoonBadgeBorderBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Style="{StaticResource StatusPillDotStyle}" Fill="{ThemeResource SoonBadgeForegroundBrush}" />
                                <TextBlock
                                    Text="{x:Bind Item.StatusLabel, Mode=OneWay}"
                                    Style="{StaticResource StatusPillTextStyle}"
                                    Foreground="{ThemeResource SoonBadgeForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid
                        Visibility="{x:Bind Item.IsNeutralTone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource StatusPillStyle}"
                        ToolTipService.ToolTip="{x:Bind Item.StatusName, Mode=OneWay}">
                        <Border Style="{StaticResource StatusPillFillStyle}" Background="{ThemeResource NeutralBadgeBackgroundBrush}" />
                        <Border Style="{StaticResource StatusPillRingStyle}" BorderBrush="{ThemeResource NeutralBadgeBorderBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Style="{StaticResource StatusPillDotStyle}" Fill="{ThemeResource NeutralBadgeForegroundBrush}" />
                                <TextBlock
                                    Text="{x:Bind Item.StatusLabel, Mode=OneWay}"
                                    Style="{StaticResource StatusPillTextStyle}"
                                    Foreground="{ThemeResource NeutralBadgeForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <TextBlock
                    Text="{x:Bind Item.Name, Mode=OneWay}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
                <TextBlock
                    Text="{x:Bind Item.FooterLine, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1"
                    MinHeight="16" />
            </StackPanel>
        </Button>

        <!--
          Drawn last, over the artwork's foot. Its height follows the artwork
          (the code-behind sets both), and the empty part of this Grid has no
          background, so a click above the panel still reaches the card.
        -->
        <Grid
            x:Name="QuickActionLayer"
            Height="225"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <Grid VerticalAlignment="Bottom" CornerRadius="0,0,8,8">
                <Border Background="{ThemeResource PosterHoverScrimBrush}" CornerRadius="0,0,8,8" IsHitTestVisible="False" />

                <StackPanel Padding="9,10,9,9" Spacing="10">
                    <!-- The Movies/Series grid's overview, clamped to 5 lines; clicks fall through to the card. -->
                    <TextBlock
                        x:Name="OverviewText"
                        Text="{x:Bind Item.Overview, Mode=OneWay}"
                        Visibility="Collapsed"
                        FontSize="11"
                        LineHeight="16"
                        TextWrapping="Wrap"
                        MaxLines="5"
                        TextTrimming="CharacterEllipsis"
                        IsHitTestVisible="False"
                        Foreground="{ThemeResource PosterOverviewForegroundBrush}" />

                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind Item.ShowsQuickActionSlot, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Button
                            Command="{x:Bind Item.QuickAddCommand, Mode=OneWay}"
                            Visibility="{x:Bind Item.IsAddAction, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="26"
                            Padding="8,0"
                            CornerRadius="13"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="{x:Bind Item.AddLabel, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Item.AddButtonLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </Button>

                        <Button
                            Command="{x:Bind Item.RequestCommand, Mode=OneWay}"
                            Visibility="{x:Bind Item.IsRequestAction, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="26"
                            Padding="8,0"
                            CornerRadius="13"
                            FontSize="11"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Request">
                            <TextBlock Text="{x:Bind Item.RequestButtonLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </Button>

                        <!-- request-button.tsx's compact "Requested": a pill, not a button. -->
                        <Border
                            Visibility="{x:Bind Item.IsRequestedAction, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="8,4"
                            CornerRadius="12"
                            Background="{ThemeResource InfoBadgeBackgroundBrush}"
                            BorderBrush="{ThemeResource InfoBadgeBorderBrush}"
                            BorderThickness="1">
                            <TextBlock
                                Text="Requested"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource InfoBadgeForegroundBrush}" />
                        </Border>

                        <Border
                            Visibility="{x:Bind Item.HasQuickActionError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="6,2"
                            CornerRadius="4"
                            Background="#E6000000">
                            <TextBlock
                                Text="{x:Bind Item.QuickActionError, Mode=OneWay}"
                                FontSize="10"
                                TextWrapping="Wrap"
                                MaxLines="3"
                                TextTrimming="CharacterEllipsis"
                                TextAlignment="Center"
                                Foreground="#FFF87171" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
