<?xml version="1.0" encoding="utf-8"?>
<!--
  components/person-tile.tsx (the Mac's SearchPersonTile): search's person
  card, a round photo, the name, and what they're known for ("Acting · The
  Matrix, John Wick"). Round so a row of people never reads as more posters.
  The star is a sibling of the card button, as on PersonCard, so a click on
  it never also opens the person.
-->
<UserControl
    x:Class="Marquee.Windows.Controls.SearchPersonTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="132">

    <Grid>
        <Button
            Command="{x:Bind Item.Open, Mode=OneWay}"
            Padding="0"
            Margin="0"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Top"
            ToolTipService.ToolTip="{x:Bind Item.Name, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Item.Name, Mode=OneWay}">
            <StackPanel Spacing="6">
                <Grid
                    Width="120"
                    Height="120"
                    HorizontalAlignment="Center"
                    CornerRadius="60"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Image Source="{x:Bind Item.Photo, Mode=OneWay}" Stretch="UniformToFill" VerticalAlignment="Top" />
                    <FontIcon
                        Glyph="&#xE77B;"
                        FontSize="36"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind Item.HasPhoto, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}" />
                </Grid>
                <TextBlock
                    Text="{x:Bind Item.Name, Mode=OneWay}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
                <TextBlock
                    Text="{x:Bind Item.Subtitle, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="2"
                    MinHeight="32" />
            </StackPanel>
        </Button>

        <Button
            Command="{x:Bind Item.ToggleFavoriteCommand, Mode=OneWay}"
            Visibility="{x:Bind Item.CanFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="4"
            Padding="6"
            CornerRadius="14"
            Background="#B3000000"
            BorderThickness="0"
            ToolTipService.ToolTip="{x:Bind Item.FavoriteLabel, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Item.FavoriteLabel, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind Item.FavoriteGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Button>
    </Grid>
</UserControl>
