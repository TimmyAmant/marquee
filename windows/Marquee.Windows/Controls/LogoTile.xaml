<?xml version="1.0" encoding="utf-8"?>
<!--
  components/logo-card.tsx (the Mac's LogoCard): Discover's Studios and
  Networks tiles. The logo sits on white, not on the dark card, because TMDb
  logos are a mix of transparent black line art and full-color marks and only
  white keeps both readable. Without a logo the name stands in on the card
  color. One Button, like PosterCard, so the tile tabs, focuses and reads as
  one item; hover strengthens the outline (the website's hover:border-strong).
-->
<UserControl
    x:Class="Marquee.Windows.Controls.LogoTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="224"
    Height="112">

    <Button
        x:Name="TileButton"
        Command="{x:Bind Item.Open, Mode=OneWay}"
        Padding="0"
        Margin="0"
        Background="Transparent"
        BorderThickness="0"
        CornerRadius="12"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        ToolTipService.ToolTip="{x:Bind Item.Label, Mode=OneWay}"
        AutomationProperties.Name="{x:Bind Item.Label, Mode=OneWay}">
        <Grid x:Name="Tile" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Border
                Background="White"
                Padding="20"
                Visibility="{x:Bind Item.HasImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Image
                    Source="{x:Bind Item.Image, Mode=OneWay}"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <!-- No logo: the name, like the website's text fallback. -->
            <TextBlock
                Text="{x:Bind Item.Label, Mode=OneWay}"
                Visibility="{x:Bind Item.HasImage, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center"
                MaxLines="3"
                TextTrimming="CharacterEllipsis"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="16,0" />

            <!-- The outline, and its hover shade on top (faded in from code). -->
            <Border
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                IsHitTestVisible="False" />
            <Border
                x:Name="HoverOutline"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                Opacity="0"
                IsHitTestVisible="False" />
        </Grid>
    </Button>
</UserControl>
