<?xml version="1.0" encoding="utf-8"?>
<!--
  A status pill in one of the badge palettes (the Mac's TonePill):
  request status labels, a season's episode count, "Have it" / "Missing".
  One Border per palette, with theme brushes, the same way PosterCard draws its badge,
  so the colors keep following light/dark switches; the code-behind only
  chooses which one is visible.
-->
<UserControl
    x:Class="Marquee.Windows.Controls.TonePill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Left"
    VerticalAlignment="Center">

    <Grid>
        <Border
            x:Name="OwnedBorder"
            Visibility="Collapsed"
            Padding="8,2"
            CornerRadius="10"
            Background="{ThemeResource OwnedBadgeBackgroundBrush}"
            BorderBrush="{ThemeResource OwnedBadgeBorderBrush}"
            BorderThickness="1">
            <TextBlock
                x:Name="OwnedText"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{ThemeResource OwnedBadgeForegroundBrush}" />
        </Border>
        <Border
            x:Name="DownloadingBorder"
            Visibility="Collapsed"
            Padding="8,2"
            CornerRadius="10"
            Background="{ThemeResource DownloadingBadgeBackgroundBrush}"
            BorderBrush="{ThemeResource DownloadingBadgeBorderBrush}"
            BorderThickness="1">
            <TextBlock
                x:Name="DownloadingText"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{ThemeResource DownloadingBadgeForegroundBrush}" />
        </Border>
        <Border
            x:Name="MissingBorder"
            Visibility="Collapsed"
            Padding="8,2"
            CornerRadius="10"
            Background="{ThemeResource MissingBadgeBackgroundBrush}"
            BorderBrush="{ThemeResource MissingBadgeBorderBrush}"
            BorderThickness="1">
            <TextBlock
                x:Name="MissingText"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{ThemeResource MissingBadgeForegroundBrush}" />
        </Border>
        <Border
            x:Name="UnmonitoredBorder"
            Visibility="Collapsed"
            Padding="8,2"
            CornerRadius="10"
            Background="{ThemeResource UnmonitoredBadgeBackgroundBrush}"
            BorderBrush="{ThemeResource UnmonitoredBadgeBorderBrush}"
            BorderThickness="1">
            <TextBlock
                x:Name="UnmonitoredText"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{ThemeResource UnmonitoredBadgeForegroundBrush}" />
        </Border>
        <Border
            x:Name="SoonBorder"
            Visibility="Collapsed"
            Padding="8,2"
            CornerRadius="10"
            Background="{ThemeResource SoonBadgeBackgroundBrush}"
            BorderBrush="{ThemeResource SoonBadgeBorderBrush}"
            BorderThickness="1">
            <TextBlock
                x:Name="SoonText"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{ThemeResource SoonBadgeForegroundBrush}" />
        </Border>
        <Border
            x:Name="ReadyBorder"
            Visibility="Collapsed"
            Padding="8,2"
            CornerRadius="10"
            Background="{ThemeResource ReadyBadgeBackgroundBrush}"
            BorderBrush="{ThemeResource ReadyBadgeBorderBrush}"
            BorderThickness="1">
            <TextBlock
                x:Name="ReadyText"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{ThemeResource ReadyBadgeForegroundBrush}" />
        </Border>
        <Border
            x:Name="InfoBorder"
            Visibility="Collapsed"
            Padding="8,2"
            CornerRadius="10"
            Background="{ThemeResource InfoBadgeBackgroundBrush}"
            BorderBrush="{ThemeResource InfoBadgeBorderBrush}"
            BorderThickness="1">
            <TextBlock
                x:Name="InfoText"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{ThemeResource InfoBadgeForegroundBrush}" />
        </Border>
        <Border
            x:Name="NeutralBorder"
            Visibility="Collapsed"
            Padding="8,2"
            CornerRadius="10"
            Background="{ThemeResource NeutralBadgeBackgroundBrush}"
            BorderBrush="{ThemeResource NeutralBadgeBorderBrush}"
            BorderThickness="1">
            <TextBlock
                x:Name="NeutralText"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{ThemeResource NeutralBadgeForegroundBrush}" />
        </Border>
    </Grid>
</UserControl>
