<?xml version="1.0" encoding="utf-8"?>
<!--
  components/status-legend.tsx (the Mac's StatusColorKey): a small
  "Color key" pill beside a poster grid or a page title, led by a row of
  tiny dots in the status colors, whose flyout lists every library state
  (StatusColorLegend) with the "Same colors as Radarr and Sonarr." footnote.
  The dots use the same theme brushes as PosterCard's strip, so they follow
  light/dark switches.
-->
<UserControl
    x:Class="Marquee.Windows.Controls.StatusColorKey"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d"
    VerticalAlignment="Center">

    <Button
        Height="26"
        Padding="10,0"
        CornerRadius="13"
        x:Uid="Status_KeyButton">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{ThemeResource OwnedBadgeForegroundBrush}" />
                <Ellipse Width="6" Height="6" Fill="{ThemeResource DownloadingBadgeForegroundBrush}" />
                <Ellipse Width="6" Height="6" Fill="{ThemeResource MissingBadgeForegroundBrush}" />
                <Ellipse Width="6" Height="6" Fill="{ThemeResource UnmonitoredBadgeForegroundBrush}" />
                <Ellipse Width="6" Height="6" Fill="{ThemeResource SoonBadgeForegroundBrush}" />
            </StackPanel>
            <TextBlock
                x:Uid="Status_KeyLabel"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="300" Spacing="10">
                    <TextBlock x:Uid="Status_KeyHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:StatusColorLegend />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
