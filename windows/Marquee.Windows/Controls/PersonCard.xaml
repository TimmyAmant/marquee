<?xml version="1.0" encoding="utf-8"?>
<!--
  components/person-card.tsx: a profile photo, the name, the known-for
  department or the character, and the favorite star. The star is a sibling
  of the card button rather than a child of it, so a click on the star never
  also opens the person; it is drawn last, so it sits on top of the photo.
-->
<UserControl
    x:Class="Marquee.Windows.Controls.PersonCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="150">

    <Grid>
        <Button
            Command="{x:Bind Item.Open, Mode=OneWay}"
            Padding="0"
            Margin="0"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Top"
            ToolTipService.ToolTip="{x:Bind Item.Name, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Item.Name, Mode=OneWay}">
            <StackPanel Spacing="6">
                <Grid
                    Height="225"
                    CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Image Source="{x:Bind Item.Photo, Mode=OneWay}" Stretch="UniformToFill" />
                    <FontIcon
                        Glyph="&#xE77B;"
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind Item.HasPhoto, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}" />
                </Grid>
                <TextBlock
                    Text="{x:Bind Item.Name, Mode=OneWay}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
                <TextBlock
                    Text="{x:Bind Item.Subtitle, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1"
                    MinHeight="16" />
            </StackPanel>
        </Button>

        <Button
            Command="{x:Bind Item.ToggleFavoriteCommand, Mode=OneWay}"
            Visibility="{x:Bind Item.CanFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="6"
            Padding="6"
            CornerRadius="14"
            Background="#B3000000"
            BorderThickness="0"
            ToolTipService.ToolTip="{x:Bind Item.FavoriteLabel, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Item.FavoriteLabel, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind Item.FavoriteGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Button>
    </Grid>
</UserControl>
