<?xml version="1.0" encoding="utf-8"?>
<!--
  components/trailer-button.tsx's player, as on the Mac and the iPhone: the
  YouTube trailer plays in the app (YouTube's privacy-enhanced embed, in a
  WebView2), with "Open on YouTube" and Done. Escape closes it like any
  dialog; the code-behind builds the page and keeps the player on it.
-->
<ContentDialog
    x:Class="Marquee.Windows.Controls.TrailerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="Trailer_Dialog"
    DefaultButton="Close"
    Opened="OnOpened"
    Closed="OnClosed"
    SecondaryButtonClick="OnOpenOnYouTubeClick">

    <ContentDialog.Resources>
        <!-- Wide enough for a 16:9 picture; the default caps a dialog at 548. -->
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>
    </ContentDialog.Resources>

    <Grid Width="854" Height="480" Background="Black">
        <WebView2 x:Name="Player" x:Uid="Trailer_Player" />
    </Grid>
</ContentDialog>
