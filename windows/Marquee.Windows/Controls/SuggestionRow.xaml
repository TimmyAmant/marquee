<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the shell's search type-ahead (components/search-bar.tsx, the
  Mac's SearchPanelRow): the group's label on a group's first row, then a
  poster (a round photo for a person, a logo on white for a studio or
  network), the name over its subtitle, and the Movie/TV/Actor/Studio pill, which wears the title's library status in the poster
  badge's palette (TonePill: green in the library, purple downloading, red
  missing, orange not monitored, blue coming soon, neutral otherwise).

  MainWindow's AutoSuggestBox uses this as its item template with no
  bindings (that file stays binding-free), so the row fills itself from its
  DataContext, a SuggestionItem, in code-behind.
-->
<UserControl
    x:Class="Marquee.Windows.Controls.SuggestionRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <StackPanel>
        <!-- The group's small label (Movies, TV Shows, People, Studios and Networks), on its first row only. -->
        <TextBlock
            x:Name="GroupText"
            Visibility="Collapsed"
            Margin="0,6,0,2"
            FontSize="10.5"
            FontWeight="SemiBold"
            CharacterSpacing="60"
            Foreground="{ThemeResource MarqueeNavTextSecondaryBrush}" />

        <Grid ColumnSpacing="12" Padding="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- A poster, a round photo for a person, or a logo on white for a studio or network (set in code). -->
            <Border
                x:Name="PosterFrame"
                Width="30"
                Height="44"
                CornerRadius="4"
                HorizontalAlignment="Center"
                Background="{ThemeResource NeutralBadgeBackgroundBrush}">
                <Image x:Name="Poster" Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="NameText"
                    FontSize="14"
                    FontWeight="Medium"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="12"
                    Foreground="{ThemeResource MarqueeNavTextSecondaryBrush}"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <controls:TonePill x:Name="KindPill" Grid.Column="2" VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</UserControl>
