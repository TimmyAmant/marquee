<?xml version="1.0" encoding="utf-8"?>
<!--
  app/discover/[list]/page.tsx: a Discover shelf's "See all". The list's
  title, then the poster grid (components/infinite-results-grid.tsx) with
  its Load more / Retry footer; the page's ScrollViewer asks for the next
  page as it nears the bottom, like BrowsePage.
-->
<Page
    x:Class="Marquee.Windows.Views.DiscoverListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="Scroller" ViewChanged="OnViewChanged">
            <StackPanel Padding="28,20,28,28" Spacing="20">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="150" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="Uniform" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PosterItem">
                            <controls:PosterCard Item="{x:Bind}" FillsColumn="True" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Load more / Loading more… / Couldn't load more + Retry. -->
                <Grid
                    Height="60"
                    Visibility="{x:Bind ViewModel.ShowsLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoadingPage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingPage, Mode=OneWay}" Width="20" Height="20" />
                        <TextBlock
                            Text="Loading more…"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasPageError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Text="Couldn't load more"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PageError, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            VerticalAlignment="Center" />
                        <Button Content="Retry" Command="{x:Bind ViewModel.RetryPageCommand}" />
                    </StackPanel>
                    <Button
                        Content="Load more"
                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                        Visibility="{x:Bind ViewModel.ShowsLoadMoreButton, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading: only until the first answer of a reset. -->
        <StackPanel
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="36" Height="36" />
            <TextBlock
                Text="{x:Bind ViewModel.LoadingLabel, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Error, when there are no cards to keep. -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button Content="Try again" Command="{x:Bind ViewModel.ResetCommand}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- TMDb isn't configured on the server (api-v1.md deviation 7). -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsTmdbMissing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Connect TMDb to start browsing" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.TmdbMissingMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button
                Content="Open Settings"
                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                Visibility="{x:Bind ViewModel.CanOpenSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Page 1 came back empty. -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Nothing here right now" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
