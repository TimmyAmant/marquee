<?xml version="1.0" encoding="utf-8"?>
<!--
  app/discover/discover-view.tsx: the Movies and Series grids. A "Because
  you watched" rail (bleeding off the right edge like Discover's, with the
  same ‹ › arrows in its header), the
  filter bar, then the poster grid with its Load more / Retry footer. The
  page's ScrollViewer asks for the next page as it nears the bottom.
-->
<Page
    x:Class="Marquee.Windows.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="Scroller" ViewChanged="OnViewChanged">
            <StackPanel Padding="28,20,0,28" Spacing="20">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />

                <!-- "Because you watched …" (no genre or year filter, Plex history only). -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasBecauseYouWatched, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,28,0" MinHeight="28" ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind ViewModel.BecauseYouWatched.Title, Mode=OneWay}"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <controls:RailArrows Grid.Column="1" Target="{x:Bind BecauseYouWatchedRail}" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer
                        x:Name="BecauseYouWatchedRail"
                        HorizontalScrollMode="Enabled"
                        controls:WheelScroll.PassToPage="True"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.BecauseYouWatched.Posters, Mode=OneWay}" Margin="0,0,28,8">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="14" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:PosterItem">
                                    <controls:PosterCard Item="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!-- The filter bar keeps the 28px gutter; it scrolls sideways in a narrow window. -->
                <ScrollViewer
                    HorizontalScrollMode="Enabled"
                    controls:WheelScroll.PassToPage="True"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    Margin="0,0,28,0"
                    Visibility="{x:Bind ViewModel.IsTmdbMissing, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.SortOptions}"
                            SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                            AutomationProperties.Name="Sort"
                            VerticalAlignment="Center" />
                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.GenreOptions, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.GenreIndex, Mode=TwoWay}"
                            AutomationProperties.Name="Genre"
                            VerticalAlignment="Center" />
                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.YearOptions}"
                            SelectedIndex="{x:Bind ViewModel.YearIndex, Mode=TwoWay}"
                            AutomationProperties.Name="Year"
                            VerticalAlignment="Center" />
                        <Button
                            Content="{x:Bind ViewModel.NetworkChipLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ClearNetworkCommand}"
                            Visibility="{x:Bind ViewModel.HasNetworkChip, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="Clear the network filter"
                            VerticalAlignment="Center" />
                        <Button
                            Content="{x:Bind ViewModel.HideOwnedLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleHideOwnedCommand}"
                            VerticalAlignment="Center" />
                        <Button
                            Content="{x:Bind ViewModel.SurpriseLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SurpriseCommand}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SurpriseError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasSurpriseError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            VerticalAlignment="Center" />
                        <controls:StatusColorKey />
                    </StackPanel>
                </ScrollViewer>

                <!-- infinite-results-grid.tsx -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}" Margin="0,0,28,0">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="150" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="Uniform" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PosterItem">
                            <controls:PosterCard Item="{x:Bind}" FillsColumn="True" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowsInlineError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,28,0" />

                <!-- Load more / Loading more… / Couldn't load more + Retry. -->
                <Grid
                    Height="60"
                    Margin="0,0,28,0"
                    Visibility="{x:Bind ViewModel.ShowsLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoadingPage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingPage, Mode=OneWay}" Width="20" Height="20" />
                        <TextBlock
                            Text="Loading more…"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasPageError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Text="Couldn't load more"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PageError, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            VerticalAlignment="Center" />
                        <Button Content="Retry" Command="{x:Bind ViewModel.RetryPageCommand}" />
                    </StackPanel>
                    <Button
                        Content="Load more"
                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                        Visibility="{x:Bind ViewModel.ShowsLoadMoreButton, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading: only until the first answer of a reset. -->
        <StackPanel
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="36" Height="36" />
            <TextBlock
                Text="{x:Bind ViewModel.LoadingLabel, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Error, when there are no cards to keep. -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button Content="Try again" Command="{x:Bind ViewModel.ResetCommand}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- TMDb isn't configured on the server (api-v1.md deviation 7). -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsTmdbMissing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Connect TMDb to start browsing" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.TmdbMissingMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button
                Content="Open Settings"
                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                Visibility="{x:Bind ViewModel.CanOpenSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Page 1 came back empty. -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Nothing left here" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="Try a different genre or year, or turn off &quot;Hide titles you already track&quot;."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
