                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <!-- 0.53+: IMDb / Rotten Tomatoes / Metacritic, with an OMDb key on the server. -->
                                <TextBlock
                                    Text="{x:Bind ViewModel.RatingsLine, Mode=OneWay}"
