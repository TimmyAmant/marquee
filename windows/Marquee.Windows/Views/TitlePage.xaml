                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="2" />

                                <!--
                                  components/external-links.tsx: "▶ Trailer", then the server's
                                  ordered row. A rail like the others: when it overflows, its
                                  arrows sit at the right end.
                                -->
                                <Grid
                                    ColumnSpacing="8"
                                    Visibility="{x:Bind ViewModel.HasLinks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer x:Name="LinksRail" controls:RailScroll.IsRail="True">
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Links, Mode=OneWay}" Margin="0,0,0,6">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LinkItem">
                                                    <Button Content="{x:Bind Label}" Command="{x:Bind Open}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                    <controls:RailArrows Grid.Column="1" Target="{x:Bind LinksRail}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                </Grid>

                                <HyperlinkButton
                                    x:Uid="Title_OpenInBrowser"
                                    Command="{x:Bind ViewModel.OpenInBrowserCommand}"
                                    Visibility="{x:Bind ViewModel.CanOpenInBrowser, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Padding="0,4" />
                            </StackPanel>
                        </Grid>

                        <!-- components/season-episode-list.tsx -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasSeasons, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Uid="Title_EpisodesHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
