<?xml version="1.0" encoding="utf-8"?>
<!--
  app/title/[type]/[id]/page.tsx + components/title-hero.tsx. The backdrop
  runs across the top, as tall as the window allows (TitlePage.xaml.cs); the
  poster and the main column (name, meta line,
  status badge and actions, overview, credits, keywords, links) overlap its
  lower edge, with the facts and file-details cards in a rail on the right.
  Below: the Episodes accordion (TV), the Cast rail, the franchise grid,
  the studio chips and "More like this"; each rail has shelf.tsx's ‹ ›
  arrows at the right end of its header (flush, as the column is padded).

  Everything binds to TitleViewModel's derived properties; the whole body
  is collapsed until the detail has loaded, so nothing binds through a
  null detail while the loading page (the same layout, as placeholders)
  shows.
-->
<Page
    x:Class="Marquee.Windows.Views.TitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="PosterTemplate" x:DataType="vm:PosterItem">
            <controls:PosterCard Item="{x:Bind}" />
        </DataTemplate>
        <!--
          The admin's "Advanced" under Add / Add to 4K (0.43+): the server,
          then its quality profile, root folder, tags and (TV) series type.
          The same template as the review queue's (RequestsPage.xaml).
        -->
        <DataTemplate x:Key="AddOverridesTemplate" x:DataType="vm:AddOverridesViewModel">
            <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Width="16" Height="16" />
                    <TextBlock
                        x:Uid="Title_CheckingServers"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="6" Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{x:Bind Error, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                    <Button x:Uid="Title_AdvancedRetry" Command="{x:Bind LoadCommand}" />
                </StackPanel>
                <TextBlock
                    Text="{x:Bind NoServersMessage, Mode=OneWay}"
                    Visibility="{x:Bind ShowsNoServers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <StackPanel Spacing="10" Visibility="{x:Bind ShowsPickers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox
                        x:Uid="Title_AdvancedServer"
                        MinWidth="260"
                        ItemsSource="{x:Bind ServerNames, Mode=OneWay}"
                        SelectedIndex="{x:Bind ServerIndex, Mode=TwoWay}" />
                    <TextBlock
                        x:Uid="Title_ServerDown"
                        Visibility="{x:Bind ServerIsDown, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Uid="Title_AdvancedQualityProfile"
                        MinWidth="260"
                        ItemsSource="{x:Bind QualityProfiles, Mode=OneWay}"
                        SelectedIndex="{x:Bind QualityProfileIndex, Mode=TwoWay}" />
                    <ComboBox
                        x:Uid="Title_AdvancedRootFolder"
                        MinWidth="260"
                        ItemsSource="{x:Bind RootFolders, Mode=OneWay}"
                        SelectedIndex="{x:Bind RootFolderIndex, Mode=TwoWay}" />
                    <StackPanel Spacing="6" Visibility="{x:Bind HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Uid="Title_AdvancedTags" Style="{StaticResource FieldLabel}" />
                        <ItemsRepeater ItemsSource="{x:Bind Tags, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="140" MinColumnSpacing="12" MinRowSpacing="4" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:TagChoice">
                                    <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                    <ComboBox
                        x:Uid="Title_AdvancedSeriesType"
                        MinWidth="260"
                        ItemsSource="{x:Bind SeriesTypes}"
                        SelectedIndex="{x:Bind SeriesTypeIndex, Mode=TwoWay}"
                        Visibility="{x:Bind ShowsSeriesType, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        x:Uid="Title_ServerResetHint"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FactRowTemplate" x:DataType="vm:FactRow">
            <Grid ColumnSpacing="10" MinHeight="34" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{x:Bind Label}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Value}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    TextAlignment="Right"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsTextSelectionEnabled="True" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CellTemplate" x:DataType="vm:FactRow">
            <StackPanel Spacing="2" Margin="0,0,0,10">
                <TextBlock
                    Text="{x:Bind Label}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Text="{x:Bind Value}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    IsTextSelectionEnabled="True" />
            </StackPanel>
        </DataTemplate>
        <!--
          The action row (components/title-hero.tsx, 0.54+): every capsule is
          32 tall and centred on the row, so the badge, Add / Request, Play,
          Report, Share and the overflow button line up.
        -->
        <Style x:Key="TitlePillButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TitleAccentPillButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TitlePillBorder" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer Visibility="{x:Bind ViewModel.HasDetail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Padding="0,0,0,48">
                <!--
                  .backdrop: full-bleed artwork, as tall as min(70% of the
                  window's height, 16:9 of its width) (the code-behind sizes
                  it), under soft fades into the page: a light veil over all
                  of it so a bright image reads like a dark one, a wash from
                  the left behind the text, a scrim at the top and a long
                  fall into the page at the bottom.
                -->
                <!--
                  A quiet surface under the artwork, the same one the loading
                  page shows, so the fades never lie over the bare window
                  while the image is on its way; the image fades in over it
                  once it has decoded (OnBackdropOpened).
                -->
                <Grid x:Name="BackdropHost" Height="300" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                    <Image
                        x:Name="BackdropImage"
                        Source="{x:Bind ViewModel.Backdrop, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Opacity="0"
                        ImageOpened="OnBackdropOpened">
                        <Image.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.45" />
                        </Image.OpacityTransition>
                    </Image>
                    <Rectangle Fill="{ThemeResource HeroVeilBrush}" />
                    <Rectangle Fill="{ThemeResource HeroSideFadeBrush}" />
                    <Rectangle Fill="{ThemeResource HeroTopFadeBrush}" />
                    <Rectangle Fill="{ThemeResource HeroBottomFadeBrush}" />
                </Grid>

                <!--
                  The poster and both columns start a little under halfway
                  down the backdrop (the code-behind keeps that as it grows);
                  the facts rail sits on the window's right edge however wide.
                -->
                <Grid x:Name="HeroColumns" Margin="28,-140,28,0" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="36">
                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- .tp-poster -->
                            <Grid
                                Grid.Column="0"
                                Width="200"
                                Height="300"
                                VerticalAlignment="Top"
                                CornerRadius="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Image Source="{x:Bind ViewModel.Poster, Mode=OneWay}" Stretch="UniformToFill" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasPoster, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="16" />
                            </Grid>

                            <!-- The main column. -->
                            <StackPanel Grid.Column="1" Spacing="14" Margin="0,120,0,0" MaxWidth="860" HorizontalAlignment="Left">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                                    Style="{StaticResource TitleLargeTextBlockStyle}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True" />

                                <!-- .tp-meta, then the favorite star. -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.MetaLine, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasMetaLine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                                        Padding="8,4"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{x:Bind ViewModel.FavoriteGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock x:Uid="Title_Favorite" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- .tp-status: the library badge and the actions this viewer may take. -->
                                <StackPanel Spacing="8">
                                    <!--
                                      One row on a shared centre line: the main action first (Play,
                                      Request / Add with "Advanced" as its chevron), the library badge,
                                      the everyday extras, then "…" for the rarely used tools.
                                    -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- components/play-button.tsx (0.53+): Play on Plex / Jellyfin / Emby, one per server that has it. -->
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.PlayItems, Mode=OneWay}" VerticalAlignment="Center">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PlayItem">
                                                    <Button Style="{StaticResource TitleAccentPillButton}" Command="{x:Bind Open}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                            <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <Button
                                            Content="{x:Bind ViewModel.RequestLabel, Mode=OneWay}"
                                            Click="OnRequestClick"
                                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.CanRequest, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource TitleAccentPillButton}" />
                                        <!-- Add, with "Advanced" (0.43+) as a chevron joined to its right; a plain pill on an older server. -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="1"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.CanAdd, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <Button
                                                Content="{x:Bind ViewModel.AddLabel, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.AddCommand}"
                                                Visibility="{x:Bind ViewModel.AddAdvanced.IsVisible, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}"
                                                Style="{StaticResource TitleAccentPillButton}" />
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="1"
                                                Visibility="{x:Bind ViewModel.AddAdvanced.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <Button
                                                    Content="{x:Bind ViewModel.AddLabel, Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.AddCommand}"
                                                    CornerRadius="16,0,0,16"
                                                    Style="{StaticResource TitleAccentPillButton}" />
                                                <Button
                                                    x:Uid="Title_AdvancedToggle"
                                                    Click="OnAdvancedToggleClick"
                                                    CornerRadius="0,16,16,0"
                                                    Padding="10,0"
                                                    Style="{StaticResource TitleAccentPillButton}">
                                                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button
                                            x:Uid="Title_RequestMoreSeasons"
                                            Click="OnRequestClick"
                                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.ShowsRequestMoreSeasons, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource TitlePillButton}" />
                                        <controls:TonePill Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}" Tone="{x:Bind ViewModel.StatusTone, Mode=OneWay}" />
                                        <Border
                                            Visibility="{x:Bind ViewModel.ShowsRequested, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource TitlePillBorder}"
                                            Background="{ThemeResource InfoBadgeBackgroundBrush}">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.RequestedLine, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource InfoBadgeForegroundBrush}" />
                                        </Border>
                                        <!-- components/title-hero.tsx (0.46+, reviewers): Sonarr/Radarr hasn't found the approved request. -->
                                        <Border
                                            Visibility="{x:Bind ViewModel.ShowsNotFound, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource TitlePillBorder}"
                                            BorderThickness="1"
                                            Background="{ThemeResource MissingBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource MissingBadgeForegroundBrush}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.NotFoundTooltip, Mode=OneWay}">
                                            <TextBlock
                                                x:Uid="Title_CantFind"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource MissingBadgeForegroundBrush}" />
                                        </Border>
                                        <!-- components/open-in-arr.tsx (0.63+): the title's page on each Radarr/Sonarr that has it. -->
                                        <ItemsRepeater
                                            ItemsSource="{x:Bind ViewModel.ArrLinkItems, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HasArrLinks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            VerticalAlignment="Center">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ArrLinkItem">
                                                    <Button
                                                        Style="{StaticResource TitlePillButton}"
                                                        Command="{x:Bind Open}"
                                                        ToolTipService.ToolTip="{x:Bind Url}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Ellipse Width="8" Height="8" Fill="{x:Bind DotBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                                            <FontIcon Glyph="&#xE8A7;" FontSize="11" Opacity="0.7" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <!-- components/add-to-library-button.tsx (0.41+): a member sees why Request is gone. -->
                                        <Border
                                            Visibility="{x:Bind ViewModel.ShowsBlockedPill, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource TitlePillBorder}"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.BlockedLine, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap"
                                                MaxWidth="420" />
                                        </Border>
                                        <!-- components/report-problem-button.tsx (0.38+): the pill once reported, then the button. -->
                                        <Border
                                            Visibility="{x:Bind ViewModel.ShowsProblemReported, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource TitlePillBorder}"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <TextBlock
                                                x:Uid="Title_ProblemReported"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <Button
                                            Content="{x:Bind ViewModel.ReportButtonLabel, Mode=OneWay}"
                                            Click="OnReportProblemClick"
                                            Visibility="{x:Bind ViewModel.CanReport, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource TitlePillButton}"
                                            x:Uid="Title_ReportButton" />
                                        <!-- components/share-button.tsx (0.45.1+): send it to someone here, or share a link. -->
                                        <Button
                                            Click="OnShareClick"
                                            Visibility="{x:Bind ViewModel.CanShare, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource TitlePillButton}"
                                            x:Uid="Title_ShareButton">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72D;" FontSize="14" />
                                                <TextBlock x:Uid="Title_ShareLabel" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <!-- components/block-requests-button.tsx (0.41+): Unblock stays in the row while the title is blocked. -->
                                        <Button
                                            Content="{x:Bind ViewModel.UnblockLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.UnblockCommand}"
                                            Visibility="{x:Bind ViewModel.CanUnblock, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource TitlePillButton}" />
                                        <Border
                                            Visibility="{x:Bind ViewModel.ShowsBlockedByKeyword, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource TitlePillBorder}"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            x:Uid="Title_BlockedByKeyword">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.BlockedKeywordLine, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Border>
                                        <!-- components/title-more-menu.tsx: Search now, Stop / Start monitoring, Fix ID and Block requests. -->
                                        <Button
                                            x:Uid="Title_MoreActions"
                                            Width="32"
                                            Padding="0"
                                            Style="{StaticResource TitlePillButton}"
                                            Visibility="{x:Bind ViewModel.HasMoreActions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                    <MenuFlyoutItem
                                                        Text="{x:Bind ViewModel.SearchLabel, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.SearchNowCommand}"
                                                        Visibility="{x:Bind ViewModel.HasTracking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    <MenuFlyoutItem
                                                        Text="{x:Bind ViewModel.MonitorLabel, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.ToggleMonitorCommand}"
                                                        Visibility="{x:Bind ViewModel.HasTracking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    <MenuFlyoutItem
                                                        Text="{x:Bind ViewModel.RemoveFromArrLabel, Mode=OneWay}"
                                                        Click="OnRemoveFromArrClick"
                                                        Visibility="{x:Bind ViewModel.CanRemoveFromArr, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    <MenuFlyoutItem
                                                        Text="{x:Bind ViewModel.RemoveFromArrFourKLabel, Mode=OneWay}"
                                                        Click="OnRemoveFromArrFourKClick"
                                                        Visibility="{x:Bind ViewModel.CanRemoveFromArrFourK, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    <MenuFlyoutItem
                                                        x:Uid="Title_FixId"
                                                        Click="OnFixIdClick"
                                                        Visibility="{x:Bind ViewModel.CanRelink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    <MenuFlyoutItem
                                                        x:Uid="Title_BlockRequests"
                                                        Click="OnBlockRequestsClick"
                                                        Visibility="{x:Bind ViewModel.CanBlock, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <HyperlinkButton
                                            Content="{x:Bind ViewModel.ArrSetupLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.OpenSettingsCommand}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.NeedsArrSetup, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <!-- 0.43+: which server and settings "Add to Radarr/Sonarr" uses, opened by the chevron on Add. -->
                                    <StackPanel Visibility="{x:Bind ViewModel.CanAdd, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Border
                                            MaxWidth="600"
                                            HorizontalAlignment="Left"
                                            Padding="14,12"
                                            CornerRadius="12"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            Visibility="{x:Bind ViewModel.AddAdvanced.IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <ContentControl
                                                Content="{x:Bind ViewModel.AddAdvanced}"
                                                ContentTemplate="{StaticResource AddOverridesTemplate}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" />
                                        </Border>
                                    </StackPanel>
                                    <!-- components/fourk-controls.tsx: the 4K Radarr/Sonarr's copy (0.37+). -->
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.HasFourKRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Border
                                            Visibility="{x:Bind ViewModel.HasFourKStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Padding="12,4"
                                            CornerRadius="14"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource MarqueeAccentBrush}"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.FourKStatusLabel, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource MarqueeAccentBrush}" />
                                        </Border>
                                        <Border
                                            Visibility="{x:Bind ViewModel.ShowsFourKRequested, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Padding="12,4"
                                            CornerRadius="14"
                                            Background="{ThemeResource InfoBadgeBackgroundBrush}"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                x:Uid="Title_FourKRequested"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource InfoBadgeForegroundBrush}" />
                                        </Border>
                                        <Button
                                            Content="{x:Bind ViewModel.RequestFourKLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.RequestFourKCommand}"
                                            Visibility="{x:Bind ViewModel.CanRequestFourK, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- Add to 4K, with its own "Advanced" chevron joined to its right like the main Add; a plain button on an older server. -->
                                        <StackPanel
                                            Orientation="Horizontal"
