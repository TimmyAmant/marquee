                                    TextWrapping="Wrap" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}" ItemTemplate="{StaticResource FactRowTemplate}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="0" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <StackPanel
                                    Spacing="8"
                                    Margin="0,12,0,0"
                                    Visibility="{x:Bind ViewModel.HasProviders, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock
                                            x:Uid="Title_StreamingOn"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            CharacterSpacing="60"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <!-- 0.53+: the country they're for. -->
                                        <TextBlock
                                            Text="{x:Bind ViewModel.StreamingRegion, Mode=OneWay}"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="36" MinItemHeight="36" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="None" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProviderItem">
                                                <Border
                                                    Width="36"
                                                    Height="36"
                                                    CornerRadius="8"
                                                    Background="White"
                                                    ToolTipService.ToolTip="{x:Bind Name}">
                                                    <Image Source="{x:Bind Logo}" Stretch="Uniform" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- components/file-details-section.tsx -->
                        <Border
                            Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="Title_FileDetails" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasFilePath, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        x:Uid="Title_Location"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        CharacterSpacing="60"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind ViewModel.FilePath, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            FontFamily="Consolas"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            x:Uid="Title_CopyPath"
                                            Click="OnCopyPathClick"
                                            Padding="8,4"
                                            VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.FileCells, Mode=OneWay}" ItemTemplate="{StaticResource CellTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="120" MinColumnSpacing="12" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="28,44,28,0" Spacing="36">
                    <!-- components/franchise-row.tsx -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasFranchise, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.FranchiseTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Button
                                Content="{x:Bind ViewModel.AddAllLabel, Mode=OneWay}"
                                Click="OnAddAllClick"
                                Visibility="{x:Bind ViewModel.ShowsAddAll, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                IsEnabled="{x:Bind ViewModel.CanAddAll, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.AddAllResult, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasAddAllResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <Button
                                Content="{x:Bind ViewModel.RequestAllLabel, Mode=OneWay}"
                                Click="OnRequestAllClick"
                                Visibility="{x:Bind ViewModel.ShowsRequestAll, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                IsEnabled="{x:Bind ViewModel.CanRequestAll, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.RequestAllResult, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasRequestAllResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                MaxWidth="520"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.FranchiseItems, Mode=OneWay}" ItemTemplate="{StaticResource PosterTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="150" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasStudios, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid MinHeight="28">
                            <TextBlock x:Uid="Title_StudioHeader" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <controls:RailArrows Target="{x:Bind StudiosRail}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer
                            x:Name="StudiosRail"
                            controls:RailScroll.IsRail="True">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Studios, Mode=OneWay}" Margin="0,0,0,8">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChipItem">
                                        <controls:StudioChip Item="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasSimilar, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid MinHeight="28">
                            <TextBlock x:Uid="Title_MoreLikeThis" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <controls:RailArrows Target="{x:Bind SimilarRail}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer
                            x:Name="SimilarRail"
                            controls:RailScroll.IsRail="True">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Similar, Mode=OneWay}" ItemTemplate="{StaticResource PosterTemplate}" Margin="0,0,0,8">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="14" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--
          Loading, until the first answer: the page's own shape, not a
          spinner over the bare window. The same backdrop surface and fades,
          the poster frame, the title, meta line, action pills and overview
          as bars, and the facts card, sized and placed by the code-behind
          exactly like the loaded page (OnPageSizeChanged).
        -->
        <Grid
            x:Name="LoadingSkeleton"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid x:Name="SkeletonBackdrop" Height="300" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                    <Rectangle Fill="{ThemeResource HeroVeilBrush}" />
                    <Rectangle Fill="{ThemeResource HeroSideFadeBrush}" />
                    <Rectangle Fill="{ThemeResource HeroTopFadeBrush}" />
                    <Rectangle Fill="{ThemeResource HeroBottomFadeBrush}" />
                </Grid>

                <Grid x:Name="SkeletonColumns" Margin="28,-140,28,0" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" ColumnSpacing="28" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="200"
                            Height="300"
                            VerticalAlignment="Top"
                            CornerRadius="12"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" />
                        <StackPanel Grid.Column="1" Margin="0,120,0,0" MaxWidth="860" HorizontalAlignment="Stretch">
                            <Border Height="40" Width="360" HorizontalAlignment="Left" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            <Border Height="14" Width="240" Margin="0,18,0,0" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,18,0,0">
                                <Border Height="32" Width="128" CornerRadius="16" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                <Border Height="32" Width="96" CornerRadius="16" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                <Border Height="32" Width="32" CornerRadius="16" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Height="16" Width="96" Margin="0,30,0,0" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            <Border Height="12" Margin="0,14,0,0" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            <Border Height="12" Margin="0,11,16,0" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            <Border Height="12" Margin="0,11,40,0" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            <Border Height="12" Width="260" Margin="0,11,0,0" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            <!-- For screen readers; the bars say it to everyone else. -->
                            <TextBlock x:Uid="Title_Loading" Opacity="0" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Grid.Column="1"
                        Margin="0,120,0,0"
                        VerticalAlignment="Top"
                        Padding="16,8,16,14"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel>
                            <Grid Height="44">
                                <Border Height="18" Width="88" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            </Grid>
                            <Grid Height="34" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                <Border Height="10" Width="64" HorizontalAlignment="Left" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                <Border Height="10" Width="56" HorizontalAlignment="Right" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            </Grid>
                            <Grid Height="34" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                <Border Height="10" Width="96" HorizontalAlignment="Left" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                <Border Height="10" Width="80" HorizontalAlignment="Right" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            </Grid>
                            <Grid Height="34" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                <Border Height="10" Width="80" HorizontalAlignment="Left" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                <Border Height="10" Width="96" HorizontalAlignment="Right" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            </Grid>
                            <Grid Height="34" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                <Border Height="10" Width="112" HorizontalAlignment="Left" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                <Border Height="10" Width="48" HorizontalAlignment="Right" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            </Grid>
                            <Grid Height="34" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                <Border Height="10" Width="56" HorizontalAlignment="Left" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                <Border Height="10" Width="80" HorizontalAlignment="Right" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            </Grid>
                            <Grid Height="34" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                <Border Height="10" Width="96" HorizontalAlignment="Left" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                <Border Height="10" Width="64" HorizontalAlignment="Right" CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Error, when there is nothing else to show. -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock x:Uid="Title_LoadFailed" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button x:Uid="Title_Retry" Command="{x:Bind ViewModel.LoadCommand}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
