                                        <DataTemplate x:DataType="vm:PersonItem">
                                            <controls:PersonCard Item="{x:Bind}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <!-- The right rail: .facts, then "File details" for an owned title. -->
                    <StackPanel Grid.Column="1" Spacing="16" Margin="0,120,0,0">
