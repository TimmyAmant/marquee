                                                    Width="24"
                                                    Height="24"
                                                    HorizontalAlignment="Left" />
                                                <TextBlock
                                                    Text="{x:Bind EpisodeError, Mode=OneWay}"
                                                    Visibility="{x:Bind HasEpisodeError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    x:Uid="Title_NoEpisodeData"
                                                    Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ItemsRepeater ItemsSource="{x:Bind Episodes, Mode=OneWay}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Orientation="Vertical" Spacing="14" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:EpisodeItem">
                                                            <Grid ColumnSpacing="14">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid
                                                                    Grid.Column="0"
                                                                    Width="128"
                                                                    Height="72"
                                                                    VerticalAlignment="Top"
                                                                    CornerRadius="6"
                                                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                                    <Image Source="{x:Bind Still}" Stretch="UniformToFill" />
                                                                </Grid>
                                                                <StackPanel Grid.Column="1" Spacing="3">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                                        <controls:TonePill Grid.Column="1" Text="{x:Bind FileLabel}" Tone="{x:Bind FileTone}" VerticalAlignment="Top" />
                                                                    </Grid>
                                                                    <TextBlock
                                                                        Text="{x:Bind MetaLine}"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                                    <TextBlock
                                                                        Text="{x:Bind Overview}"
                                                                        Visibility="{x:Bind Overview, Converter={StaticResource StringToVisibility}}"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Cast rail. -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasCast, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid MinHeight="28">
                                <TextBlock x:Uid="Title_CastHeader" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                <controls:RailArrows Target="{x:Bind CastRail}" HorizontalAlignment="Right" VerticalAlignment="Center" />
