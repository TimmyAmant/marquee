                                </StackPanel>

                                <TextBlock
                                    Text="{x:Bind ViewModel.Tagline, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasTagline, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
