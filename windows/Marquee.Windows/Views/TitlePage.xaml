<?xml version="1.0" encoding="utf-8"?>
<!--
  app/title/[type]/[id]/page.tsx + components/title-hero.tsx. The backdrop
  runs across the top; the poster and the main column (name, meta line,
  status badge and actions, overview, credits, keywords, links) overlap its
  lower edge, with the facts and file-details cards in a rail on the right.
  Below: the Episodes accordion (TV), the Cast rail, the franchise grid,
  the studio chips and "More like this".

  Everything binds to TitleViewModel's derived properties; the whole body
  is collapsed until the detail has loaded, so nothing binds through a
  null detail while the spinner shows.
-->
<Page
    x:Class="Marquee.Windows.Views.TitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="PosterTemplate" x:DataType="vm:PosterItem">
            <controls:PosterCard Item="{x:Bind}" />
        </DataTemplate>
        <!--
          The admin's "Advanced" under Add / Add to 4K (0.43+): the server,
          then its quality profile, root folder, tags and (TV) series type.
          The same template as the review queue's (RequestsPage.xaml).
        -->
        <DataTemplate x:Key="AddOverridesTemplate" x:DataType="vm:AddOverridesViewModel">
            <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Width="16" Height="16" />
                    <TextBlock
                        Text="Checking your Sonarr and Radarr servers…"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="6" Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{x:Bind Error, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                    <Button Content="Try again" Command="{x:Bind LoadCommand}" />
                </StackPanel>
                <TextBlock
                    Text="{x:Bind NoServersMessage, Mode=OneWay}"
                    Visibility="{x:Bind ShowsNoServers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <StackPanel Spacing="10" Visibility="{x:Bind ShowsPickers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox
                        Header="Server"
                        MinWidth="260"
                        ItemsSource="{x:Bind ServerNames, Mode=OneWay}"
                        SelectedIndex="{x:Bind ServerIndex, Mode=TwoWay}" />
                    <TextBlock
                        Text="This server isn't responding right now, so its lists can't be shown. Its saved settings will be used."
                        Visibility="{x:Bind ServerIsDown, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        Header="Quality profile"
                        MinWidth="260"
                        ItemsSource="{x:Bind QualityProfiles, Mode=OneWay}"
                        SelectedIndex="{x:Bind QualityProfileIndex, Mode=TwoWay}" />
                    <ComboBox
                        Header="Root folder"
                        MinWidth="260"
                        ItemsSource="{x:Bind RootFolders, Mode=OneWay}"
                        SelectedIndex="{x:Bind RootFolderIndex, Mode=TwoWay}" />
                    <StackPanel Spacing="6" Visibility="{x:Bind HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" />
                        <ItemsRepeater ItemsSource="{x:Bind Tags, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="140" MinColumnSpacing="12" MinRowSpacing="4" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:TagChoice">
                                    <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                    <ComboBox
                        Header="Series type"
                        MinWidth="260"
                        ItemsSource="{x:Bind SeriesTypes}"
                        SelectedIndex="{x:Bind SeriesTypeIndex, Mode=TwoWay}"
                        Visibility="{x:Bind ShowsSeriesType, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Text="Picking another server resets the rest to that server's defaults."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FactRowTemplate" x:DataType="vm:FactRow">
            <Grid ColumnSpacing="10" MinHeight="34" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{x:Bind Label}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Value}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    TextAlignment="Right"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsTextSelectionEnabled="True" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CellTemplate" x:DataType="vm:FactRow">
            <StackPanel Spacing="2" Margin="0,0,0,10">
                <TextBlock
                    Text="{x:Bind Label}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Text="{x:Bind Value}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    IsTextSelectionEnabled="True" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer Visibility="{x:Bind ViewModel.HasDetail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Padding="0,0,0,48">
                <!-- .backdrop: full-bleed artwork faded into the page at the bottom. -->
                <Grid Height="300">
                    <Image
                        Source="{x:Bind ViewModel.Backdrop, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Opacity="0.55" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.3" />
                                <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- The poster and both columns start on the backdrop's lower third. -->
                <Grid Margin="28,-140,28,0" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="36">
                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- .tp-poster -->
                            <Grid
                                Grid.Column="0"
                                Width="200"
                                Height="300"
                                VerticalAlignment="Top"
                                CornerRadius="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Image Source="{x:Bind ViewModel.Poster, Mode=OneWay}" Stretch="UniformToFill" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasPoster, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="16" />
                            </Grid>

                            <!-- The main column. -->
                            <StackPanel Grid.Column="1" Spacing="14" Margin="0,120,0,0">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                                    Style="{StaticResource TitleLargeTextBlockStyle}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True" />

                                <!-- .tp-meta, then the favorite star. -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.MetaLine, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasMetaLine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                                        Padding="8,4"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{x:Bind ViewModel.FavoriteGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Favorite" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- .tp-status: the library badge and the actions this viewer may take. -->
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:TonePill Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}" Tone="{x:Bind ViewModel.StatusTone, Mode=OneWay}" />
                                        <Border
                                            Visibility="{x:Bind ViewModel.ShowsRequested, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Padding="12,4"
                                            CornerRadius="14"
                                            Background="{ThemeResource TrackedBadgeBackgroundBrush}"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.RequestedLine, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TrackedBadgeForegroundBrush}" />
                                        </Border>
                                        <Button
                                            Content="{x:Bind ViewModel.RequestLabel, Mode=OneWay}"
                                            Click="OnRequestClick"
                                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.CanRequest, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            Content="Request more seasons"
                                            Click="OnRequestClick"
                                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.ShowsRequestMoreSeasons, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- components/add-to-library-button.tsx (0.41+): a member sees why Request is gone. -->
                                        <Border
                                            Visibility="{x:Bind ViewModel.ShowsBlockedPill, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Padding="12,4"
                                            CornerRadius="14"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.BlockedLine, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap"
                                                MaxWidth="420" />
                                        </Border>
                                        <Button
                                            Content="{x:Bind ViewModel.AddLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.AddCommand}"
                                            Visibility="{x:Bind ViewModel.CanAdd, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            Content="{x:Bind ViewModel.SearchLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.SearchNowCommand}"
                                            Visibility="{x:Bind ViewModel.HasTracking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Button
                                            Content="{x:Bind ViewModel.MonitorLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleMonitorCommand}"
                                            Visibility="{x:Bind ViewModel.HasTracking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Button
                                            Content="Fix ID"
                                            Click="OnFixIdClick"
                                            Visibility="{x:Bind ViewModel.CanRelink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            ToolTipService.ToolTip="Wrong match? Point this title at the right id." />
                                        <!-- components/block-requests-button.tsx (0.41+): the admin's request blocklist. -->
                                        <Button
                                            Content="Block requests"
                                            Click="OnBlockRequestsClick"
                                            Visibility="{x:Bind ViewModel.CanBlock, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            ToolTipService.ToolTip="Nobody can request this title; you can still add it yourself." />
                                        <Button
                                            Content="{x:Bind ViewModel.UnblockLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.UnblockCommand}"
                                            Visibility="{x:Bind ViewModel.CanUnblock, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Border
                                            Visibility="{x:Bind ViewModel.ShowsBlockedByKeyword, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Padding="12,4"
                                            CornerRadius="14"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Remove the keyword under Settings › Request blocklist to allow requests again.">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.BlockedKeywordLine, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Border>
                                        <!-- components/report-problem-button.tsx (0.38+): the pill once reported, then the button. -->
                                        <Border
                                            Visibility="{x:Bind ViewModel.ShowsProblemReported, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Padding="12,4"
                                            CornerRadius="14"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="Problem reported"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <Button
                                            Content="{x:Bind ViewModel.ReportButtonLabel, Mode=OneWay}"
                                            Click="OnReportProblemClick"
                                            Visibility="{x:Bind ViewModel.CanReport, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            ToolTipService.ToolTip="Bad video or audio, missing subtitles, won't play: the admin is told." />
                                        <HyperlinkButton
                                            Content="{x:Bind ViewModel.ArrSetupLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.OpenSettingsCommand}"
                                            Visibility="{x:Bind ViewModel.NeedsArrSetup, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <!-- 0.43+: which server and settings "Add to Radarr/Sonarr" uses; hidden on an older server. -->
                                    <StackPanel Visibility="{x:Bind ViewModel.CanAdd, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Expander
                                            Header="Advanced"
                                            MaxWidth="600"
                                            IsExpanded="{x:Bind ViewModel.AddAdvanced.IsExpanded, Mode=TwoWay}"
                                            Visibility="{x:Bind ViewModel.AddAdvanced.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                            <ContentControl
                                                Content="{x:Bind ViewModel.AddAdvanced}"
                                                ContentTemplate="{StaticResource AddOverridesTemplate}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" />
                                        </Expander>
                                    </StackPanel>
                                    <!-- components/fourk-controls.tsx: the 4K Radarr/Sonarr's copy (0.37+). -->
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.HasFourKRow, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Border
                                            Visibility="{x:Bind ViewModel.HasFourKStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Padding="12,4"
                                            CornerRadius="14"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource MarqueeAccentBrush}"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.FourKStatusLabel, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource MarqueeAccentBrush}" />
                                        </Border>
                                        <Border
                                            Visibility="{x:Bind ViewModel.ShowsFourKRequested, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Padding="12,4"
                                            CornerRadius="14"
                                            Background="{ThemeResource TrackedBadgeBackgroundBrush}"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="4K requested"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TrackedBadgeForegroundBrush}" />
                                        </Border>
                                        <Button
                                            Content="{x:Bind ViewModel.RequestFourKLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.RequestFourKCommand}"
                                            Visibility="{x:Bind ViewModel.CanRequestFourK, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Button
                                            Content="{x:Bind ViewModel.AddFourKLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.AddFourKCommand}"
                                            Visibility="{x:Bind ViewModel.CanAddFourK, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <!-- 0.43+: which 4K server and settings "Add to 4K …" uses. -->
                                    <StackPanel Visibility="{x:Bind ViewModel.CanAddFourK, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Expander
                                            Header="Advanced (4K)"
                                            MaxWidth="600"
                                            IsExpanded="{x:Bind ViewModel.AddFourKAdvanced.IsExpanded, Mode=TwoWay}"
                                            Visibility="{x:Bind ViewModel.AddFourKAdvanced.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                            <ContentControl
                                                Content="{x:Bind ViewModel.AddFourKAdvanced}"
                                                ContentTemplate="{StaticResource AddOverridesTemplate}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" />
                                        </Expander>
                                    </StackPanel>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.FourKError, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasFourKError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.OtherRequestersLine, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasOtherRequesters, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.AddError, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasAddError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        TextWrapping="Wrap" />
                                    <InfoBar
                                        IsOpen="{x:Bind ViewModel.HasTrackingMessage, Mode=OneWay}"
                                        Message="{x:Bind ViewModel.TrackingMessage, Mode=OneWay}"
                                        Severity="{x:Bind ViewModel.TrackingSeverity, Mode=OneWay}"
                                        IsClosable="False" />
                                </StackPanel>

                                <TextBlock
                                    Text="{x:Bind ViewModel.Tagline, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasTagline, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    FontStyle="Italic"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />

                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasOverview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Overview" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Overview, Mode=OneWay}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>

                                <!-- .credits: name over role, three across. -->
                                <ItemsRepeater
                                    ItemsSource="{x:Bind ViewModel.Credits, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasCredits, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="160" MinColumnSpacing="16" MinRowSpacing="12" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FactRow">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Value}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <!-- .chips: keywords on one line, clipped. -->
                                <TextBlock
                                    Text="{x:Bind ViewModel.Keywords, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasKeywords, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />

                                <!-- components/external-links.tsx: "▶ Trailer", then the server's ordered row. -->
                                <ScrollViewer
                                    HorizontalScrollMode="Enabled"
                                    controls:WheelScroll.PassToPage="True"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    Visibility="{x:Bind ViewModel.HasLinks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Links, Mode=OneWay}" Margin="0,0,0,6">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LinkItem">
                                                <Button Content="{x:Bind Label}" Command="{x:Bind Open}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>

                                <HyperlinkButton
                                    Content="Open in browser"
                                    Command="{x:Bind ViewModel.OpenInBrowserCommand}"
                                    Visibility="{x:Bind ViewModel.CanOpenInBrowser, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Padding="0,4" />
                            </StackPanel>
                        </Grid>

                        <!-- components/season-episode-list.tsx -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasSeasons, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Episodes" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SeasonItem">
                                        <Expander
                                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                        <TextBlock
                                                            Text="{x:Bind DetailLine}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <controls:TonePill Grid.Column="1" Text="{x:Bind CompletenessLabel}" Tone="{x:Bind CompletenessTone}" />
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Spacing="12">
                                                <ProgressRing
                                                    IsActive="{x:Bind IsLoadingEpisodes, Mode=OneWay}"
                                                    Visibility="{x:Bind IsLoadingEpisodes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                    Width="24"
                                                    Height="24"
                                                    HorizontalAlignment="Left" />
                                                <TextBlock
                                                    Text="{x:Bind EpisodeError, Mode=OneWay}"
                                                    Visibility="{x:Bind HasEpisodeError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Text="No episode data for this season."
                                                    Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ItemsRepeater ItemsSource="{x:Bind Episodes, Mode=OneWay}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Orientation="Vertical" Spacing="14" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:EpisodeItem">
                                                            <Grid ColumnSpacing="14">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid
                                                                    Grid.Column="0"
                                                                    Width="128"
                                                                    Height="72"
                                                                    VerticalAlignment="Top"
                                                                    CornerRadius="6"
                                                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                                    <Image Source="{x:Bind Still}" Stretch="UniformToFill" />
                                                                </Grid>
                                                                <StackPanel Grid.Column="1" Spacing="3">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                                        <controls:TonePill Grid.Column="1" Text="{x:Bind FileLabel}" Tone="{x:Bind FileTone}" VerticalAlignment="Top" />
                                                                    </Grid>
                                                                    <TextBlock
                                                                        Text="{x:Bind MetaLine}"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                                    <TextBlock
                                                                        Text="{x:Bind Overview}"
                                                                        Visibility="{x:Bind Overview, Converter={StaticResource StringToVisibility}}"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Cast rail. -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasCast, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Cast" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ScrollViewer
                                HorizontalScrollMode="Enabled"
                                controls:WheelScroll.PassToPage="True"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Disabled">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cast, Mode=OneWay}" Margin="0,0,0,8">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="14" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PersonItem">
                                            <controls:PersonCard Item="{x:Bind}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <!-- The right rail: .facts, then "File details" for an owned title. -->
                    <StackPanel Grid.Column="1" Spacing="16" Margin="0,120,0,0">
                        <Border
                            Padding="16,8,16,14"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel>
                                <Grid Height="44" ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasRating, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind ViewModel.RatingLabel, Mode=OneWay}"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="TMDb user score"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}" ItemTemplate="{StaticResource FactRowTemplate}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="0" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <StackPanel
                                    Spacing="8"
                                    Margin="0,12,0,0"
                                    Visibility="{x:Bind ViewModel.HasProviders, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        Text="CURRENTLY STREAMING ON"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        CharacterSpacing="60"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="36" MinItemHeight="36" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="None" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProviderItem">
                                                <Border
                                                    Width="36"
                                                    Height="36"
                                                    CornerRadius="8"
                                                    Background="White"
                                                    ToolTipService.ToolTip="{x:Bind Name}">
                                                    <Image Source="{x:Bind Logo}" Stretch="Uniform" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- components/file-details-section.tsx -->
                        <Border
                            Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="File details" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasFilePath, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        Text="LOCATION"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        CharacterSpacing="60"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind ViewModel.FilePath, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            FontFamily="Consolas"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Copy"
                                            Click="OnCopyPathClick"
                                            Padding="8,4"
                                            VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.FileCells, Mode=OneWay}" ItemTemplate="{StaticResource CellTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="120" MinColumnSpacing="12" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="28,44,28,0" Spacing="36">
                    <!-- components/franchise-row.tsx -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasFranchise, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.FranchiseTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Button
                                Content="{x:Bind ViewModel.AddAllLabel, Mode=OneWay}"
                                Click="OnAddAllClick"
                                Visibility="{x:Bind ViewModel.ShowsAddAll, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                IsEnabled="{x:Bind ViewModel.CanAddAll, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.AddAllResult, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasAddAllResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.FranchiseItems, Mode=OneWay}" ItemTemplate="{StaticResource PosterTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="150" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasStudios, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Studio" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ScrollViewer
                            HorizontalScrollMode="Enabled"
                            controls:WheelScroll.PassToPage="True"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Studios, Mode=OneWay}" Margin="0,0,0,8">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChipItem">
                                        <controls:StudioChip Item="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasSimilar, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="More like this" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ScrollViewer
                            HorizontalScrollMode="Enabled"
                            controls:WheelScroll.PassToPage="True"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Similar, Mode=OneWay}" ItemTemplate="{StaticResource PosterTemplate}" Margin="0,0,0,8">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="14" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading: only until the first answer. -->
        <StackPanel
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="36" Height="36" />
            <TextBlock
                Text="Loading this title…"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Error, when there is nothing else to show. -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Couldn't load this title" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
