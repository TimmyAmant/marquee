<?xml version="1.0" encoding="utf-8"?>
<!--
  app/requests/page.tsx: a member sees their own requests; the admin sees
  the review queue (Approve / Reject / Manually approve) and "Past requests".
  Each table is a header row plus an ItemsRepeater of rows sharing the same
  column widths, inside one card.
-->
<Page
    x:Class="Marquee.Windows.Views.RequestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="TableCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="TableHeaderText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TableCellText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
          Approve's "Advanced" (0.43+): the server, then its quality profile,
          root folder, tags and (TV) series type. Also on the title page.
        -->
        <DataTemplate x:Key="AddOverridesTemplate" x:DataType="vm:AddOverridesViewModel">
            <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Width="16" Height="16" />
                    <TextBlock
                        Text="Checking your Sonarr and Radarr servers…"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="6" Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{x:Bind Error, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                    <Button Content="Try again" Command="{x:Bind LoadCommand}" />
                </StackPanel>
                <TextBlock
                    Text="{x:Bind NoServersMessage, Mode=OneWay}"
                    Visibility="{x:Bind ShowsNoServers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <StackPanel Spacing="10" Visibility="{x:Bind ShowsPickers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox
                        Header="Server"
                        MinWidth="260"
                        ItemsSource="{x:Bind ServerNames, Mode=OneWay}"
                        SelectedIndex="{x:Bind ServerIndex, Mode=TwoWay}" />
                    <TextBlock
                        Text="This server isn't responding right now, so its lists can't be shown. Its saved settings will be used."
                        Visibility="{x:Bind ServerIsDown, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        Header="Quality profile"
                        MinWidth="260"
                        ItemsSource="{x:Bind QualityProfiles, Mode=OneWay}"
                        SelectedIndex="{x:Bind QualityProfileIndex, Mode=TwoWay}" />
                    <ComboBox
                        Header="Root folder"
                        MinWidth="260"
                        ItemsSource="{x:Bind RootFolders, Mode=OneWay}"
                        SelectedIndex="{x:Bind RootFolderIndex, Mode=TwoWay}" />
                    <StackPanel Spacing="6" Visibility="{x:Bind HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" />
                        <ItemsRepeater ItemsSource="{x:Bind Tags, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="140" MinColumnSpacing="12" MinRowSpacing="4" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:TagChoice">
                                    <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                    <ComboBox
                        Header="Series type"
                        MinWidth="260"
                        ItemsSource="{x:Bind SeriesTypes}"
                        SelectedIndex="{x:Bind SeriesTypeIndex, Mode=TwoWay}"
                        Visibility="{x:Bind ShowsSeriesType, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Text="Picking another server resets the rest to that server's defaults."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- components/issues-section.tsx's IssueCard: poster, title and episode, the details, then the actions on the right. -->
        <DataTemplate x:Key="IssueRowTemplate" x:DataType="vm:IssueRow">
            <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="56" CornerRadius="6" VerticalAlignment="Top" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton Content="{x:Bind Title}" Command="{x:Bind Open}" CommandParameter="{x:Bind}" Padding="4,2" />
                        <TextBlock
                            Text="{x:Bind EpisodeLabel}"
                            Visibility="{x:Bind EpisodeLabel, Converter={StaticResource StringToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind MetaLine}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,0" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind MessageLine}"
                        Visibility="{x:Bind MessageLine, Converter={StaticResource StringToVisibility}}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="4,2,0,0"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind FixedLine}"
                        Visibility="{x:Bind FixedLine, Converter={StaticResource StringToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource OwnedBadgeForegroundBrush}"
                        Margin="4,2,0,0"
                        TextWrapping="Wrap" />
                    <Grid
                        ColumnSpacing="8"
                        Margin="4,6,0,0"
                        Visibility="{x:Bind IsResolving, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Text="{x:Bind Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Note for them (optional), e.g. Replaced the file"
                            MaxLength="500" />
                        <Button
                            Grid.Column="1"
                            Content="{x:Bind ResolveLabel, Mode=OneWay}"
                            Command="{x:Bind ResolveCommand}"
                            IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Text="{x:Bind Error, Mode=OneWay}"
                        Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Margin="4,2,0,0"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind Info, Mode=OneWay}"
                        Visibility="{x:Bind HasInfo, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource OwnedBadgeForegroundBrush}"
                        Margin="4,2,0,0"
                        TextWrapping="Wrap" />
                    <!-- 0.46+: the report's conversation with the reviewers. -->
                    <controls:CommentThreadView Thread="{x:Bind Thread}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button
                        Content="{x:Bind SearchLabel, Mode=OneWay}"
                        Command="{x:Bind SearchAgainCommand}"
                        IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                        Visibility="{x:Bind ShowsAdminActions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Stretch" />
                    <Button
                        Content="Mark fixed"
                        Command="{x:Bind StartResolvingCommand}"
                        Visibility="{x:Bind ShowsAdminActions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Stretch" />
                    <HyperlinkButton
                        Content="{x:Bind RemoveLabel}"
                        Command="{x:Bind RemoveCommand}"
                        IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                        Visibility="{x:Bind ShowsRemove, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Right"
                        Padding="4,2" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- components/not-found-section.tsx's NotFoundCard (0.46+): poster, title, who and how long, the hint, then the actions on the right. -->
        <DataTemplate x:Key="NotFoundRowTemplate" x:DataType="vm:NotFoundRow">
            <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="56" CornerRadius="6" VerticalAlignment="Top" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton Content="{x:Bind Title}" Command="{x:Bind Open}" CommandParameter="{x:Bind}" Padding="4,2" />
                        <TextBlock
                            Text="{x:Bind SeasonsLine}"
                            Visibility="{x:Bind SeasonsLine, Converter={StaticResource StringToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind MetaLine}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,0" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind HintLine}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Margin="4,2,0,0"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind Error, Mode=OneWay}"
                        Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Margin="4,2,0,0"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind Info, Mode=OneWay}"
                        Visibility="{x:Bind HasInfo, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource OwnedBadgeForegroundBrush}"
                        Margin="4,2,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button
                        Content="{x:Bind SearchLabel, Mode=OneWay}"
                        Command="{x:Bind SearchAgainCommand}"
                        IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />
                    <Button
                        Content="{x:Bind OpenInArrLabel}"
                        Command="{x:Bind OpenInArrCommand}"
                        Visibility="{x:Bind CanOpenInArr, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Stretch" />
                    <HyperlinkButton
                        Content="{x:Bind DismissLabel, Mode=OneWay}"
                        Command="{x:Bind DismissCommand}"
                        IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                        HorizontalAlignment="Right"
                        Padding="4,2" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--
          components/couldnt-add-section.tsx's row (0.46+): poster, title, who and
          when it was approved and last tried, the error, the Advanced picks and the
          conversation; Retry and (the admin) "Added it by hand" on the right.
        -->
        <DataTemplate x:Key="CouldntAddRowTemplate" x:DataType="vm:CouldntAddRow">
            <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="56" CornerRadius="6" VerticalAlignment="Top" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton Content="{x:Bind Title}" Command="{x:Bind Open}" CommandParameter="{x:Bind}" Padding="4,2" />
                        <TextBlock
                            Text="{x:Bind SeasonsLine}"
                            Visibility="{x:Bind SeasonsLine, Converter={StaticResource StringToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind MetaLine}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,0" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ErrorLine, Mode=OneWay}"
                        Visibility="{x:Bind ErrorLine, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Margin="4,2,0,0"
                        TextWrapping="Wrap" />
                    <Expander
                        Header="Advanced"
                        Margin="0,6,0,0"
                        IsExpanded="{x:Bind Advanced.IsExpanded, Mode=TwoWay}"
                        Visibility="{x:Bind Advanced.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <ContentControl
                            Content="{x:Bind Advanced}"
                            ContentTemplate="{StaticResource AddOverridesTemplate}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" />
                    </Expander>
                    <controls:CommentThreadView Thread="{x:Bind Thread}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button
                        Content="{x:Bind RetryLabel, Mode=OneWay}"
                        Command="{x:Bind RetryCommand}"
                        IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" />
                    <HyperlinkButton
                        Content="{x:Bind ManualLabel, Mode=OneWay}"
                        Command="{x:Bind ManuallyApproveCommand}"
                        IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                        Visibility="{x:Bind ShowsAddedByHand, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="Mark it approved without Sonarr/Radarr, once you've got it some other way."
                        HorizontalAlignment="Right"
                        Padding="4,2" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <!-- A Stretch element under its MaxWidth is centered in the page, like Settings. -->
        <StackPanel Padding="28,20,28,40" Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">
            <TextBlock Text="Requests" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- MARK: Member -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsMember, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <!-- Request limits (0.39+): "Movies: 3 of 5 requests left (every 7 days)"; empty collapses it. -->
                <TextBlock
                    Text="{x:Bind ViewModel.LimitsLine, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.LimitsLine, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsMineLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsMineLoading, Mode=OneWay}" Width="24" Height="24" />
                    <TextBlock Text="Loading your requests…" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsMineError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Couldn't load your requests" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.MineError, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}" />
                </StackPanel>
                <TextBlock
                    Text="You haven't requested anything yet. Find a title and hit Request."
                    Visibility="{x:Bind ViewModel.IsMineEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Style="{StaticResource TableCard}" Visibility="{x:Bind ViewModel.HasMine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Padding="16,10" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Title" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="Requested" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource TableHeaderText}" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Mine, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:MyRequestRow">
                                    <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- 0.46+: Edit and Cancel request while pending, the hint once approved, and Comments (N). -->
                                        <controls:RequestActionsView
                                            Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Actions="{x:Bind Actions}"
                                            Margin="48,4,0,0" />
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                            <Border Width="40" Height="56" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                                <HyperlinkButton Content="{x:Bind Title}" Command="{x:Bind Open}" CommandParameter="{x:Bind}" Padding="4,2" />
                                                <TextBlock
                                                    Text="{x:Bind SeasonsLine}"
                                                    Visibility="{x:Bind SeasonsLine, Converter={StaticResource StringToVisibility}}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Margin="4,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind DateLabel}" Style="{StaticResource TableCellText}" />
                                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                            <controls:TonePill Text="{x:Bind StatusLabel}" Tone="{x:Bind Tone}" />
                                            <TextBlock
                                                Text="{x:Bind ReasonLine}"
                                                Visibility="{x:Bind ReasonLine, Converter={StaticResource StringToVisibility}}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- MARK: Admin -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.Reviews, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.ShowsApproveAll, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <InfoBar
                        Grid.Column="0"
                        IsOpen="{x:Bind ViewModel.HasApproveAllMessage, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ApproveAllMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.ApproveAllSeverity, Mode=OneWay}"
                        IsClosable="False" />
                    <Button
                        Grid.Column="1"
                        Content="{x:Bind ViewModel.ApproveAllLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ApproveAllCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Top" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsQueueLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsQueueLoading, Mode=OneWay}" Width="24" Height="24" />
                    <TextBlock Text="Checking requests against your library…" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsQueueError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Couldn't load the request queue" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.QueueError, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}" />
                </StackPanel>
                <TextBlock
                    Text="No pending requests."
                    Visibility="{x:Bind ViewModel.IsQueueEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- components/request-review-row.tsx -->
                <Border Style="{StaticResource TableCard}" Visibility="{x:Bind ViewModel.HasPending, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Padding="16,10" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Title" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="Requested by" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="Requested" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="Actions" Style="{StaticResource TableHeaderText}" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Pending}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:PendingRow">
                                    <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- 0.46+: Edit (a reviewer may change seasons and 4K before approving) and Comments (N). -->
                                        <controls:RequestActionsView
                                            Grid.Row="1"
                                            Grid.ColumnSpan="4"
                                            Actions="{x:Bind Actions}"
                                            Margin="48,4,0,0" />
                                        <!-- 0.43+: which server, profile, folder, tags (and series type) Approve adds it with. -->
                                        <Expander
                                            Grid.Row="2"
                                            Grid.ColumnSpan="4"
                                            Header="Advanced"
                                            Margin="0,8,0,0"
                                            IsExpanded="{x:Bind Advanced.IsExpanded, Mode=TwoWay}"
                                            Visibility="{x:Bind Advanced.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                            <ContentControl
                                                Content="{x:Bind Advanced}"
                                                ContentTemplate="{StaticResource AddOverridesTemplate}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" />
                                        </Expander>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                            <Border Width="40" Height="56" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                                <HyperlinkButton Content="{x:Bind Title}" Command="{x:Bind Open}" CommandParameter="{x:Bind}" Padding="4,2" />
                                                <TextBlock
                                                    Text="{x:Bind SeasonsLine, Mode=OneWay}"
                                                    Visibility="{x:Bind SeasonsLine, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Margin="4,0,0,0" />
                                                <!-- 0.46+: its seasons or 4K changed after it was asked. -->
                                                <TextBlock
                                                    Text="{x:Bind ChangedLine, Mode=OneWay}"
                                                    Visibility="{x:Bind ChangedLine, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Margin="4,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind RequesterLabel}" Style="{StaticResource TableCellText}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind DateLabel}" Style="{StaticResource TableCellText}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                        <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    Content="{x:Bind RejectLabel, Mode=OneWay}"
                                                    Command="{x:Bind RejectCommand}"
                                                    IsEnabled="{x:Bind CanAct, Mode=OneWay}" />
                                                <Button
                                                    Content="{x:Bind ApproveLabel, Mode=OneWay}"
                                                    Command="{x:Bind ApproveCommand}"
                                                    IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                                                    Visibility="{x:Bind ShowsApprove, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                                <Button
                                                    Content="{x:Bind ManualLabel, Mode=OneWay}"
                                                    Command="{x:Bind ManuallyApproveCommand}"
                                                    IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                                                    Visibility="{x:Bind ShowManualApprove, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTipService.ToolTip="Mark this approved without adding it via Sonarr. Use once you've downloaded it yourself." />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{x:Bind Error, Mode=OneWay}"
                                                Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                TextWrapping="Wrap" />
                                            <HyperlinkButton
                                                Content="Add manually in Sonarr"
                                                Command="{x:Bind AddManuallyCommand}"
                                                Visibility="{x:Bind CanAddManually, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                Padding="0,2" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- MARK: Couldn't add (0.46+): approved, but Sonarr/Radarr couldn't take them; hidden when there are none. -->
                <StackPanel Spacing="8" Margin="0,20,0,0" Visibility="{x:Bind ViewModel.ShowsCouldntAdd, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Couldn't add" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Border
                            Padding="8,2"
                            CornerRadius="10"
                            BorderThickness="1"
                            Background="{ThemeResource MissingBadgeBackgroundBrush}"
                            BorderBrush="{ThemeResource MissingBadgeForegroundBrush}"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.CouldntAddCountLabel, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource MissingBadgeForegroundBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.CouldntAddExplanation}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource TableCard}" Margin="0,4,0,0">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.CouldntAdd, Mode=OneWay}" ItemTemplate="{StaticResource CouldntAddRowTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <!-- MARK: Can't find (0.46+): approved requests Sonarr/Radarr hasn't found; hidden when there are none. -->
                <StackPanel Spacing="8" Margin="0,20,0,0" Visibility="{x:Bind ViewModel.ShowsNotFound, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Can't find" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Border
                            Padding="8,2"
                            CornerRadius="10"
                            BorderThickness="1"
                            Background="{ThemeResource MissingBadgeBackgroundBrush}"
                            BorderBrush="{ThemeResource MissingBadgeForegroundBrush}"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.NotFoundCountLabel, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource MissingBadgeForegroundBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.NotFoundExplanation, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource TableCard}" Margin="0,4,0,0">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.NotFound, Mode=OneWay}" ItemTemplate="{StaticResource NotFoundRowTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <!-- Past requests -->
                <TextBlock
                    Text="Past requests"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,20,0,0"
                    Visibility="{x:Bind ViewModel.ShowsHistorySection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    Text="{x:Bind ViewModel.HistoryError, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowsHistoryError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
                <Border Style="{StaticResource TableCard}" Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Padding="16,10" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Title" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="Requested by" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="Requested" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource TableHeaderText}" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReviewedRow">
                                    <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- 0.46+: Comments (N). -->
                                        <controls:CommentThreadView
                                            Grid.Row="1"
                                            Grid.ColumnSpan="4"
                                            Thread="{x:Bind Thread}"
                                            Margin="48,4,0,0" />
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                            <Border Width="40" Height="56" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                                <HyperlinkButton Content="{x:Bind Title}" Command="{x:Bind Open}" CommandParameter="{x:Bind}" Padding="4,2" />
                                                <TextBlock
                                                    Text="{x:Bind SeasonsLine}"
                                                    Visibility="{x:Bind SeasonsLine, Converter={StaticResource StringToVisibility}}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Margin="4,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind RequesterLabel}" Style="{StaticResource TableCellText}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind DateLabel}" Style="{StaticResource TableCellText}" />
                                        <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:TonePill Text="{x:Bind StatusLabel}" Tone="{x:Bind Tone}" />
                                                <!-- 0.46+: Sonarr/Radarr hasn't found it (listed under Can't find). -->
                                                <Border
                                                    Visibility="{x:Bind ShowsNotFound, Converter={StaticResource BoolToVisibility}}"
                                                    Padding="10,2"
                                                    CornerRadius="12"
                                                    BorderThickness="1"
                                                    Background="{ThemeResource MissingBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource MissingBadgeForegroundBrush}"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="Can't find"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource MissingBadgeForegroundBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock
                                                Text="{x:Bind ReasonLine}"
                                                Visibility="{x:Bind ReasonLine, Converter={StaticResource StringToVisibility}}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                            <!-- 0.43+: "Added to Radarr 2". -->
                                            <TextBlock
                                                Text="{x:Bind AddedToLine}"
                                                Visibility="{x:Bind AddedToLine, Converter={StaticResource StringToVisibility}}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- MARK: Problem reports (0.38+): the admin's "Reported problems" or a member's own; hidden when there are none. -->
            <StackPanel Spacing="12" Margin="0,20,0,0" Visibility="{x:Bind ViewModel.ShowsIssues, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Bind ViewModel.IssuesHeading, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="Nothing open right now."
                    Visibility="{x:Bind ViewModel.IsOpenIssuesEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Border Style="{StaticResource TableCard}" Visibility="{x:Bind ViewModel.HasOpenIssues, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.OpenIssues, Mode=OneWay}" ItemTemplate="{StaticResource IssueRowTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Border>
                <HyperlinkButton
                    Content="{x:Bind ViewModel.ShowFixedLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleFixedIssuesCommand}"
                    Visibility="{x:Bind ViewModel.HasFixedIssues, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Padding="0,2" />
                <Border
                    Style="{StaticResource TableCard}"
                    Opacity="0.8"
                    Visibility="{x:Bind ViewModel.ShowsFixedIssues, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FixedIssues, Mode=OneWay}" ItemTemplate="{StaticResource IssueRowTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
