<?xml version="1.0" encoding="utf-8"?>
<!--
  app/person/[id]/page.tsx: the header (photo, name with the star, born /
  died / place, the bio) over the filmography grid with its local filters.
-->
<Page
    x:Class="Marquee.Windows.Views.PersonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer Visibility="{x:Bind ViewModel.HasPerson, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Padding="28,20,28,40" Spacing="36">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Column="0"
                        Width="192"
                        Height="288"
                        VerticalAlignment="Top"
                        CornerRadius="12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Image Source="{x:Bind ViewModel.Photo, Mode=OneWay}" Stretch="UniformToFill" />
                        <FontIcon
                            Glyph="&#xE77B;"
                            FontSize="48"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.HasPhoto, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                                Style="{StaticResource TitleLargeTextBlockStyle}"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                VerticalAlignment="Center" />
                            <Button
                                Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind ViewModel.FavoriteGlyph, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.LifeLine, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasLifeLine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Biography, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasBiography, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.ShowsInlineError, Mode=OneWay}"
                            Severity="Error"
                            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            IsClosable="False" />
                    </StackPanel>
                </Grid>

                <controls:MediaList List="{x:Bind ViewModel.Credits, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="36" Height="36" />
            <TextBlock
                Text="Loading this person…"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Couldn't load this person" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
