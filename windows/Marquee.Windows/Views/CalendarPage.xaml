<?xml version="1.0" encoding="utf-8"?>
<!--
  app/calendar/page.tsx as a day list: the month picker (Today / Prev / Next
  and the month's name), then every day that has a release or an air date,
  each entry a button that opens its title.
-->
<Page
    x:Class="Marquee.Windows.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer Visibility="{x:Bind ViewModel.ShowsCalendar, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Padding="28,20,28,40" Spacing="20" MaxWidth="960" HorizontalAlignment="Left">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Calendar" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.MonthLabel, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Content="Today" Command="{x:Bind ViewModel.ShowTodayCommand}" />
                        <Button Content="← Prev" Command="{x:Bind ViewModel.ShowPreviousCommand}" />
                        <Button Content="Next →" Command="{x:Bind ViewModel.ShowNextCommand}" />
                    </StackPanel>
                </Grid>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.ShowsInlineError, Mode=OneWay}"
                    Severity="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsClosable="False" />

                <TextBlock
                    Text="{x:Bind ViewModel.EmptyMonthMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsMonthEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="18" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarDayGroup">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                    <Border
                                        Visibility="{x:Bind IsToday, Converter={StaticResource BoolToVisibility}}"
                                        Padding="8,1"
                                        CornerRadius="9"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="Today" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <ItemsRepeater ItemsSource="{x:Bind Entries}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="2" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CalendarEntryItem">
                                            <Button
                                                Command="{x:Bind Open}"
                                                CommandParameter="{x:Bind}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="6"
                                                AutomationProperties.Name="{x:Bind AccessibleName}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="28" Height="42" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                        <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind Subtitle}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Neither Sonarr nor Radarr is connected. -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsNotConfigured, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Calendar" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.NotConfiguredMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button
                Content="Connect an integration"
                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                Visibility="{x:Bind ViewModel.CanOpenSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}" Width="36" Height="36" />
            <TextBlock
                Text="Loading the calendar…"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Couldn't load the calendar" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
