<?xml version="1.0" encoding="utf-8"?>
<!--
  app/calendar/page.tsx: the month picker (Today / Prev / Next and the
  month's name), then the month grid (CalendarScreen.swift), each entry a
  button that opens its title.
-->
<Page
    x:Class="Marquee.Windows.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CalendarWeekday" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer Visibility="{x:Bind ViewModel.ShowsCalendar, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <!-- Up to 1240 wide (the Mac's); a Stretch element under its MaxWidth is centered in the page. -->
            <StackPanel Padding="28,20,28,40" Spacing="20" MaxWidth="1240" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Calendar" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.MonthLabel, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Content="Today" Command="{x:Bind ViewModel.ShowTodayCommand}" />
                        <Button Content="← Prev" Command="{x:Bind ViewModel.ShowPreviousCommand}" />
                        <Button Content="Next →" Command="{x:Bind ViewModel.ShowNextCommand}" />
                    </StackPanel>
                </Grid>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.ShowsInlineError, Mode=OneWay}"
                    Severity="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsClosable="False" />

                <TextBlock
                    Text="{x:Bind ViewModel.EmptyMonthMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsMonthEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- The month grid: 1px gaps in the border colour between cells, like the Mac's. -->
                <Border
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="1">
                        <Grid ColumnSpacing="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sun" Style="{StaticResource CalendarWeekday}" />
                            <TextBlock Grid.Column="1" Text="Mon" Style="{StaticResource CalendarWeekday}" />
                            <TextBlock Grid.Column="2" Text="Tue" Style="{StaticResource CalendarWeekday}" />
                            <TextBlock Grid.Column="3" Text="Wed" Style="{StaticResource CalendarWeekday}" />
                            <TextBlock Grid.Column="4" Text="Thu" Style="{StaticResource CalendarWeekday}" />
                            <TextBlock Grid.Column="5" Text="Fri" Style="{StaticResource CalendarWeekday}" />
                            <TextBlock Grid.Column="6" Text="Sat" Style="{StaticResource CalendarWeekday}" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cells, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <!-- Seven equal columns: Fill stretches them to the width, which
                                     the weekday row's seven star columns match. -->
                                <UniformGridLayout
                                    MaximumRowsOrColumns="7"
                                    MinItemWidth="90"
                                    MinItemHeight="150"
                                    MinColumnSpacing="1"
                                    MinRowSpacing="1"
                                    ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarDayCell">
                                    <Border
                                        Height="150"
                                        Padding="6"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        Opacity="{x:Bind CellOpacity}">
                                        <StackPanel Spacing="3">
                                            <Grid HorizontalAlignment="Left">
                                                <TextBlock
                                                    Text="{x:Bind DayNumber}"
                                                    Padding="6,1"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind IsToday, Converter={StaticResource InvertedBoolToVisibility}}" />
                                                <Border
                                                    Padding="6,1"
                                                    CornerRadius="9"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind IsToday, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock
                                                        Text="{x:Bind DayNumber}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{x:Bind Entries}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Vertical" Spacing="1" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CalendarEntryItem">
                                                        <Button
                                                            Command="{x:Bind Open}"
                                                            CommandParameter="{x:Bind}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="3,1"
                                                            ToolTipService.ToolTip="{x:Bind AccessibleName}"
                                                            AutomationProperties.Name="{x:Bind AccessibleName}">
                                                            <Grid ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="16" Height="24" CornerRadius="2" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                                    <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                                                                </Border>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Text="{x:Bind Name}"
                                                                    FontSize="11"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    TextWrapping="NoWrap"
                                                                    VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <TextBlock
                                                Text="{x:Bind MoreText}"
                                                FontSize="10"
                                                Padding="4,0,0,0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Visibility="{x:Bind HasMore, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Neither Sonarr nor Radarr is connected. -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsNotConfigured, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Calendar" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.NotConfiguredMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button
                Content="Connect an integration"
                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                Visibility="{x:Bind ViewModel.CanOpenSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}" Width="36" Height="36" />
            <TextBlock
                Text="Loading the calendar…"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Couldn't load the calendar" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
