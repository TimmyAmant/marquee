<?xml version="1.0" encoding="utf-8"?>
<!--
  app/discover/page.tsx: the shelves from GET /discover as horizontal rails.
  The page's own vertical ScrollViewer holds one rail per shelf; each rail
  is a horizontal ScrollViewer around the shelf's ItemsRepeater. WheelScroll.PassToPage
  hands the mouse wheel to the page, so it keeps scrolling down with the pointer
  over a rail; the rails scroll sideways with the ‹ › arrows in their header
  (RailArrows), Shift+wheel or their bars. Every shelf's header also has the
  server's "See all" chevron (DiscoverViewModel resolves where it goes).
  The shelves bleed off the right edge (no right padding), like the website.
-->
<Page
    x:Class="Marquee.Windows.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid>
        <ScrollViewer Visibility="{x:Bind ViewModel.HasShelves, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Padding="28,20,0,28">
                <TextBlock Text="Discover" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Shelves, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="24" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShelfViewModel">
                            <StackPanel Spacing="10">
                                <!--
                                  shelf.tsx's ShelfHead: the title, the round
                                  "See all" chevron right after it, and the
                                  ‹ › arrows at the right end, keeping the
                                  28px gutter the rail itself bleeds past.
                                -->
                                <Grid Margin="0,0,28,0" MinHeight="28" ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind Title}"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource MarqueeSeeAllButtonStyle}"
                                        Command="{x:Bind SeeAll}"
                                        Visibility="{x:Bind HasSeeAll, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="{x:Bind SeeAllLabel}"
                                        ToolTipService.ToolTip="{x:Bind SeeAllLabel}"
                                        VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE76C;" FontSize="9" />
                                    </Button>
                                    <controls:RailArrows
                                        Grid.Column="3"
                                        Target="{Binding ElementName=Rail}"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <!--
                                  One rail per shelf, so the arrows have one
                                  target: its content holds the four
                                  renderings, and only the shelf's own kind
                                  shows.
                                -->
                                <ScrollViewer
                                    x:Name="Rail"
                                    HorizontalScrollMode="Enabled"
                                    controls:WheelScroll.PassToPage="True"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Disabled">
                                    <Grid Margin="0,0,28,8">
                                        <ItemsRepeater
                                            ItemsSource="{x:Bind Posters}"
                                            Visibility="{x:Bind HasPosters, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="14" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PosterItem">
                                                    <controls:PosterCard Item="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>

                                        <ItemsRepeater
                                            ItemsSource="{x:Bind Chips}"
                                            Visibility="{x:Bind HasChips, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChipItem">
                                                    <Button Content="{x:Bind Label}" Command="{x:Bind Open}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>

                                        <!-- Studios / Networks: logo-card.tsx. -->
                                        <ItemsRepeater
                                            ItemsSource="{x:Bind Chips}"
                                            Visibility="{x:Bind HasLogoTiles, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="14" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChipItem">
                                                    <controls:LogoTile Item="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>

                                        <!-- Movie / Series Genres: genre-card.tsx. -->
                                        <ItemsRepeater
                                            ItemsSource="{x:Bind Chips}"
                                            Visibility="{x:Bind HasGenreTiles, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="12" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChipItem">
                                                    <controls:GenreTile Item="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Grid>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading: only until the first answer; a reload keeps the shelves up. -->
        <StackPanel
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="36" Height="36" />
            <TextBlock
                Text="Loading Discover…"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Error, when there is nothing else to show. -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Couldn't load Discover" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- TMDb isn't configured on the server (api-v1.md deviation 7). -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsTmdbMissing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Connect TMDb to start browsing" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.TmdbMissingMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button
                Content="Open Settings"
                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                Visibility="{x:Bind ViewModel.CanOpenSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Loaded, and every shelf came back empty. -->
        <StackPanel
            Spacing="12"
            MaxWidth="440"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Nothing to show yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="Your server couldn't get anything back from TMDb. Check its internet connection or the TMDb credential in Settings → Integrations, then reload (F5)."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
