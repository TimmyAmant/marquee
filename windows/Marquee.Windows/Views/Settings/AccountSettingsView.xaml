<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings › Account (app/settings/page.tsx, the Mac's AccountSettingsView):
  the account card and its edit form, Linked accounts and the Plex
  Watchlist, this PC's Notifications switch with your own channels and
  "What you hear about" (0.45+), the household members list
  (household-members-list.tsx, each row with its photo) with the admin's
  Add member, the admin's Plex/Jellyfin import and sign-in setting, and the
  request blocklist. Each card is a Border with the card brushes. The member
  dialogs are shown by the code-behind.
-->
<UserControl
    x:Class="Marquee.Windows.Views.Settings.AccountSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- A row of "What you hear about": the event's label as the server gives it, then a checkbox per column. -->
        <DataTemplate x:Key="PreferenceRowTemplate" x:DataType="vm:NotificationPreferenceRow">
            <Grid ColumnSpacing="12" MinHeight="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{x:Bind Label}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
                <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Cells}" VerticalAlignment="Center">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="0" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotificationPreferenceCell">
                            <Grid Width="80">
                                <CheckBox
                                    MinWidth="0"
                                    HorizontalAlignment="Center"
                                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                    AutomationProperties.Name="{x:Bind AutomationName}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="20">
        <!-- Account -->
        <TextBlock Text="Account" Style="{StaticResource SubtitleTextBlockStyle}" />
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{x:Bind ViewModel.Username, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{x:Bind ViewModel.RoleLabel, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <TextBox
                    Header="Name"
                    PlaceholderText="How the household sees you"
                    Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    MaxLength="80" />
                <PasswordBox
                    Header="New password"
                    PlaceholderText="Leave blank to keep the current password"
                    Password="{x:Bind ViewModel.NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox
                    Header="Confirm new password"
                    Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <!-- An account made by Plex/Jellyfin sign-in has no password yet, so none to give. -->
                <PasswordBox
                    Header="Current password"
                    PlaceholderText="Needed only when setting a new password"
                    Password="{x:Bind ViewModel.CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ViewModel.NeedsCurrentPassword, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    Text="Setting a new password signs you out of every device, including this PC."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                    Severity="Error"
                    Message="{x:Bind ViewModel.SaveError, Mode=OneWay}"
                    IsClosable="False" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasSaveNotice, Mode=OneWay}"
                    Severity="Success"
                    Message="{x:Bind ViewModel.SaveNotice, Mode=OneWay}"
                    IsClosable="False" />
                <Button
                    Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!--
          Linked accounts: the Plex and Jellyfin accounts (and, 0.44+, the
          admin's single sign-on) that sign in to yours. Only servers with
          Plex/Jellyfin sign-in send `linked`.
        -->
        <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.ShowsLinkedAccounts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Linked accounts" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="14">
                    <!-- Single sign-on: while the admin has it set up, or while this account is still linked to it. -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.ShowsSsoLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SsoLinkName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SsoLinkStatus, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button
                                    Content="{x:Bind ViewModel.LinkSsoLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.LinkSsoCommand}"
                                    Visibility="{x:Bind ViewModel.CanLinkSso, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Button
                                    Content="Unlink"
                                    Command="{x:Bind ViewModel.UnlinkSsoCommand}"
                                    Visibility="{x:Bind ViewModel.CanUnlinkSso, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsLinkingSso, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsLinkingSso, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.SsoWaitingLine, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelLinkSsoCommand}" />
                        </Grid>
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Plex" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.PlexLinkStatus, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Content="Link Plex"
                                Command="{x:Bind ViewModel.LinkPlexCommand}"
                                Visibility="{x:Bind ViewModel.CanLinkPlex, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Content="Unlink"
                                Command="{x:Bind ViewModel.UnlinkPlexCommand}"
                                Visibility="{x:Bind ViewModel.CanUnlinkPlex, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsLinkingPlex, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsLinkingPlex, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Waiting for Plex… Finish signing in in the browser window that just opened."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelLinkPlexCommand}" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.JellyfinName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.JellyfinLinkStatus, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Content="{x:Bind ViewModel.LinkJellyfinLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.LinkJellyfinCommand}"
                                Visibility="{x:Bind ViewModel.CanLinkJellyfin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Content="Unlink"
                                Command="{x:Bind ViewModel.UnlinkJellyfinCommand}"
                                Visibility="{x:Bind ViewModel.CanUnlinkJellyfin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Text="Your account has no Marquee password, so it signs in only with a linked account. Set one above to sign in with a username and password too."
                        Visibility="{x:Bind ViewModel.HasNoPassword, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasLinksError, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasLinksError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Severity="Error"
                        Message="{x:Bind ViewModel.LinksError, Mode=OneWay}"
                        IsClosable="False" />
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasLinksNotice, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasLinksNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Severity="Success"
                        Message="{x:Bind ViewModel.LinksNotice, Mode=OneWay}"
                        IsClosable="False" />
                </StackPanel>
            </Border>

            <!--
              Request from my Plex Watchlist (plex-watchlist.tsx): shown
              while Plex is linked. Turning it on is a plex.tv approval
              like Link Plex; once on, the switches, the last check,
              Check now and Turn off.
            -->
            <Border Style="{StaticResource SettingsCard}" Visibility="{x:Bind ViewModel.ShowsPlexWatchlist, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Request from my Plex Watchlist" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="New movies and shows you add to your Watchlist on Plex are requested for you, the same as pressing Request. Marquee keeps a Plex sign-in for this until you turn it off."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <controls:TonePill Text="{x:Bind ViewModel.PlexWatchlistBadge, Mode=OneWay}" Tone="{x:Bind ViewModel.PlexWatchlistTone}" VerticalAlignment="Center" />
                            <Button
                                Content="Turn on"
                                Command="{x:Bind ViewModel.TurnOnPlexWatchlistCommand}"
                                Visibility="{x:Bind ViewModel.CanTurnOnPlexWatchlist, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsTurningOnPlexWatchlist, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsTurningOnPlexWatchlist, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Waiting for Plex… finish in the browser."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelTurnOnPlexWatchlistCommand}" />
                    </Grid>
                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsPlexWatchlistOn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <ToggleSwitch
                                Header="Movies"
                                IsOn="{x:Bind ViewModel.PlexWatchlistMovies, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.CanChangePlexWatchlist, Mode=OneWay}"
                                OnContent="On"
                                OffContent="Off" />
                            <ToggleSwitch
                                Header="TV shows"
                                IsOn="{x:Bind ViewModel.PlexWatchlistTv, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.CanChangePlexWatchlist, Mode=OneWay}"
                                OnContent="On"
                                OffContent="Off" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.PlexWatchlistSummary, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind ViewModel.CheckPlexWatchlistLabel, Mode=OneWay}" Command="{x:Bind ViewModel.CheckPlexWatchlistCommand}" />
                            <Button Content="Turn off" Command="{x:Bind ViewModel.TurnOffPlexWatchlistCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.PlexWatchlistLastError, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasPlexWatchlistLastError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.PlexWatchlistError, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasPlexWatchlistError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--
          Notifications (Settings > Account > Notifications on the
          website): Windows notifications straight from the server's
          stream while the app runs. Asked once after signing in; this
          switch changes the answer.
        -->
        <TextBlock Text="Notifications" Style="{StaticResource SubtitleTextBlockStyle}" />
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
                <ToggleSwitch
                    Header="Show notifications on this PC"
                    IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.NotificationsSupported, Mode=OneWay}"
                    OnContent="On"
                    OffContent="Off" />
                <TextBlock
                    Text="When something starts downloading, is ready to watch, or a request is approved or declined, Windows shows it while Marquee is open. It comes straight from your Marquee server; nothing goes through an outside service."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.NotificationsNote, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.NotificationsNote, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--
          Your own channels and what you hear about (0.45+, the website's
          Settings > Account > Notifications): channels only you get
          (Telegram, email, Discord, ntfy, Pushover, a webhook), and which
          events reach the bell, device banners and each confirmed channel.
          Hidden on an older server, which answers 404.
        -->
        <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.Personal.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="4">
                <TextBlock Text="Your channels" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="Places only you get notifications: your own Telegram chat, inbox, Discord, ntfy topic, Pushover or webhook."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Border Style="{StaticResource SettingsCard}" Padding="0">
                <StackPanel>
                    <TextBlock
                        Text="No channels yet. Add one below."
                        Visibility="{x:Bind ViewModel.Personal.HasNoChannels, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Margin="20,16"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Personal.Channels, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonalChannelRow">
                                <StackPanel>
                                    <Border
                                        Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Visibility="{x:Bind ShowsDivider, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Padding="20,12" Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind DetailLine, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind StatusLine, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Text="{x:Bind LastErrorLine, Mode=OneWay}"
                                                    Visibility="{x:Bind LastErrorLine, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <ToggleSwitch
                                                    MinWidth="0"
                                                    IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                    IsEnabled="{x:Bind CanChange, Mode=OneWay}"
                                                    Visibility="{x:Bind CanManage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                                    OnContent="On"
                                                    OffContent="Off" />
                                                <Button
                                                    Content="Send a test"
                                                    Command="{x:Bind TestCommand}"
                                                    Visibility="{x:Bind CanTest, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                <Button
                                                    Content="Remove"
                                                    Command="{x:Bind RemoveCommand}"
                                                    Visibility="{x:Bind CanManage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                        <!-- Not confirmed yet: an email address, or a Telegram chat ID typed in by hand. -->
                                        <StackPanel Spacing="8" Visibility="{x:Bind NeedsCode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock
                                                Text="{x:Bind CodeSentLine, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBox
                                                    Width="140"
                                                    MaxLength="6"
                                                    InputScope="Number"
                                                    PlaceholderText="6-digit code"
                                                    AutomationProperties.Name="6-digit code"
                                                    Text="{x:Bind Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Content="Confirm" Command="{x:Bind VerifyCommand}" Style="{StaticResource AccentButtonStyle}" />
                                                <Button Content="Send a new code" Command="{x:Bind ResendCodeCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock
                                            Text="{x:Bind ErrorLine, Mode=OneWay}"
                                            Visibility="{x:Bind ErrorLine, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{x:Bind NoticeLine, Mode=OneWay}"
                                            Visibility="{x:Bind NoticeLine, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Add a channel: only the kinds this server has set up. -->
            <Border Style="{StaticResource SettingsCard}" Visibility="{x:Bind ViewModel.Personal.CanAddChannels, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Add a channel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox
                        Header="Kind"
                        MinWidth="260"
                        ItemsSource="{x:Bind ViewModel.Personal.AddKindLabels, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.Personal.SelectedAddKindIndex, Mode=TwoWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Personal.AddHint, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Personal.AddHint, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBox
                        Header="Name (optional)"
                        PlaceholderText="My phone"
                        MaxLength="60"
                        Text="{x:Bind ViewModel.Personal.AddName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- One-tap Telegram: opens a chat with the household bot; pressing Start there adds the channel. -->
                    <Button
                        Content="{x:Bind ViewModel.Personal.ConnectTelegramLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.Personal.ConnectTelegramCommand}"
                        Visibility="{x:Bind ViewModel.Personal.ShowsTelegramConnect, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.Personal.IsConnectingTelegram, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.Personal.IsConnectingTelegram, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind ViewModel.Personal.TelegramWaitingLine, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.Personal.CancelConnectTelegramCommand}" />
                    </Grid>
                    <TextBox
                        Header="Telegram chat ID"
                        PlaceholderText="123456789"
                        Text="{x:Bind ViewModel.Personal.AddChatId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.Personal.ShowsChatId, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBox
                        Header="Pushover user key"
                        Text="{x:Bind ViewModel.Personal.AddUserKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.Personal.ShowsUserKey, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBox
                        Header="Email address"
                        PlaceholderText="you@example.com"
                        InputScope="EmailSmtpAddress"
                        Text="{x:Bind ViewModel.Personal.AddAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.Personal.ShowsAddress, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBox
                        Header="Discord webhook URL"
                        PlaceholderText="https://discord.com/api/webhooks/…"
                        Text="{x:Bind ViewModel.Personal.AddWebhookUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.Personal.ShowsWebhookUrl, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBox
                        Header="Topic"
                        PlaceholderText="marquee-yourname"
                        Text="{x:Bind ViewModel.Personal.AddTopic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.Personal.ShowsTopic, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBox
                        Header="{x:Bind ViewModel.Personal.UrlHeader, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.Personal.UrlPlaceholder, Mode=OneWay}"
                        Text="{x:Bind ViewModel.Personal.AddUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.Personal.ShowsUrl, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.Personal.HasAddError, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Personal.HasAddError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Severity="Error"
                        Message="{x:Bind ViewModel.Personal.AddError, Mode=OneWay}"
                        IsClosable="False" />
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.Personal.HasAddNotice, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Personal.HasAddNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Severity="Success"
                        Message="{x:Bind ViewModel.Personal.AddNotice, Mode=OneWay}"
                        IsClosable="False" />
                    <Button
                        Content="{x:Bind ViewModel.Personal.AddLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.Personal.AddCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!--
              What you hear about: rows are events (the server's labels, the
              reviewers' ones grouped at the end), columns Bell, Devices and
              each confirmed channel. A tick is saved at once.
            -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Personal.ShowsPreferences, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="4">
                    <TextBlock Text="What you hear about" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="Bell: the list under the bell. Devices: banners on this PC and your other devices. Each channel gets only what's ticked."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <InfoBar
                    IsOpen="{x:Bind ViewModel.Personal.HasPreferencesError, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Personal.HasPreferencesError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Severity="Error"
                    Message="{x:Bind ViewModel.Personal.PreferencesError, Mode=OneWay}"
                    IsClosable="False" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Personal.ColumnHeaders, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="0" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NotificationPreferenceHeader">
                                        <TextBlock
                                            Width="80"
                                            Text="{x:Bind Label}"
                                            TextAlignment="Center"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Personal.EveryoneRows, Mode=OneWay}" ItemTemplate="{StaticResource PreferenceRowTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <TextBlock
                            Text="For reviewers"
                            Margin="0,12,0,0"
                            Visibility="{x:Bind ViewModel.Personal.HasReviewerRows, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Personal.ReviewerRows, Mode=OneWay}" ItemTemplate="{StaticResource PreferenceRowTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!--
          Menu position: which edge of the window the navigation bar sits on,
          for this PC only (the app's local settings). The window moves it as
          soon as one is picked.
        -->
        <TextBlock Text="Menu position" Style="{StaticResource SubtitleTextBlockStyle}" />
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
                <RadioButtons
                    Header="Where the navigation bar sits on this PC"
                    MaxColumns="4"
                    ItemsSource="{x:Bind ViewModel.MenuPositionLabels}"
                    SelectedIndex="{x:Bind ViewModel.MenuPositionIndex, Mode=TwoWay}" />
                <TextBlock
                    Text="Left is the default. Top and Bottom lay the icons out in a row along that edge. Other devices keep their own choice."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Household members: every account for the admin, only your own for a member -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Household members" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind ViewModel.MembersCaption, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Content="Add member"
                Command="{x:Bind ViewModel.AddMemberCommand}"
                Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource AccentButtonStyle}"
                VerticalAlignment="Bottom" />
        </Grid>
        <InfoBar
            IsOpen="{x:Bind ViewModel.HasMembersNotice, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasMembersNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Severity="Success"
            Message="{x:Bind ViewModel.MembersNotice, Mode=OneWay}"
            IsClosable="False" />
        <InfoBar
            IsOpen="{x:Bind ViewModel.HasMembersActionError, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasMembersActionError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Severity="Error"
            Message="{x:Bind ViewModel.MembersActionError, Mode=OneWay}"
            IsClosable="False" />
        <Border Style="{StaticResource SettingsCard}" Padding="0">
            <StackPanel>
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsMembersLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsMembersLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Width="20"
                    Height="20"
                    Margin="20"
                    HorizontalAlignment="Left" />
                <StackPanel Padding="20" Spacing="8" Visibility="{x:Bind ViewModel.ShowsMembersError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{x:Bind ViewModel.MembersError, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                    <Button Content="Try again" Command="{x:Bind ViewModel.LoadMembersCommand}" />
                </StackPanel>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Members, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="0" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HouseholdMemberRow">
                            <StackPanel>
                                <Border
                                    Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind ShowsDivider, Converter={StaticResource BoolToVisibility}}" />
                                <Grid Padding="20,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:AvatarView
                                        Grid.Column="0"
                                        Label="{x:Bind Label}"
                                        AvatarUrl="{x:Bind AvatarUrl}"
                                        Diameter="36"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind Label}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind UsernameLine}"
                                            Visibility="{x:Bind UsernameLine, Converter={StaticResource StringToVisibility}}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind LastActiveLine}"
                                            Visibility="{x:Bind LastActiveLine, Converter={StaticResource StringToVisibility}}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- An empty text collapses the pill. -->
                                        <controls:TonePill Text="{x:Bind PlexTag}" Tone="{x:Bind LinkTone}" />
                                        <controls:TonePill Text="{x:Bind JellyfinTag}" Tone="{x:Bind LinkTone}" />
                                        <controls:TonePill Text="{x:Bind SsoTag}" Tone="{x:Bind LinkTone}" />
                                        <controls:TonePill
                                            Text="Admin"
                                            Tone="{x:Bind AdminTone}"
                                            Visibility="{x:Bind IsAdminRow, Converter={StaticResource BoolToVisibility}}" />
                                        <controls:TonePill Text="{x:Bind TrustedTag}" Tone="{x:Bind AdminTone}" />
                                        <controls:TonePill
                                            Text="You"
                                            Tone="{x:Bind YouTone}"
                                            Visibility="{x:Bind IsCurrentUser, Converter={StaticResource BoolToVisibility}}" />
                                        <Button
                                            Content="Edit"
                                            Command="{x:Bind Edit}"
                                            CommandParameter="{x:Bind}"
                                            Visibility="{x:Bind CanEdit, Converter={StaticResource BoolToVisibility}}" />
                                        <Button
                                            Content="Remove"
                                            Command="{x:Bind Remove}"
                                            CommandParameter="{x:Bind}"
                                            Visibility="{x:Bind CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Border>

        <!--
          The admin's Plex and Jellyfin members: import them (each gets a
          member account linked to theirs), and whether a Plex/Jellyfin
          user without an account gets one on first sign-in.
        -->
        <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.ShowsMediaServerMembers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Bind ViewModel.MediaServerMembersTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="14">
                    <TextBlock
                        Text="{x:Bind ViewModel.NoMediaServersExplanation, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasNoMediaServers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="Import from Plex"
                            Command="{x:Bind ViewModel.ImportFromPlexCommand}"
                            Visibility="{x:Bind ViewModel.CanImportFromPlex, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            Content="{x:Bind ViewModel.ImportFromJellyfinLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ImportFromJellyfinCommand}"
                            Visibility="{x:Bind ViewModel.CanImportFromJellyfin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasSignInSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ToggleSwitch
                            Header="{x:Bind ViewModel.MediaServerSignupHeader, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.MediaServerSignup, Mode=TwoWay}"
                            OnContent="On"
                            OffContent="Off" />
                        <TextBlock
                            Text="{x:Bind ViewModel.MediaServerSignupExplanation, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!--
          Request blocklist (app/settings/blocklist-settings.tsx, 0.41+):
          titles blocked from their page and TMDb keywords/genres nobody
          may request, each with Remove, and a form to block a keyword.
          Admin-only, and hidden on an older server.
        -->
        <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.Blocklist.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="4">
                <TextBlock Text="Request blocklist" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="What nobody can request. You can still add these yourself."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar
                IsOpen="{x:Bind ViewModel.Blocklist.HasError, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.Blocklist.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Severity="Error"
                Message="{x:Bind ViewModel.Blocklist.Error, Mode=OneWay}"
                IsClosable="False" />
            <Border Style="{StaticResource SettingsCard}" Padding="0">
                <StackPanel>
                    <TextBlock
                        Text="Nothing blocked. Block a title from its page, or a keyword below."
                        Visibility="{x:Bind ViewModel.Blocklist.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Margin="20,16"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Blocklist.Rows, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:BlocklistRow">
                                <StackPanel>
                                    <Border
                                        Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Visibility="{x:Bind ShowsDivider, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Padding="20,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <HyperlinkButton
                                                Content="{x:Bind Label}"
                                                Command="{x:Bind Open}"
                                                CommandParameter="{x:Bind}"
                                                Padding="0"
                                                Visibility="{x:Bind IsTitle, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock
                                                Text="{x:Bind Label}"
                                                Visibility="{x:Bind IsKeyword, Converter={StaticResource BoolToVisibility}}"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind ReasonLine}"
                                                Visibility="{x:Bind ReasonLine, Converter={StaticResource StringToVisibility}}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Content="Remove"
                                            Command="{x:Bind Remove}"
                                            CommandParameter="{x:Bind}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Padding="20,16" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="Block a keyword or genre"
                                PlaceholderText="e.g. anime, reality, horror"
                                Text="{x:Bind ViewModel.Blocklist.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="Any title with this TMDb keyword or genre can’t be requested (you can still add it yourself)."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox
                            Header="Reason (optional, shown to whoever asks)"
                            MaxLength="200"
                            Text="{x:Bind ViewModel.Blocklist.Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Content="{x:Bind ViewModel.Blocklist.BlockLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.Blocklist.BlockCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
