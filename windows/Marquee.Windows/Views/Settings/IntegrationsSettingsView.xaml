<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings › Integrations (app/settings/integrations/page.tsx, the Mac's
  IntegrationsSettingsView), the admin's: Media Libraries (Plex, Jellyfin or
  Emby), Sign-in (single sign-on on a 0.44+ server), Download Clients (any number of Sonarr and Radarr servers on a
  0.43+ server; before that Sonarr, Radarr, and the 4K ones on a 0.37+
  server), Metadata Sources (TMDb, Trakt with list import, TheTVDB) and
  Notifications (the Sonarr/Radarr webhooks, Discord, ntfy, Telegram,
  Pushover and email on a 0.36+ server, a custom webhook), with Sync now.
  The cards that repeat a shape (Sonarr/Radarr, the one-secret cards, the
  Disconnect confirmation) are DataTemplates below.
-->
<UserControl
    x:Class="Marquee.Windows.Views.Settings.IntegrationsSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- components/disconnect-button.tsx: "Disconnect", then "Disconnect Plex?" with Confirm and Cancel. -->
        <DataTemplate x:Key="DisconnectTemplate" x:DataType="vm:DisconnectViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind Error, Mode=OneWay}"
                    Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    MaxWidth="220"
                    VerticalAlignment="Center" />
                <Button
                    Content="Disconnect"
                    Command="{x:Bind AskCommand}"
                    Visibility="{x:Bind IsAsking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind IsConfirming, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{x:Bind Prompt, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <Button Content="{x:Bind ConfirmLabel, Mode=OneWay}" Command="{x:Bind ConfirmCommand}" />
                    <Button Content="Cancel" Command="{x:Bind CancelCommand}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- components/arr-credential-form.tsx: Sonarr, Radarr, and the 4K ones. -->
        <DataTemplate x:Key="ArrCardTemplate" x:DataType="vm:ArrIntegrationViewModel">
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind Description}"
                                Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <controls:TonePill Text="{x:Bind ConnectedBadge, Mode=OneWay}" Tone="{x:Bind ConnectedTone}" VerticalAlignment="Center" />
                            <ContentControl
                                Content="{x:Bind Disconnect}"
                                ContentTemplate="{StaticResource DisconnectTemplate}"
                                Visibility="{x:Bind IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                    <TextBox
                        Header="Server URL"
                        PlaceholderText="{x:Bind BaseUrlPlaceholder}"
                        Text="{x:Bind BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox
                        Header="API key"
                        PlaceholderText="{x:Bind ApiKeyPlaceholder, Mode=OneWay}"
                        Password="{x:Bind ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <InfoBar
                        IsOpen="{x:Bind HasError, Mode=OneWay}"
                        Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Severity="Error"
                        Message="{x:Bind Error, Mode=OneWay}"
                        IsClosable="False" />
                    <InfoBar
                        IsOpen="{x:Bind HasNotice, Mode=OneWay}"
                        Visibility="{x:Bind HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Severity="Success"
                        Message="{x:Bind Notice, Mode=OneWay}"
                        IsClosable="False" />
                    <Button
                        Content="{x:Bind SaveLabel, Mode=OneWay}"
                        Command="{x:Bind SaveCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <StackPanel Spacing="12" Visibility="{x:Bind ShowsDefaults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock
                            Text="Defaults used when adding new titles:"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox
                            Header="Root folder"
                            MinWidth="260"
                            ItemsSource="{x:Bind RootFolders, Mode=OneWay}"
                            SelectedIndex="{x:Bind SelectedRootFolderIndex, Mode=TwoWay}" />
                        <ComboBox
                            Header="Quality profile"
                            MinWidth="260"
                            ItemsSource="{x:Bind QualityProfiles, Mode=OneWay}"
                            SelectedIndex="{x:Bind SelectedQualityProfileIndex, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{x:Bind SaveDefaultsLabel, Mode=OneWay}" Command="{x:Bind SaveDefaultsCommand}" />
                            <TextBlock
                                Text="Saved."
                                Visibility="{x:Bind DefaultsSaved, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Text="Pick a root folder and quality profile before adding titles — test the connection to load them."
                        Visibility="{x:Bind NeedsDefaults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One Sonarr/Radarr server (0.43+): name, URL and badges, its actions, and its own webhook. -->
        <DataTemplate x:Key="ArrServerRowTemplate" x:DataType="vm:ArrServerRow">
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <controls:TonePill Text="{x:Bind DefaultBadge, Mode=OneWay}" Tone="{x:Bind DefaultTone}" VerticalAlignment="Center" />
                                <controls:TonePill Text="{x:Bind FourKBadge, Mode=OneWay}" Tone="{x:Bind FourKTone}" VerticalAlignment="Center" />
                                <controls:TonePill Text="{x:Bind SetupBadge, Mode=OneWay}" Tone="{x:Bind SetupTone}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind BaseUrl, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind ShowsActions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Edit" Command="{x:Bind EditCommand}" IsEnabled="{x:Bind CanAct, Mode=OneWay}" />
                                <Button
                                    Content="{x:Bind MakeDefaultLabel, Mode=OneWay}"
                                    Command="{x:Bind MakeDefaultCommand}"
                                    IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                                    Visibility="{x:Bind IsDefault, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}" />
                                <Button Content="Remove" Command="{x:Bind AskRemoveCommand}" IsEnabled="{x:Bind CanAct, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind IsConfirmingRemove, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Text="{x:Bind RemovePrompt, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                                <Button Content="{x:Bind RemoveConfirmLabel, Mode=OneWay}" Command="{x:Bind ConfirmRemoveCommand}" />
                                <Button Content="Cancel" Command="{x:Bind CancelRemoveCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Webhook URL" Style="{StaticResource FieldLabel}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{x:Bind WebhookUrl, Mode=OneWay}" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="{x:Bind CopyLabel, Mode=OneWay}" Command="{x:Bind CopyWebhookCommand}" />
                            <Button
                                Grid.Column="2"
                                Content="Regenerate"
                                Command="{x:Bind AskRegenerateCommand}"
                                Visibility="{x:Bind ShowsRegenerate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock
                            Text="Paste it into this server's Settings → Connect → Add → Webhook (method POST, on Grab and on Import/Download)."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind IsConfirmingRegenerate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Text="Regenerate? The URL above stops working immediately."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <Button Content="{x:Bind RegenerateConfirmLabel, Mode=OneWay}" Command="{x:Bind ConfirmRegenerateCommand}" />
                            <Button Content="Cancel" Command="{x:Bind CancelRegenerateCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind Error, Mode=OneWay}"
                        Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One Sonarr/Radarr tag in a tags picker. -->
        <DataTemplate x:Key="TagChoiceTemplate" x:DataType="vm:TagChoice">
            <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
        </DataTemplate>

        <!-- A "Test & save" card with one secret: TMDb, Trakt, TheTVDB, Discord, ntfy, the custom webhook. -->
        <DataTemplate x:Key="SecretCardTemplate" x:DataType="vm:SecretCardViewModel">
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind Description}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <controls:TonePill Grid.Column="1" Text="{x:Bind ConnectedBadge, Mode=OneWay}" Tone="{x:Bind ConnectedTone}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock
                        Text="{x:Bind Note, Mode=OneWay}"
                        Visibility="{x:Bind Note, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <PasswordBox
                        Header="{x:Bind FieldLabel}"
                        PlaceholderText="{x:Bind Placeholder, Mode=OneWay}"
                        Password="{x:Bind Secret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <InfoBar
                        IsOpen="{x:Bind HasError, Mode=OneWay}"
                        Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Severity="Error"
                        Message="{x:Bind Error, Mode=OneWay}"
                        IsClosable="False" />
                    <InfoBar
                        IsOpen="{x:Bind HasNotice, Mode=OneWay}"
                        Visibility="{x:Bind HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Severity="Success"
                        Message="{x:Bind Notice, Mode=OneWay}"
                        IsClosable="False" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="{x:Bind SaveLabel, Mode=OneWay}"
                            Command="{x:Bind SaveCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Content="{x:Bind RemoveButtonLabel, Mode=OneWay}"
                            Command="{x:Bind RemoveCommand}"
                            Visibility="{x:Bind IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="20">
        <!-- The pane's heading, with Sync now on the right. -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Integrations" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="Connect Plex, Jellyfin, Sonarr, and Radarr so Marquee knows what you already own and can send the rest straight to your download queue. Credentials are stored encrypted on your server and only ever used on your behalf."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                <Button
                    Content="{x:Bind ViewModel.SyncLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SyncNowCommand}"
                    HorizontalAlignment="Right" />
                <TextBlock
                    Text="{x:Bind ViewModel.SyncNotice, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasSyncNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    HorizontalAlignment="Right" />
                <TextBlock
                    Text="{x:Bind ViewModel.SyncError, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasSyncError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    MaxWidth="240"
                    HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <!-- The first load: the server re-syncs anything older than 15 minutes first. -->
        <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" />
            <TextBlock
                Text="Checking your integrations…"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsLoadError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                Text="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap" />
            <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <StackPanel Spacing="28" Visibility="{x:Bind ViewModel.HasOverview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <!-- Media Libraries -->
            <StackPanel Spacing="12">
                <TextBlock Text="Media Libraries" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- components/plex-connect-card.tsx -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Plex" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <controls:TonePill Text="{x:Bind ViewModel.Plex.ConnectedBadge, Mode=OneWay}" Tone="{x:Bind ViewModel.Plex.ConnectedTone}" VerticalAlignment="Center" />
                                <ContentControl
                                    Content="{x:Bind ViewModel.Plex.Disconnect}"
                                    ContentTemplate="{StaticResource DisconnectTemplate}"
                                    Visibility="{x:Bind ViewModel.Plex.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Plex.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind ViewModel.Plex.SummaryLine, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Plex.LastSyncedLine, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Plex.IsDisconnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Text="Sign in with your Plex account to see what's already in your library."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button
                                    Content="{x:Bind ViewModel.Plex.ConnectLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.Plex.ConnectCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <TextBlock
                                    Text="Finish signing in in the browser window that just opened."
                                    Visibility="{x:Bind ViewModel.Plex.IsWaiting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.Plex.Error, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Plex.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- components/jellyfin-connect-card.tsx: Jellyfin or Emby. -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Jellyfin or Emby" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.Jellyfin.Description, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <controls:TonePill Text="{x:Bind ViewModel.Jellyfin.ConnectedBadge, Mode=OneWay}" Tone="{x:Bind ViewModel.Jellyfin.ConnectedTone}" VerticalAlignment="Center" />
                                <ContentControl
                                    Content="{x:Bind ViewModel.Jellyfin.Disconnect}"
                                    ContentTemplate="{StaticResource DisconnectTemplate}"
                                    Visibility="{x:Bind ViewModel.Jellyfin.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Text="{x:Bind ViewModel.Jellyfin.SummaryLine, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Jellyfin.SummaryLine, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="Generate an API key from the dashboard: Administration → API Keys in Jellyfin, or Advanced → API Keys in Emby."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBox
                            Header="Server URL"
                            PlaceholderText="http://localhost:8096"
                            Text="{x:Bind ViewModel.Jellyfin.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <PasswordBox
                            Header="API key"
                            PlaceholderText="{x:Bind ViewModel.Jellyfin.ApiKeyPlaceholder, Mode=OneWay}"
                            Password="{x:Bind ViewModel.Jellyfin.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.Jellyfin.HasError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Jellyfin.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Error"
                            Message="{x:Bind ViewModel.Jellyfin.Error, Mode=OneWay}"
                            IsClosable="False" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.Jellyfin.HasNotice, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Jellyfin.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Success"
                            Message="{x:Bind ViewModel.Jellyfin.Notice, Mode=OneWay}"
                            IsClosable="False" />
                        <Button
                            Content="{x:Bind ViewModel.Jellyfin.SaveLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.Jellyfin.SaveCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--
              Sign-in: components/sso-settings-card.tsx, single sign-on with
              any OpenID Connect provider. Only from a 0.44+ server (an older
              one answers GET /settings/sso with 404). The client secret is
              write-only: the card only knows whether one is saved.
            -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Sso.IsAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Sign-in" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Single sign-on" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Adds “Sign in with …” for your own identity provider — Authentik, Authelia, Pocket ID, Keycloak, Google, or anything else that speaks OpenID Connect — on the website and the Mac and Windows apps."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:TonePill Grid.Column="1" Text="{x:Bind ViewModel.Sso.OnBadge, Mode=OneWay}" Tone="{x:Bind ViewModel.Sso.OnTone}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="Button name"
                                PlaceholderText="Authentik"
                                MaxLength="40"
                                Text="{x:Bind ViewModel.Sso.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="The sign-in button says “Sign in with &lt;name&gt;”."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="Marquee's address"
                                PlaceholderText="https://marquee.example.com"
                                IsSpellCheckEnabled="False"
                                Text="{x:Bind ViewModel.Sso.PublicUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="The address people use to reach Marquee from outside."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Redirect URI — add this to the provider exactly" Style="{StaticResource FieldLabel}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.Sso.CallbackUrl, Mode=OneWay}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="{x:Bind ViewModel.Sso.CopyLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Sso.CopyCallbackCommand}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Header="Issuer URL"
                                    PlaceholderText="https://auth.example.com/application/o/marquee/"
                                    IsSpellCheckEnabled="False"
                                    Text="{x:Bind ViewModel.Sso.Issuer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Content="{x:Bind ViewModel.Sso.TestLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.Sso.TestCommand}"
                                    IsEnabled="{x:Bind ViewModel.Sso.CanTest, Mode=OneWay}"
                                    VerticalAlignment="Bottom" />
                            </Grid>
                            <TextBlock
                                Text="The provider's issuer, or its …/.well-known/openid-configuration address."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.Sso.TestError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Sso.HasTestError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Sso.HasTestFound, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Text="{x:Bind ViewModel.Sso.TestFound, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Sso.TestWarnings, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Sso.HasTestWarnings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox
                            Header="Client ID"
                            IsSpellCheckEnabled="False"
                            Text="{x:Bind ViewModel.Sso.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <PasswordBox
                            Header="Client secret"
                            PlaceholderText="{x:Bind ViewModel.Sso.ClientSecretPlaceholder, Mode=OneWay}"
                            Password="{x:Bind ViewModel.Sso.ClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Content="Remove the saved secret (a public client)"
                            IsChecked="{x:Bind ViewModel.Sso.ClearClientSecret, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.Sso.HasClientSecret, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="Scopes"
                                IsSpellCheckEnabled="False"
                                Text="{x:Bind ViewModel.Sso.Scopes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="Add “groups” for Authelia and Pocket ID if you use groups below."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <ToggleSwitch
                                Header="New accounts from single sign-on"
                                IsOn="{x:Bind ViewModel.Sso.AllowSignup, Mode=TwoWay}"
                                OnContent="On"
                                OffContent="Off" />
                            <TextBlock
                                Text="Anyone your provider lets in gets a member account on first sign-in. Off: only accounts that linked it can use it."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <ToggleSwitch
                                Header="Match existing accounts by verified email"
                                IsOn="{x:Bind ViewModel.Sso.MatchEmail, Mode=TwoWay}"
                                OnContent="On"
                                OffContent="Off" />
                            <TextBlock
                                Text="First sign-in links an account whose username is the person's email — only when the provider says the email is verified, and never the admin account."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="Required group (optional)"
                                PlaceholderText="marquee-users"
                                IsSpellCheckEnabled="False"
                                Text="{x:Bind ViewModel.Sso.RequiredGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="Only people in this group can sign in with it."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="Trusted group (optional)"
                                PlaceholderText="marquee-trusted"
                                IsSpellCheckEnabled="False"
                                Text="{x:Bind ViewModel.Sso.TrustedGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="Members in this group become Trusted when they sign in. Nobody is ever made an admin this way."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox
                            Header="Groups claim"
                            IsSpellCheckEnabled="False"
                            Text="{x:Bind ViewModel.Sso.GroupsClaim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.Sso.HasError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Sso.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Error"
                            Message="{x:Bind ViewModel.Sso.Error, Mode=OneWay}"
                            IsClosable="False" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.Sso.HasNotice, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Sso.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Success"
                            Message="{x:Bind ViewModel.Sso.Notice, Mode=OneWay}"
                            IsClosable="False" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="{x:Bind ViewModel.Sso.SaveLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Sso.SaveCommand}"
                                IsEnabled="{x:Bind ViewModel.Sso.CanSave, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Content="{x:Bind ViewModel.Sso.RemoveLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Sso.RemoveCommand}"
                                IsEnabled="{x:Bind ViewModel.Sso.CanRemove, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Sso.IsConfigured, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--
              Download Clients: on a 0.43+ server any number of Sonarr and
              Radarr servers, with one Add/Edit form under the lists; before
              that Sonarr, Radarr, then the 4K ones on a 0.37+ server.
            -->
            <StackPanel Spacing="12">
                <TextBlock Text="Download Clients" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsRepeater
                    ItemsSource="{x:Bind ViewModel.ArrCards, Mode=OneWay}"
                    ItemTemplate="{StaticResource ArrCardTemplate}"
                    Visibility="{x:Bind ViewModel.ShowsArrCards, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowsArrServers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="Add as many Sonarr and Radarr servers as you like. Titles go to the default one unless a different server is picked under Advanced when approving or adding."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <!-- Sonarr servers -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sonarr" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Add Sonarr server" Command="{x:Bind ViewModel.ArrServers.AddSonarrCommand}" />
                    </Grid>
                    <TextBlock
                        Text="No Sonarr servers yet."
                        Visibility="{x:Bind ViewModel.ArrServers.HasNoSonarr, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ArrServers.SonarrServers, Mode=OneWay}" ItemTemplate="{StaticResource ArrServerRowTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="12" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <!-- Radarr servers -->
                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Radarr" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Add Radarr server" Command="{x:Bind ViewModel.ArrServers.AddRadarrCommand}" />
                    </Grid>
                    <TextBlock
                        Text="No Radarr servers yet."
                        Visibility="{x:Bind ViewModel.ArrServers.HasNoRadarr, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ArrServers.RadarrServers, Mode=OneWay}" ItemTemplate="{StaticResource ArrServerRowTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="12" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <!-- The Add/Edit form: one at a time, brought into view when it opens. -->
                    <Border
                        x:Name="ArrServerEditorCard"
                        Style="{StaticResource SettingsCard}"
                        Visibility="{x:Bind ViewModel.ArrServers.Editor.IsOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{x:Bind ViewModel.ArrServers.Editor.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox
                                Header="Name"
                                PlaceholderText="Leave blank to name it after its kind, like “Radarr 2”"
                                MaxLength="60"
                                Text="{x:Bind ViewModel.ArrServers.Editor.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Header="Server URL"
                                PlaceholderText="{x:Bind ViewModel.ArrServers.Editor.BaseUrlPlaceholder, Mode=OneWay}"
                                Text="{x:Bind ViewModel.ArrServers.Editor.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Spacing="4">
                                <PasswordBox
                                    Header="API key"
                                    PlaceholderText="{x:Bind ViewModel.ArrServers.Editor.ApiKeyPlaceholder, Mode=OneWay}"
                                    Password="{x:Bind ViewModel.ArrServers.Editor.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ArrServers.Editor.KeyAgainMessage}"
                                    Visibility="{x:Bind ViewModel.ArrServers.Editor.NeedsKeyAgain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ToggleSwitch
                                    Header="4K server"
                                    IsOn="{x:Bind ViewModel.ArrServers.Editor.Is4k, Mode=TwoWay}"
                                    OnContent="On"
                                    OffContent="Off" />
                                <TextBlock
                                    Text="4K requests and “Add in 4K” go to a 4K server, and it isn't counted as part of the library."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ToggleSwitch
                                    Header="Default server"
                                    IsOn="{x:Bind ViewModel.ArrServers.Editor.IsDefault, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.ArrServers.Editor.CanChangeDefault, Mode=OneWay}"
                                    OnContent="On"
                                    OffContent="Off" />
                                <TextBlock
                                    Text="Where titles go when nobody picks a server. To move the default, make another server the default."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button
                                    Content="{x:Bind ViewModel.ArrServers.Editor.TestLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ArrServers.Editor.TestCommand}"
                                    IsEnabled="{x:Bind ViewModel.ArrServers.Editor.CanAct, Mode=OneWay}" />
                                <ProgressRing
                                    IsActive="{x:Bind ViewModel.ArrServers.Editor.IsLoadingOptions, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.ArrServers.Editor.IsLoadingOptions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Width="16"
                                    Height="16" />
                                <TextBlock
                                    Text="Test the connection to pick a quality profile, root folder and tags."
                                    Visibility="{x:Bind ViewModel.ArrServers.Editor.HasOptions, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- What's used when adding titles, once Test (or the saved server) answered. -->
                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ArrServers.Editor.HasOptions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock
                                    Text="Used when adding titles:"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox
                                    Header="Quality profile"
                                    MinWidth="260"
                                    ItemsSource="{x:Bind ViewModel.ArrServers.Editor.QualityProfiles, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.ArrServers.Editor.QualityProfileIndex, Mode=TwoWay}" />
                                <ComboBox
                                    Header="Root folder"
                                    MinWidth="260"
                                    ItemsSource="{x:Bind ViewModel.ArrServers.Editor.RootFolders, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.ArrServers.Editor.RootFolderIndex, Mode=TwoWay}" />
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ArrServers.Editor.HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ArrServers.Editor.Tags, Mode=OneWay}" ItemTemplate="{StaticResource TagChoiceTemplate}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="160" MinColumnSpacing="12" MinRowSpacing="4" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                </StackPanel>
                            </StackPanel>

                            <!-- Sonarr only: series type and season folders, then the anime overrides. -->
                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ArrServers.Editor.IsSonarr, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox
                                    Header="Series type"
                                    MinWidth="260"
                                    ItemsSource="{x:Bind ViewModel.ArrServers.Editor.SeriesTypes}"
                                    SelectedIndex="{x:Bind ViewModel.ArrServers.Editor.SeriesTypeIndex, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Header="Season folders"
                                    IsOn="{x:Bind ViewModel.ArrServers.Editor.SeasonFolders, Mode=TwoWay}"
                                    OnContent="On"
                                    OffContent="Off" />
                                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ArrServers.Editor.HasOptions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        Text="For anime shows (series type Anime is used for them automatically):"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <ComboBox
                                        Header="Anime quality profile"
                                        MinWidth="260"
                                        ItemsSource="{x:Bind ViewModel.ArrServers.Editor.AnimeQualityProfiles, Mode=OneWay}"
                                        SelectedIndex="{x:Bind ViewModel.ArrServers.Editor.AnimeQualityProfileIndex, Mode=TwoWay}" />
                                    <ComboBox
                                        Header="Anime root folder"
                                        MinWidth="260"
                                        ItemsSource="{x:Bind ViewModel.ArrServers.Editor.AnimeRootFolders, Mode=OneWay}"
                                        SelectedIndex="{x:Bind ViewModel.ArrServers.Editor.AnimeRootFolderIndex, Mode=TwoWay}" />
                                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ArrServers.Editor.HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Anime tags (none checked: the tags above)" Style="{StaticResource FieldLabel}" />
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ArrServers.Editor.AnimeTags, Mode=OneWay}" ItemTemplate="{StaticResource TagChoiceTemplate}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="160" MinColumnSpacing="12" MinRowSpacing="4" ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <InfoBar
                                IsOpen="{x:Bind ViewModel.ArrServers.Editor.HasError, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ArrServers.Editor.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Severity="Error"
                                Message="{x:Bind ViewModel.ArrServers.Editor.Error, Mode=OneWay}"
                                IsClosable="False" />
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.ArrServers.Editor.HasNotice, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ArrServers.Editor.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Severity="Success"
                                Message="{x:Bind ViewModel.ArrServers.Editor.Notice, Mode=OneWay}"
                                IsClosable="False" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="{x:Bind ViewModel.ArrServers.Editor.SaveLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ArrServers.Editor.SaveCommand}"
                                    IsEnabled="{x:Bind ViewModel.ArrServers.Editor.CanAct, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Cancel" Command="{x:Bind ViewModel.ArrServers.Editor.CancelCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Metadata Sources -->
            <StackPanel Spacing="12">
                <TextBlock Text="Metadata Sources" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ContentControl
                    Content="{x:Bind ViewModel.Tmdb}"
                    ContentTemplate="{StaticResource SecretCardTemplate}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" />
                <ContentControl
                    Content="{x:Bind ViewModel.Trakt}"
                    ContentTemplate="{StaticResource SecretCardTemplate}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" />
                <!-- components/trakt-connect-card.tsx's list import, while Trakt is connected. -->
                <Border Style="{StaticResource SettingsCard}" Visibility="{x:Bind ViewModel.ShowsTraktImport, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="Import a list"
                                PlaceholderText="https://trakt.tv/users/username/lists/best-of-2024"
                                Text="{x:Bind ViewModel.TraktImport.ListUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="Also works with a watchlist URL (…/users/username/watchlist). The list must be public on Trakt's side. Matching titles not already owned or requested are added to your pending Requests queue."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.TraktImport.HasError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.TraktImport.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Error"
                            Message="{x:Bind ViewModel.TraktImport.Error, Mode=OneWay}"
                            IsClosable="False" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.TraktImport.HasNotice, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.TraktImport.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Success"
                            Message="{x:Bind ViewModel.TraktImport.Notice, Mode=OneWay}"
                            IsClosable="False" />
                        <Button Content="{x:Bind ViewModel.TraktImport.ImportLabel, Mode=OneWay}" Command="{x:Bind ViewModel.TraktImport.ImportCommand}" />
                    </StackPanel>
                </Border>
                <ContentControl
                    Content="{x:Bind ViewModel.Tvdb}"
                    ContentTemplate="{StaticResource SecretCardTemplate}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" />
            </StackPanel>

            <!--
              Household channels (0.45+ calls them that): where the whole
              household's notifications are posted. Each account adds its
              own under Settings > Account > Notifications.
            -->
            <StackPanel Spacing="12">
                <TextBlock Text="Household channels" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!--
                  components/webhook-settings-card.tsx. On a 0.43+ server each
                  Sonarr/Radarr server shows its own webhook under Download
                  Clients instead (the shared URLs keep working).
                -->
                <Border Style="{StaticResource SettingsCard}" Visibility="{x:Bind ViewModel.ShowsArrCards, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Sonarr / Radarr webhooks" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Your server listens for these so Radarr/Sonarr can tell it the moment something starts or finishes downloading. Paste them into Radarr/Sonarr → Settings → Connect → Add → Webhook (method POST, trigger on Grab + Download)."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:TonePill Grid.Column="1" Text="{x:Bind ViewModel.Webhooks.ListeningBadge}" Tone="{x:Bind ViewModel.Webhooks.ListeningTone}" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Webhooks.Urls, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:WebhookUrlRow">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource FieldLabel}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{x:Bind Url}" IsReadOnly="True" />
                                            <Button Grid.Column="1" Content="{x:Bind CopyLabel, Mode=OneWay}" Command="{x:Bind CopyCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock
                            Text="{x:Bind ViewModel.Webhooks.Error, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Webhooks.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                        <Button
                            Content="Regenerate secret"
                            Command="{x:Bind ViewModel.Webhooks.AskCommand}"
                            Visibility="{x:Bind ViewModel.Webhooks.IsAsking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.Webhooks.IsConfirming, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Text="Regenerate? The URLs above stop working immediately."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <Button Content="{x:Bind ViewModel.Webhooks.ConfirmLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Webhooks.ConfirmCommand}" />
                            <Button Content="Cancel" Command="{x:Bind ViewModel.Webhooks.CancelCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ContentControl
                    Content="{x:Bind ViewModel.Discord}"
                    ContentTemplate="{StaticResource SecretCardTemplate}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" />
                <ContentControl
                    Content="{x:Bind ViewModel.Ntfy}"
                    ContentTemplate="{StaticResource SecretCardTemplate}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" />

                <!--
                  Notification channels (components/notification-channel-cards.tsx,
                  Settings › Integrations › Household channels on the website): the
                  admin's household-wide Telegram, Pushover and email relays.
                  Every notification the admin gets is also sent to each one
                  connected. Admin-only, and only from a 0.36+ server.
                -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Channels.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Telegram notifications" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="Posts to a Telegram chat, group or channel through your own bot whenever something is grabbed, downloaded, or a request is approved/rejected."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <controls:TonePill Grid.Column="1" Text="{x:Bind ViewModel.Channels.Telegram.ConnectedBadge, Mode=OneWay}" Tone="{x:Bind ViewModel.Channels.Telegram.ConnectedTone}" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <PasswordBox
                                    Header="Bot token"
                                    PlaceholderText="{x:Bind ViewModel.Channels.Telegram.SecretPlaceholder, Mode=OneWay}"
                                    Password="{x:Bind ViewModel.Channels.Telegram.BotToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Text="Message @BotFather on Telegram, send /newbot, and paste the token it gives you."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Chat ID"
                                    PlaceholderText="123456789, -100…, or @channelname"
                                    Text="{x:Bind ViewModel.Channels.Telegram.ChatId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Text="Send your bot a message (or add it to the group), then open api.telegram.org/bot&lt;token&gt;/getUpdates to find the chat’s id."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.Channels.Telegram.HasError, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Channels.Telegram.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Severity="Error"
                                Message="{x:Bind ViewModel.Channels.Telegram.Error, Mode=OneWay}"
                                IsClosable="False" />
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.Channels.Telegram.HasNotice, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Channels.Telegram.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Severity="Success"
                                Message="{x:Bind ViewModel.Channels.Telegram.Notice, Mode=OneWay}"
                                IsClosable="False" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="{x:Bind ViewModel.Channels.Telegram.SaveLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.Channels.Telegram.SaveCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Content="{x:Bind ViewModel.Channels.Telegram.RemoveLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.Channels.Telegram.RemoveCommand}"
                                    Visibility="{x:Bind ViewModel.Channels.Telegram.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.Channels.Telegram.RemoveError, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Channels.Telegram.HasRemoveError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Pushover notifications" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="Sends a push notification through Pushover whenever something is grabbed, downloaded, or a request is approved/rejected."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <controls:TonePill Grid.Column="1" Text="{x:Bind ViewModel.Channels.Pushover.ConnectedBadge, Mode=OneWay}" Tone="{x:Bind ViewModel.Channels.Pushover.ConnectedTone}" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <PasswordBox
                                    Header="Application token"
                                    PlaceholderText="{x:Bind ViewModel.Channels.Pushover.SecretPlaceholder, Mode=OneWay}"
                                    Password="{x:Bind ViewModel.Channels.Pushover.AppToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Text="Create an application at pushover.net/apps/build and copy its API token."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <PasswordBox
                                    Header="User or group key"
                                    Password="{x:Bind ViewModel.Channels.Pushover.UserKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Text="Your user key is at the top of your pushover.net dashboard."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.Channels.Pushover.HasError, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Channels.Pushover.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Severity="Error"
                                Message="{x:Bind ViewModel.Channels.Pushover.Error, Mode=OneWay}"
                                IsClosable="False" />
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.Channels.Pushover.HasNotice, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Channels.Pushover.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Severity="Success"
                                Message="{x:Bind ViewModel.Channels.Pushover.Notice, Mode=OneWay}"
                                IsClosable="False" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="{x:Bind ViewModel.Channels.Pushover.SaveLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.Channels.Pushover.SaveCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Content="{x:Bind ViewModel.Channels.Pushover.RemoveLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.Channels.Pushover.RemoveCommand}"
                                    Visibility="{x:Bind ViewModel.Channels.Pushover.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.Channels.Pushover.RemoveError, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Channels.Pushover.HasRemoveError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Email notifications" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="Emails one or more addresses through your own mail server (SMTP) whenever something is grabbed, downloaded, or a request is approved/rejected."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <controls:TonePill Grid.Column="1" Text="{x:Bind ViewModel.Channels.Email.ConnectedBadge, Mode=OneWay}" Tone="{x:Bind ViewModel.Channels.Email.ConnectedTone}" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="SMTP server"
                                    PlaceholderText="smtp.gmail.com"
                                    Text="{x:Bind ViewModel.Channels.Email.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Port"
                                    Text="{x:Bind ViewModel.Channels.Email.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Text="587 for most servers; 465 with &quot;Secure connection&quot; on."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Username"
                                    PlaceholderText="Leave blank if the server needs none"
                                    Text="{x:Bind ViewModel.Channels.Email.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <PasswordBox
                                    Header="Password"
                                    PlaceholderText="{x:Bind ViewModel.Channels.Email.SecretPlaceholder, Mode=OneWay}"
                                    Password="{x:Bind ViewModel.Channels.Email.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Text="For Gmail, an app password (myaccount.google.com/apppasswords), not your normal one."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="From address"
                                    PlaceholderText="marquee@example.com"
                                    Text="{x:Bind ViewModel.Channels.Email.From, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Send to"
                                    PlaceholderText="you@example.com, partner@example.com"
                                    Text="{x:Bind ViewModel.Channels.Email.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Text="One or more addresses, separated by commas."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox
                                Content="Secure connection from the start (TLS, usually port 465)"
                                IsChecked="{x:Bind ViewModel.Channels.Email.Secure, Mode=TwoWay}" />
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.Channels.Email.HasError, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Channels.Email.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Severity="Error"
                                Message="{x:Bind ViewModel.Channels.Email.Error, Mode=OneWay}"
                                IsClosable="False" />
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.Channels.Email.HasNotice, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Channels.Email.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Severity="Success"
                                Message="{x:Bind ViewModel.Channels.Email.Notice, Mode=OneWay}"
                                IsClosable="False" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="{x:Bind ViewModel.Channels.Email.SaveLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.Channels.Email.SaveCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Content="{x:Bind ViewModel.Channels.Email.RemoveLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.Channels.Email.RemoveCommand}"
                                    Visibility="{x:Bind ViewModel.Channels.Email.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.Channels.Email.RemoveError, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Channels.Email.HasRemoveError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ContentControl
                    Content="{x:Bind ViewModel.GenericWebhook}"
                    ContentTemplate="{StaticResource SecretCardTemplate}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
