<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings › Activity (app/settings/activity/page.tsx, the Mac's
  ActivitySettingsView), the admin's: who requested what and who reviewed
  it, most recent first. Each row is "Sam requested" and the title, a link
  to its page, with when.
-->
<UserControl
    x:Class="Marquee.Windows.Views.Settings.ActivitySettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    mc:Ignorable="d">

    <StackPanel Spacing="20">
        <StackPanel Spacing="4">
            <TextBlock Text="Activity" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="Who requested what, and who reviewed it — most recent first."
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Width="20"
            Height="20"
            HorizontalAlignment="Left" />
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap" />
            <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>
        <TextBlock
            Text="Nothing yet."
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <StackLayout Orientation="Vertical" Spacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityRow">
                    <Border Style="{StaticResource SettingsCard}" Padding="14,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Actor}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind Verb}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                                <HyperlinkButton
                                    Content="{x:Bind Title}"
                                    Command="{x:Bind Open}"
                                    CommandParameter="{x:Bind}"
                                    Padding="2,0"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind When}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
