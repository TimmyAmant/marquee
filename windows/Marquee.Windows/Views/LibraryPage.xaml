<?xml version="1.0" encoding="utf-8"?>
<!--
  app/library/page.tsx (api-v1.md section 17): everything the household
  owns in one place. Four tabs: All titles (counts, a filter bar in a rail,
  a poster grid or a table, paged as the list scrolls), Missing from
  collections, Duplicates (the admin only) and Storage.
-->
<Page
    x:Class="Marquee.Windows.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="PosterTemplate" x:DataType="vm:PosterItem">
            <controls:PosterCard Item="{x:Bind}" FillsColumn="True" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroller" ViewChanged="OnViewChanged">
            <StackPanel Padding="28,20,28,40" Spacing="20">
                <!-- The title and the tab strip. -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Library_Title" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton x:Uid="Library_TabAll" Tag="All" Click="OnTabClick" IsChecked="{x:Bind ViewModel.IsAllTab, Mode=OneWay}" />
                        <ToggleButton x:Uid="Library_TabCollections" Tag="Collections" Click="OnTabClick" IsChecked="{x:Bind ViewModel.IsCollectionsTab, Mode=OneWay}" />
                        <ToggleButton
                            x:Uid="Library_TabDuplicates"
                            Tag="Duplicates"
                            Click="OnTabClick"
                            IsChecked="{x:Bind ViewModel.IsDuplicatesTab, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowsDuplicatesTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ToggleButton x:Uid="Library_TabStorage" Tag="Storage" Click="OnTabClick" IsChecked="{x:Bind ViewModel.IsStorageTab, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- All titles -->
                <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsAllTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <!-- Nothing connected: the website's connect-first state. -->
                    <StackPanel
                        Spacing="12"
                        MaxWidth="480"
                        Padding="28"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsNotConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.ConnectMessage, Mode=OneWay}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            TextAlignment="Center" />
                        <Button
                            x:Uid="Library_OpenSettings"
                            Command="{x:Bind ViewModel.OpenSettingsCommand}"
                            Visibility="{x:Bind ViewModel.CanOpenSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- The counts strip. -->
                    <Border
                        Padding="20,14"
                        CornerRadius="12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{x:Bind ViewModel.HasCounts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.CountsLine, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind ViewModel.TrackedNote, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasTrackedNote, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- The filter bar: a rail in a narrow window, like the Browse page's. -->
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ShowsFilterBar, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="FilterRail" controls:RailScroll.IsRail="True">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                                <TextBox
                                    x:Uid="Library_SearchBox"
                                    Width="200"
                                    IsSpellCheckEnabled="False"
                                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    x:Uid="Library_TypeBox"
                                    ItemsSource="{x:Bind ViewModel.TypeOptions}"
                                    SelectedIndex="{x:Bind ViewModel.TypeIndex, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    x:Uid="Library_StatusBox"
                                    ItemsSource="{x:Bind ViewModel.StatusOptions}"
                                    SelectedIndex="{x:Bind ViewModel.StatusIndex, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    x:Uid="Library_SourceBox"
                                    ItemsSource="{x:Bind ViewModel.SourceOptions, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.SourceIndex, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    x:Uid="Library_ResolutionBox"
                                    ItemsSource="{x:Bind ViewModel.ResolutionOptions, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.ResolutionIndex, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                                <ToggleButton
                                    x:Uid="Library_HdrOnly"
                                    IsChecked="{x:Bind ViewModel.HdrOnly, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.ShowsHdrToggle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    x:Uid="Library_CodecBox"
                                    ItemsSource="{x:Bind ViewModel.CodecOptions, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.CodecIndex, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    x:Uid="Library_GenreBox"
                                    ItemsSource="{x:Bind ViewModel.GenreOptions, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.GenreIndex, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    x:Uid="Library_YearBox"
                                    ItemsSource="{x:Bind ViewModel.YearOptions, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.YearIndex, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    x:Uid="Library_SortBox"
                                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                                    SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <ToggleButton x:Uid="Library_GridButton" Command="{x:Bind ViewModel.ShowGridCommand}" IsChecked="{x:Bind ViewModel.IsGridView, Mode=OneWay}" />
                                    <ToggleButton x:Uid="Library_TableButton" Command="{x:Bind ViewModel.ShowTableCommand}" IsChecked="{x:Bind ViewModel.IsTableView, Mode=OneWay}" />
                                </StackPanel>
                                <Button
                                    x:Uid="Library_ClearFilters"
                                    Command="{x:Bind ViewModel.ClearFiltersCommand}"
                                    Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center" />
                                <controls:StatusColorKey Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                        <controls:RailArrows Grid.Column="1" Target="{x:Bind FilterRail}" VerticalAlignment="Center" Margin="0,0,0,6" />
                    </Grid>

                    <!-- Loading page 1. -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" />
                        <TextBlock x:Uid="Library_LoadingLabel" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Page 1 failed (an older server answers 404 here too). -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Uid="Library_ErrorHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Button x:Uid="Library_TryAgainAll" Command="{x:Bind ViewModel.ResetCommand}" />
                    </StackPanel>

                    <!-- Page 1 came back empty. -->
                    <TextBlock
                        x:Uid="Media_NoMatches"
                        Visibility="{x:Bind ViewModel.IsNoMatches, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Uid="Library_StillSyncing"
                        Visibility="{x:Bind ViewModel.IsStillSyncing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- The poster grid. -->
                    <ItemsRepeater
                        ItemsSource="{x:Bind ViewModel.Cards}"
                        ItemTemplate="{StaticResource PosterTemplate}"
                        Visibility="{x:Bind ViewModel.ShowsGrid, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="150" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="Uniform" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <!-- The table: one row per title, the admin also sees the file and the actions. -->
                    <Border
                        CornerRadius="12"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{x:Bind ViewModel.ShowsTable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Padding="16,10" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Library_ColumnTitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Uid="Library_ColumnYear" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" x:Uid="Library_ColumnQuality" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" x:Uid="Library_ColumnSize" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" x:Uid="Library_ColumnStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="5" x:Uid="Library_ColumnSource" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Grid.Column="6"
                                    x:Uid="Library_ColumnLocation"
                                    Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Grid.Column="7"
                                    x:Uid="Library_ColumnActions"
                                    Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="0" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LibraryRow">
                                        <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <HyperlinkButton Content="{x:Bind Name}" Command="{x:Bind Open}" CommandParameter="{x:Bind}" Padding="0" />
                                                <TextBlock Text="{x:Bind MetaLine}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Year}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <controls:TonePill Text="{x:Bind ResolutionLabel}" Tone="Accent" Visibility="{x:Bind ResolutionLabel, Converter={StaticResource StringToVisibility}}" />
                                                <controls:TonePill Text="{x:Bind HdrLabel}" Tone="Owned" Visibility="{x:Bind HdrLabel, Converter={StaticResource StringToVisibility}}" />
                                                <controls:TonePill Text="{x:Bind VideoCodecLabel}" Tone="Neutral" Visibility="{x:Bind VideoCodecLabel, Converter={StaticResource StringToVisibility}}" />
                                                <controls:TonePill Text="{x:Bind AudioCodecLabel}" Tone="Info" Visibility="{x:Bind AudioCodecLabel, Converter={StaticResource StringToVisibility}}" />
                                                <controls:TonePill Text="{x:Bind QualityName}" Tone="Neutral" Visibility="{x:Bind QualityName, Converter={StaticResource StringToVisibility}}" />
                                                <TextBlock Text="{x:Bind UpgradeLabel}" Visibility="{x:Bind UpgradeLabel, Converter={StaticResource StringToVisibility}}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorAttentionBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{x:Bind SizeLabel}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <controls:TonePill Grid.Column="4" Text="{x:Bind StatusLabel}" Tone="{x:Bind StatusTone}" Visibility="{x:Bind StatusLabel, Converter={StaticResource StringToVisibility}}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind SourceLabel}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="6"
                                                Text="{x:Bind Location}"
                                                Visibility="{x:Bind HasLocation, Converter={StaticResource BoolToVisibility}}"
                                                ToolTipService.ToolTip="{x:Bind Location}"
                                                FontFamily="Consolas"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="7" Spacing="4" Visibility="{x:Bind HasTracking, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Button Content="{x:Bind SearchLabel, Mode=OneWay}" Command="{x:Bind SearchNowCommand}" IsEnabled="{x:Bind CanAct, Mode=OneWay}" />
                                                    <Button Content="{x:Bind MonitorLabel, Mode=OneWay}" Command="{x:Bind ToggleMonitorCommand}" IsEnabled="{x:Bind CanAct, Mode=OneWay}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Text="{x:Bind Message, Mode=OneWay}"
                                                    Visibility="{x:Bind HasMessage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- Load more / Loading more… / Couldn't load more + Retry. -->
                    <Grid Height="60" Visibility="{x:Bind ViewModel.ShowsLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsLoadingPage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingPage, Mode=OneWay}" Width="20" Height="20" />
                            <TextBlock x:Uid="Browse_LoadingMore" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasPageError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                x:Uid="Browse_PageError"
                                ToolTipService.ToolTip="{x:Bind ViewModel.PageError, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                VerticalAlignment="Center" />
                            <Button x:Uid="Browse_Retry" Command="{x:Bind ViewModel.RetryPageCommand}" />
                        </StackPanel>
                        <Button
                            x:Uid="Browse_LoadMore"
                            Command="{x:Bind ViewModel.LoadMoreCommand}"
                            Visibility="{x:Bind ViewModel.ShowsLoadMoreButton, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- Missing from collections -->
                <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.IsCollectionsTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingCollections, Mode=OneWay}" Width="28" Height="28" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.IsLoadingCollections, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasCollectionsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Bind ViewModel.CollectionsError, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                        <Button x:Uid="Library_TryAgainCollections" Command="{x:Bind ViewModel.LoadCollectionsCommand}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="Library_CollectionsEmpty"
                        Visibility="{x:Bind ViewModel.IsCollectionsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Collections, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="32" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryCollectionItem">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind Heading}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                        <Button
                                            Content="{x:Bind AddAllLabel, Mode=OneWay}"
                                            Click="OnAddAllClick"
                                            DataContext="{x:Bind}"
                                            Visibility="{x:Bind ShowsAddAll, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            IsEnabled="{x:Bind CanAddAll, Mode=OneWay}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{x:Bind AddAllResult, Mode=OneWay}"
                                            Visibility="{x:Bind HasAddAllResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Content="{x:Bind RequestAllLabel, Mode=OneWay}"
                                            Click="OnRequestAllClick"
                                            DataContext="{x:Bind}"
                                            Visibility="{x:Bind ShowsRequestAll, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            IsEnabled="{x:Bind CanRequestAll, Mode=OneWay}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{x:Bind RequestAllResult, Mode=OneWay}"
                                            Visibility="{x:Bind HasRequestAllResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsRepeater ItemsSource="{x:Bind Posters}" ItemTemplate="{StaticResource PosterTemplate}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="150" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="Uniform" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Duplicates (the admin) -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsDuplicatesTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Uid="Library_DuplicatesIntro" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingDuplicates, Mode=OneWay}" Width="28" Height="28" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.IsLoadingDuplicates, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasDuplicatesError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Bind ViewModel.DuplicatesError, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                        <Button x:Uid="Library_TryAgainDuplicates" Command="{x:Bind ViewModel.LoadDuplicatesCommand}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="Library_DuplicatesEmpty"
                        Visibility="{x:Bind ViewModel.IsDuplicatesEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Duplicates, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="14" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryDuplicateItem">
                                <Border
                                    Padding="16"
                                    CornerRadius="12"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="64" Height="96" CornerRadius="6" Background="{ThemeResource LayerFillColorAltBrush}" VerticalAlignment="Top">
                                            <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <HyperlinkButton Content="{x:Bind Name}" Command="{x:Bind Open}" CommandParameter="{x:Bind}" Padding="0" FontSize="18" />
                                                <TextBlock Text="{x:Bind Year}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <controls:TonePill Text="{x:Bind ReasonLabel}" Tone="{x:Bind ReasonTone}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="4*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="Library_ColumnServer" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" x:Uid="Library_CopyLocation" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="2" x:Uid="Library_CopySize" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="3" x:Uid="Library_CopyQuality" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{x:Bind Copies}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Vertical" Spacing="6" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LibraryCopyItem">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="4*" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="120" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind ServerLine}" Style="{StaticResource BodyTextBlockStyle}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Location}" ToolTipService.ToolTip="{x:Bind Location}" FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Grid.Column="3" Text="{x:Bind QualityLabel}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Storage -->
                <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.IsStorageTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingStorage, Mode=OneWay}" Width="28" Height="28" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.IsLoadingStorage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasStorageError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Bind ViewModel.StorageError, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                        <Button x:Uid="Library_TryAgainStorage" Command="{x:Bind ViewModel.LoadStorageCommand}" />
                    </StackPanel>
                    <Border
                        Padding="20,16"
                        CornerRadius="12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{x:Bind ViewModel.HasStorageAnswer, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Library_StorageTitle" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.TotalFreeLabel, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasStorage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                Text="{x:Bind ViewModel.StorageEmptyMessage, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsStorageEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasStorage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="0" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LibraryFolderItem">
                                        <Grid Padding="0,8" ColumnSpacing="16" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Path}" ToolTipService.ToolTip="{x:Bind Path}" FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ServersLine}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind FreeLabel}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasStorage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                                    <Run Text="{x:Bind ViewModel.ForecastLine, Mode=OneWay}" />
                                    <Run Text="{x:Bind ViewModel.AroundLine, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                                <TextBlock
                                    Text="{x:Bind ViewModel.MeasuredLine, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasMeasuredLine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
