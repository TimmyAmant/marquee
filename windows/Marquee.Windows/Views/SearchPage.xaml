<?xml version="1.0" encoding="utf-8"?>
<!--
  app/search/page.tsx: "Results for …" with People, Studios, Titles and the
  theme row, each a poster grid (studios are chips). Opened from the shell's
  search box with a query, or as the Search section with none, in which case
  only the search box on the page shows.
-->
<Page
    x:Class="Marquee.Windows.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="28,20,28,28" Spacing="28">
                <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />

                <!-- The section without a query. -->
                <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.HasQuery, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}">
                    <TextBlock
                        Text="Find an actor, a studio, or a title. Every result comes from TMDb through your server."
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <AutoSuggestBox
                        x:Name="PageSearchBox"
                        PlaceholderText="Search an actor, a studio, a title…"
                        QueryIcon="Find"
                        QuerySubmitted="OnQuerySubmitted" />
                </StackPanel>

                <!-- Results. -->
                <StackPanel Spacing="28" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasPeople, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="People" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.People, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="150" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:PersonItem">
                                    <controls:PersonCard Item="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasStudios, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Studios" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ScrollViewer
                            HorizontalScrollMode="Enabled"
                            controls:WheelScroll.PassToPage="True"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Studios, Mode=OneWay}" Margin="0,0,0,8">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChipItem">
                                        <controls:StudioChip Item="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasTitles, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Titles" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Titles, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="150" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:PosterItem">
                                    <controls:PosterCard Item="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasTheme, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Bind ViewModel.ThemeTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ThemeItems, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="150" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:PosterItem">
                                    <controls:PosterCard Item="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>

                <!-- Searching… -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="28" Height="28" />
                    <TextBlock
                        Text="Searching…"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!-- Error, when there are no results to keep. -->
                <StackPanel Spacing="12" MaxWidth="440" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.ShowsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Couldn't search" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}" />
                </StackPanel>

                <!-- TMDb isn't configured on the server (api-v1.md deviation 7). -->
                <StackPanel Spacing="12" MaxWidth="440" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.IsTmdbMissing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Connect TMDb to start browsing" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.TmdbMissingMessage, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        Content="Open Settings"
                        Command="{x:Bind ViewModel.OpenSettingsCommand}"
                        Visibility="{x:Bind ViewModel.CanOpenSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
