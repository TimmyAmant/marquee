<?xml version="1.0" encoding="utf-8"?>
<!--
  app/settings/layout.tsx with components/settings-nav.tsx (the Mac's
  SettingsRootView): "Settings", the tabs across the top as pills (solid for
  the current one, like the rail), and the chosen tab below, all in one
  centered column up to 760 wide. Account and About are everyone's;
  Integrations, Activity and Jobs the admin's. Each tab is its own view
  under Views/Settings, made the first time it's picked; the code-behind
  swaps them and styles the current pill.
-->
<Page
    x:Class="Marquee.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
          A tab that isn't current: the rail's hover fill (textPrimary 10% on
          hover, 16% pressed) under a textSecondary label that brightens to
          textPrimary.
        -->
        <ControlTemplate x:Key="SettingsTabTemplate" TargetType="Button">
            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="StateFill.Opacity" Value="1" />
                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource MarqueeNavTextBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="StateFill.Opacity" Value="1" />
                                <Setter Target="StateFill.Background" Value="{ThemeResource MarqueeNavPressedBrush}" />
                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource MarqueeNavTextBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border
                    x:Name="StateFill"
                    Background="{ThemeResource MarqueeNavHoverBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
                <ContentPresenter
                    x:Name="ContentPresenter"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Foreground="{TemplateBinding Foreground}"
                    FontSize="{TemplateBinding FontSize}"
                    FontWeight="{TemplateBinding FontWeight}"
                    AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </ControlTemplate>

        <!-- The current tab: a solid textPrimary pill with a bg0 label; the state fill vanishes into it. -->
        <ControlTemplate x:Key="SettingsTabCurrentTemplate" TargetType="Button">
            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="StateFill.Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="StateFill.Opacity" Value="1" />
                                <Setter Target="StateFill.Background" Value="{ThemeResource MarqueeNavPressedBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border
                    x:Name="StateFill"
                    Background="{ThemeResource MarqueeNavHoverBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
                <ContentPresenter
                    x:Name="ContentPresenter"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Foreground="{TemplateBinding Foreground}"
                    FontSize="{TemplateBinding FontSize}"
                    FontWeight="{TemplateBinding FontWeight}"
                    AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </ControlTemplate>

        <Style x:Key="SettingsTabStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource SettingsTabTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource MarqueeNavTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>

        <Style x:Key="SettingsTabCurrentStyle" TargetType="Button" BasedOn="{StaticResource SettingsTabStyle}">
            <Setter Property="Template" Value="{StaticResource SettingsTabCurrentTemplate}" />
            <Setter Property="Background" Value="{ThemeResource MarqueeNavCurrentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource MarqueeNavCurrentTextBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <!-- The Mac's Settings column (SettingsLayout.columnWidth): up to 760 wide; a Stretch element under its MaxWidth is centered in the page. -->
        <StackPanel Padding="28,20,28,40" Spacing="20" MaxWidth="760" HorizontalAlignment="Stretch">
            <StackPanel Spacing="14">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

                <!-- The tabs (components/settings-nav.tsx): icon and title, the admin's three hidden from a member. -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button
                        x:Name="AccountTabButton"
                        Style="{StaticResource SettingsTabStyle}"
                        Tag="Account"
                        Click="OnTabClick"
                        AutomationProperties.Name="Account">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                            <TextBlock Text="Account" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="IntegrationsTabButton"
                        Style="{StaticResource SettingsTabStyle}"
                        Tag="Integrations"
                        Click="OnTabClick"
                        AutomationProperties.Name="Integrations"
                        Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE71B;" FontSize="14" />
                            <TextBlock Text="Integrations" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ActivityTabButton"
                        Style="{StaticResource SettingsTabStyle}"
                        Tag="Activity"
                        Click="OnTabClick"
                        AutomationProperties.Name="Activity"
                        Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE823;" FontSize="14" />
                            <TextBlock Text="Activity" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="JobsTabButton"
                        Style="{StaticResource SettingsTabStyle}"
                        Tag="Jobs"
                        Click="OnTabClick"
                        AutomationProperties.Name="Jobs"
                        Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE895;" FontSize="14" />
                            <TextBlock Text="Jobs" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="AboutTabButton"
                        Style="{StaticResource SettingsTabStyle}"
                        Tag="About"
                        Click="OnTabClick"
                        AutomationProperties.Name="About">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE946;" FontSize="14" />
                            <TextBlock Text="About" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- The current tab's view (Views/Settings), set by the code-behind. -->
            <ContentPresenter x:Name="TabContent" HorizontalContentAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</Page>
