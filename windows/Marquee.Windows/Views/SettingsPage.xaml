<?xml version="1.0" encoding="utf-8"?>
<!--
  app/settings/page.tsx's Account tab for this PC: the account card and its
  edit form, the Notifications switch, the household members list
  (household-members-list.tsx, each row with its photo) with the admin's
  Add member, the server card (Change server, Sign out) and About. Each card is a Border with the card brushes; the page is a single
  column. The member dialogs are shown by the code-behind.
-->
<Page
    x:Class="Marquee.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <!-- The Mac's Settings column (SettingsLayout.columnWidth): up to 760 wide; a Stretch element under its MaxWidth is centered in the page. -->
        <StackPanel Padding="28,20,28,40" Spacing="20" MaxWidth="760" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Account -->
            <TextBlock Text="Account" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.Username, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.RoleLabel, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                    <TextBox
                        Header="Name"
                        PlaceholderText="How the household sees you"
                        Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="80" />
                    <PasswordBox
                        Header="New password"
                        PlaceholderText="Leave blank to keep the current password"
                        Password="{x:Bind ViewModel.NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox
                        Header="Confirm new password"
                        Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox
                        Header="Current password"
                        PlaceholderText="Needed only when setting a new password"
                        Password="{x:Bind ViewModel.CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Text="Setting a new password signs you out of every device, including this PC."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                        Severity="Error"
                        Message="{x:Bind ViewModel.SaveError, Mode=OneWay}"
                        IsClosable="False" />
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasSaveNotice, Mode=OneWay}"
                        Severity="Success"
                        Message="{x:Bind ViewModel.SaveNotice, Mode=OneWay}"
                        IsClosable="False" />
                    <Button
                        Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!--
              Notifications (Settings > Account > Notifications on the
              website): Windows notifications straight from the server's
              stream while the app runs. Asked once after signing in; this
              switch changes the answer.
            -->
            <TextBlock Text="Notifications" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="8">
                    <ToggleSwitch
                        Header="Show notifications on this PC"
                        IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.NotificationsSupported, Mode=OneWay}"
                        OnContent="On"
                        OffContent="Off" />
                    <TextBlock
                        Text="When something starts downloading, is ready to watch, or a request is approved or declined, Windows shows it while Marquee is open. It comes straight from your Marquee server; nothing goes through an outside service."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.NotificationsNote, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.NotificationsNote, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Household members: every account for the admin, only your own for a member -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Household members" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.MembersCaption, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Content="Add member"
                    Command="{x:Bind ViewModel.AddMemberCommand}"
                    Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Bottom" />
            </Grid>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMembersNotice, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasMembersNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Severity="Success"
                Message="{x:Bind ViewModel.MembersNotice, Mode=OneWay}"
                IsClosable="False" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMembersActionError, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasMembersActionError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Severity="Error"
                Message="{x:Bind ViewModel.MembersActionError, Mode=OneWay}"
                IsClosable="False" />
            <Border Style="{StaticResource SettingsCard}" Padding="0">
                <StackPanel>
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsMembersLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsMembersLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Width="20"
                        Height="20"
                        Margin="20"
                        HorizontalAlignment="Left" />
                    <StackPanel Padding="20" Spacing="8" Visibility="{x:Bind ViewModel.ShowsMembersError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.MembersError, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                        <Button Content="Try again" Command="{x:Bind ViewModel.LoadMembersCommand}" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Members, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HouseholdMemberRow">
                                <StackPanel>
                                    <Border
                                        Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Visibility="{x:Bind ShowsDivider, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Padding="20,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:AvatarView
                                            Grid.Column="0"
                                            Label="{x:Bind Label}"
                                            AvatarUrl="{x:Bind AvatarUrl}"
                                            Diameter="36"
                                            VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind Label}"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind UsernameLine}"
                                                Visibility="{x:Bind UsernameLine, Converter={StaticResource StringToVisibility}}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <controls:TonePill
                                                Text="Admin"
                                                Tone="{x:Bind AdminTone}"
                                                Visibility="{x:Bind IsAdminRow, Converter={StaticResource BoolToVisibility}}" />
                                            <controls:TonePill
                                                Text="You"
                                                Tone="{x:Bind YouTone}"
                                                Visibility="{x:Bind IsCurrentUser, Converter={StaticResource BoolToVisibility}}" />
                                            <Button
                                                Content="Edit"
                                                Command="{x:Bind Edit}"
                                                CommandParameter="{x:Bind}"
                                                Visibility="{x:Bind CanEdit, Converter={StaticResource BoolToVisibility}}" />
                                            <Button
                                                Content="Remove"
                                                Command="{x:Bind Remove}"
                                                CommandParameter="{x:Bind}"
                                                Visibility="{x:Bind CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Server -->
            <TextBlock Text="Server" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="This PC is signed in to" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.ServerLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ServerVersionLabel, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        Text="Sign out revokes this PC's session only; other devices stay signed in. Change server forgets this server and starts over at the connect screen."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand}" />
                        <Button Content="Change server" Command="{x:Bind ViewModel.ChangeServerCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.AppVersionLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <!-- Updates (Services/Updater.cs): the Mac's Settings › About, for this PC. -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="{x:Bind Updater.StatusText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Updater.HasFailed, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}" />
                        <TextBlock
                            Text="{x:Bind Updater.StatusText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Updater.HasFailed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <!-- The server: up to date, or how to update it. -->
                        <TextBlock
                            Text="{x:Bind ViewModel.ServerUpdateText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasServerUpdateText, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ProgressBar
                            MaxWidth="360"
                            HorizontalAlignment="Stretch"
                            Minimum="0"
                            Maximum="100"
                            Value="{x:Bind Updater.ProgressPercent, Mode=OneWay}"
                            IsIndeterminate="{x:Bind Updater.IsProgressIndeterminate, Mode=OneWay}"
                            Visibility="{x:Bind Updater.IsInstalling, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Check for updates"
                                Click="OnCheckForUpdatesClick"
                                Visibility="{x:Bind Updater.CanCheck, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Content="{x:Bind Updater.UpdateLabel, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnInstallUpdateClick"
                                ToolTipService.ToolTip="Downloads the installer, checks it, then Marquee closes, updates and reopens"
                                Visibility="{x:Bind Updater.CanInstall, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Content="What's new"
                                Click="OnReleaseNotesClick"
                                Visibility="{x:Bind Updater.ShowsUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Content="Download manually"
                                Click="OnReleaseNotesClick"
                                Visibility="{x:Bind Updater.ShowsManualDownload, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsAboutLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsAboutLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Left" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasAboutError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.AboutError, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                        <Button Content="Try again" Command="{x:Bind ViewModel.LoadAboutCommand}" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.AboutRows, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FactRow">
                                <Grid ColumnSpacing="12" MinHeight="34" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind Label}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Value}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        VerticalAlignment="Center"
                                        IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.AboutLinks, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinkItem">
                                <HyperlinkButton Content="{x:Bind Label}" Command="{x:Bind Open}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
