<?xml version="1.0" encoding="utf-8"?>
<!--
  app/settings/page.tsx's Account tab for this PC: the account card and its
  edit form, the Notifications switch, the admin's notification channels
  (Telegram, Pushover, email), the household members list
  (household-members-list.tsx, each row with its photo) with the admin's
  Add member, the server card (Change server, Sign out) and About. Each card is a Border with the card brushes; the page is a single
  column. The member dialogs are shown by the code-behind.
-->
<Page
    x:Class="Marquee.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Marquee.Windows.ViewModels"
    xmlns:controls="using:Marquee.Windows.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <!-- The Mac's Settings column (SettingsLayout.columnWidth): up to 760 wide; a Stretch element under its MaxWidth is centered in the page. -->
        <StackPanel Padding="28,20,28,40" Spacing="20" MaxWidth="760" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Account -->
            <TextBlock Text="Account" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.Username, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.RoleLabel, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                    <TextBox
                        Header="Name"
                        PlaceholderText="How the household sees you"
                        Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="80" />
                    <PasswordBox
                        Header="New password"
                        PlaceholderText="Leave blank to keep the current password"
                        Password="{x:Bind ViewModel.NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox
                        Header="Confirm new password"
                        Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- An account made by Plex/Jellyfin sign-in has no password yet, so none to give. -->
                    <PasswordBox
                        Header="Current password"
                        PlaceholderText="Needed only when setting a new password"
                        Password="{x:Bind ViewModel.CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.NeedsCurrentPassword, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Text="Setting a new password signs you out of every device, including this PC."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                        Severity="Error"
                        Message="{x:Bind ViewModel.SaveError, Mode=OneWay}"
                        IsClosable="False" />
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasSaveNotice, Mode=OneWay}"
                        Severity="Success"
                        Message="{x:Bind ViewModel.SaveNotice, Mode=OneWay}"
                        IsClosable="False" />
                    <Button
                        Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!--
              Linked accounts: the Plex and Jellyfin accounts that sign in to
              yours. Only servers with Plex/Jellyfin sign-in send `linked`.
            -->
            <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.ShowsLinkedAccounts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Linked accounts" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Plex" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.PlexLinkStatus, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button
                                    Content="Link Plex"
                                    Command="{x:Bind ViewModel.LinkPlexCommand}"
                                    Visibility="{x:Bind ViewModel.CanLinkPlex, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Button
                                    Content="Unlink"
                                    Command="{x:Bind ViewModel.UnlinkPlexCommand}"
                                    Visibility="{x:Bind ViewModel.CanUnlinkPlex, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsLinkingPlex, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsLinkingPlex, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="Waiting for Plex… Finish signing in in the browser window that just opened."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelLinkPlexCommand}" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.JellyfinName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.JellyfinLinkStatus, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button
                                    Content="{x:Bind ViewModel.LinkJellyfinLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.LinkJellyfinCommand}"
                                    Visibility="{x:Bind ViewModel.CanLinkJellyfin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Button
                                    Content="Unlink"
                                    Command="{x:Bind ViewModel.UnlinkJellyfinCommand}"
                                    Visibility="{x:Bind ViewModel.CanUnlinkJellyfin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Text="Your account has no Marquee password, so it signs in only with a linked account. Set one above to sign in with a username and password too."
                            Visibility="{x:Bind ViewModel.HasNoPassword, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.HasLinksError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasLinksError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Error"
                            Message="{x:Bind ViewModel.LinksError, Mode=OneWay}"
                            IsClosable="False" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.HasLinksNotice, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasLinksNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Success"
                            Message="{x:Bind ViewModel.LinksNotice, Mode=OneWay}"
                            IsClosable="False" />
                    </StackPanel>
                </Border>

                <!--
                  Request from my Plex Watchlist (plex-watchlist.tsx): shown
                  while Plex is linked. Turning it on is a plex.tv approval
                  like Link Plex; once on, the switches, the last check,
                  Check now and Turn off.
                -->
                <Border Style="{StaticResource SettingsCard}" Visibility="{x:Bind ViewModel.ShowsPlexWatchlist, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Request from my Plex Watchlist" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="New movies and shows you add to your Watchlist on Plex are requested for you, the same as pressing Request. Marquee keeps a Plex sign-in for this until you turn it off."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <controls:TonePill Text="{x:Bind ViewModel.PlexWatchlistBadge, Mode=OneWay}" Tone="{x:Bind ViewModel.PlexWatchlistTone}" VerticalAlignment="Center" />
                                <Button
                                    Content="Turn on"
                                    Command="{x:Bind ViewModel.TurnOnPlexWatchlistCommand}"
                                    Visibility="{x:Bind ViewModel.CanTurnOnPlexWatchlist, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsTurningOnPlexWatchlist, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsTurningOnPlexWatchlist, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="Waiting for Plex… finish in the browser."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelTurnOnPlexWatchlistCommand}" />
                        </Grid>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsPlexWatchlistOn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <ToggleSwitch
                                    Header="Movies"
                                    IsOn="{x:Bind ViewModel.PlexWatchlistMovies, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanChangePlexWatchlist, Mode=OneWay}"
                                    OnContent="On"
                                    OffContent="Off" />
                                <ToggleSwitch
                                    Header="TV shows"
                                    IsOn="{x:Bind ViewModel.PlexWatchlistTv, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanChangePlexWatchlist, Mode=OneWay}"
                                    OnContent="On"
                                    OffContent="Off" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.PlexWatchlistSummary, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Bind ViewModel.CheckPlexWatchlistLabel, Mode=OneWay}" Command="{x:Bind ViewModel.CheckPlexWatchlistCommand}" />
                                <Button Content="Turn off" Command="{x:Bind ViewModel.TurnOffPlexWatchlistCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.PlexWatchlistLastError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasPlexWatchlistLastError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind ViewModel.PlexWatchlistError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasPlexWatchlistError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--
              Notifications (Settings > Account > Notifications on the
              website): Windows notifications straight from the server's
              stream while the app runs. Asked once after signing in; this
              switch changes the answer.
            -->
            <TextBlock Text="Notifications" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="8">
                    <ToggleSwitch
                        Header="Show notifications on this PC"
                        IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.NotificationsSupported, Mode=OneWay}"
                        OnContent="On"
                        OffContent="Off" />
                    <TextBlock
                        Text="When something starts downloading, is ready to watch, or a request is approved or declined, Windows shows it while Marquee is open. It comes straight from your Marquee server; nothing goes through an outside service."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.NotificationsNote, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.NotificationsNote, Mode=OneWay, Converter={StaticResource StringToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--
              Notification channels (components/notification-channel-cards.tsx,
              Settings › Integrations › Notifications on the website): the
              admin's household-wide Telegram, Pushover and email relays.
              Every notification the admin gets is also sent to each one
              connected. Admin-only, and only from a 0.36+ server.
            -->
            <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.Channels.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Notification channels" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="For the whole household: everything you’re notified about is also sent to each channel connected here. The server sends a test before saving."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Telegram notifications" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Posts to a Telegram chat, group or channel through your own bot whenever something is grabbed, downloaded, or a request is approved/rejected."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:TonePill Grid.Column="1" Text="{x:Bind ViewModel.Channels.Telegram.ConnectedBadge, Mode=OneWay}" Tone="{x:Bind ViewModel.Channels.Telegram.ConnectedTone}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="4">
                            <PasswordBox
                                Header="Bot token"
                                PlaceholderText="{x:Bind ViewModel.Channels.Telegram.SecretPlaceholder, Mode=OneWay}"
                                Password="{x:Bind ViewModel.Channels.Telegram.BotToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="Message @BotFather on Telegram, send /newbot, and paste the token it gives you."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="Chat ID"
                                PlaceholderText="123456789, -100…, or @channelname"
                                Text="{x:Bind ViewModel.Channels.Telegram.ChatId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="Send your bot a message (or add it to the group), then open api.telegram.org/bot&lt;token&gt;/getUpdates to find the chat’s id."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.Channels.Telegram.HasError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Channels.Telegram.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Error"
                            Message="{x:Bind ViewModel.Channels.Telegram.Error, Mode=OneWay}"
                            IsClosable="False" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.Channels.Telegram.HasNotice, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Channels.Telegram.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Success"
                            Message="{x:Bind ViewModel.Channels.Telegram.Notice, Mode=OneWay}"
                            IsClosable="False" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="{x:Bind ViewModel.Channels.Telegram.SaveLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Channels.Telegram.SaveCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Content="{x:Bind ViewModel.Channels.Telegram.RemoveLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Channels.Telegram.RemoveCommand}"
                                Visibility="{x:Bind ViewModel.Channels.Telegram.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.Channels.Telegram.RemoveError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Channels.Telegram.HasRemoveError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Pushover notifications" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Sends a push notification through Pushover whenever something is grabbed, downloaded, or a request is approved/rejected."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:TonePill Grid.Column="1" Text="{x:Bind ViewModel.Channels.Pushover.ConnectedBadge, Mode=OneWay}" Tone="{x:Bind ViewModel.Channels.Pushover.ConnectedTone}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="4">
                            <PasswordBox
                                Header="Application token"
                                PlaceholderText="{x:Bind ViewModel.Channels.Pushover.SecretPlaceholder, Mode=OneWay}"
                                Password="{x:Bind ViewModel.Channels.Pushover.AppToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="Create an application at pushover.net/apps/build and copy its API token."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <PasswordBox
                                Header="User or group key"
                                Password="{x:Bind ViewModel.Channels.Pushover.UserKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="Your user key is at the top of your pushover.net dashboard."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.Channels.Pushover.HasError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Channels.Pushover.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Error"
                            Message="{x:Bind ViewModel.Channels.Pushover.Error, Mode=OneWay}"
                            IsClosable="False" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.Channels.Pushover.HasNotice, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Channels.Pushover.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Success"
                            Message="{x:Bind ViewModel.Channels.Pushover.Notice, Mode=OneWay}"
                            IsClosable="False" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="{x:Bind ViewModel.Channels.Pushover.SaveLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Channels.Pushover.SaveCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Content="{x:Bind ViewModel.Channels.Pushover.RemoveLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Channels.Pushover.RemoveCommand}"
                                Visibility="{x:Bind ViewModel.Channels.Pushover.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.Channels.Pushover.RemoveError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Channels.Pushover.HasRemoveError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Email notifications" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Emails one or more addresses through your own mail server (SMTP) whenever something is grabbed, downloaded, or a request is approved/rejected."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:TonePill Grid.Column="1" Text="{x:Bind ViewModel.Channels.Email.ConnectedBadge, Mode=OneWay}" Tone="{x:Bind ViewModel.Channels.Email.ConnectedTone}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="SMTP server"
                                PlaceholderText="smtp.gmail.com"
                                Text="{x:Bind ViewModel.Channels.Email.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="Port"
                                Text="{x:Bind ViewModel.Channels.Email.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="587 for most servers; 465 with &quot;Secure connection&quot; on."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="Username"
                                PlaceholderText="Leave blank if the server needs none"
                                Text="{x:Bind ViewModel.Channels.Email.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <PasswordBox
                                Header="Password"
                                PlaceholderText="{x:Bind ViewModel.Channels.Email.SecretPlaceholder, Mode=OneWay}"
                                Password="{x:Bind ViewModel.Channels.Email.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="For Gmail, an app password (myaccount.google.com/apppasswords), not your normal one."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="From address"
                                PlaceholderText="marquee@example.com"
                                Text="{x:Bind ViewModel.Channels.Email.From, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox
                                Header="Send to"
                                PlaceholderText="you@example.com, partner@example.com"
                                Text="{x:Bind ViewModel.Channels.Email.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="One or more addresses, separated by commas."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox
                            Content="Secure connection from the start (TLS, usually port 465)"
                            IsChecked="{x:Bind ViewModel.Channels.Email.Secure, Mode=TwoWay}" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.Channels.Email.HasError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Channels.Email.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Error"
                            Message="{x:Bind ViewModel.Channels.Email.Error, Mode=OneWay}"
                            IsClosable="False" />
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.Channels.Email.HasNotice, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Channels.Email.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Severity="Success"
                            Message="{x:Bind ViewModel.Channels.Email.Notice, Mode=OneWay}"
                            IsClosable="False" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="{x:Bind ViewModel.Channels.Email.SaveLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Channels.Email.SaveCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Content="{x:Bind ViewModel.Channels.Email.RemoveLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Channels.Email.RemoveCommand}"
                                Visibility="{x:Bind ViewModel.Channels.Email.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.Channels.Email.RemoveError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Channels.Email.HasRemoveError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Household members: every account for the admin, only your own for a member -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Household members" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.MembersCaption, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Content="Add member"
                    Command="{x:Bind ViewModel.AddMemberCommand}"
                    Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Bottom" />
            </Grid>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMembersNotice, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasMembersNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Severity="Success"
                Message="{x:Bind ViewModel.MembersNotice, Mode=OneWay}"
                IsClosable="False" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMembersActionError, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasMembersActionError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Severity="Error"
                Message="{x:Bind ViewModel.MembersActionError, Mode=OneWay}"
                IsClosable="False" />
            <Border Style="{StaticResource SettingsCard}" Padding="0">
                <StackPanel>
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsMembersLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsMembersLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Width="20"
                        Height="20"
                        Margin="20"
                        HorizontalAlignment="Left" />
                    <StackPanel Padding="20" Spacing="8" Visibility="{x:Bind ViewModel.ShowsMembersError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.MembersError, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                        <Button Content="Try again" Command="{x:Bind ViewModel.LoadMembersCommand}" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Members, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HouseholdMemberRow">
                                <StackPanel>
                                    <Border
                                        Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Visibility="{x:Bind ShowsDivider, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Padding="20,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:AvatarView
                                            Grid.Column="0"
                                            Label="{x:Bind Label}"
                                            AvatarUrl="{x:Bind AvatarUrl}"
                                            Diameter="36"
                                            VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind Label}"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind UsernameLine}"
                                                Visibility="{x:Bind UsernameLine, Converter={StaticResource StringToVisibility}}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind LastActiveLine}"
                                                Visibility="{x:Bind LastActiveLine, Converter={StaticResource StringToVisibility}}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- An empty text collapses the pill. -->
                                            <controls:TonePill Text="{x:Bind PlexTag}" Tone="{x:Bind LinkTone}" />
                                            <controls:TonePill Text="{x:Bind JellyfinTag}" Tone="{x:Bind LinkTone}" />
                                            <controls:TonePill
                                                Text="Admin"
                                                Tone="{x:Bind AdminTone}"
                                                Visibility="{x:Bind IsAdminRow, Converter={StaticResource BoolToVisibility}}" />
                                            <controls:TonePill Text="{x:Bind TrustedTag}" Tone="{x:Bind AdminTone}" />
                                            <controls:TonePill
                                                Text="You"
                                                Tone="{x:Bind YouTone}"
                                                Visibility="{x:Bind IsCurrentUser, Converter={StaticResource BoolToVisibility}}" />
                                            <Button
                                                Content="Edit"
                                                Command="{x:Bind Edit}"
                                                CommandParameter="{x:Bind}"
                                                Visibility="{x:Bind CanEdit, Converter={StaticResource BoolToVisibility}}" />
                                            <Button
                                                Content="Remove"
                                                Command="{x:Bind Remove}"
                                                CommandParameter="{x:Bind}"
                                                Visibility="{x:Bind CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!--
              The admin's Plex and Jellyfin members: import them (each gets a
              member account linked to theirs), and whether a Plex/Jellyfin
              user without an account gets one on first sign-in.
            -->
            <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.ShowsMediaServerMembers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Bind ViewModel.MediaServerMembersTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Text="{x:Bind ViewModel.NoMediaServersExplanation, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasNoMediaServers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Import from Plex"
                                Command="{x:Bind ViewModel.ImportFromPlexCommand}"
                                Visibility="{x:Bind ViewModel.CanImportFromPlex, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Content="{x:Bind ViewModel.ImportFromJellyfinLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ImportFromJellyfinCommand}"
                                Visibility="{x:Bind ViewModel.CanImportFromJellyfin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasSignInSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ToggleSwitch
                                Header="{x:Bind ViewModel.MediaServerSignupHeader, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.MediaServerSignup, Mode=TwoWay}"
                                OnContent="On"
                                OffContent="Off" />
                            <TextBlock
                                Text="{x:Bind ViewModel.MediaServerSignupExplanation, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Server -->
            <TextBlock Text="Server" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="This PC is signed in to" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.ServerLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ServerVersionLabel, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        Text="Sign out revokes this PC's session only; other devices stay signed in. Change server forgets this server and starts over at the connect screen."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand}" />
                        <Button Content="Change server" Command="{x:Bind ViewModel.ChangeServerCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.AppVersionLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <!-- Updates (Services/Updater.cs): the Mac's Settings › About, for this PC. -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="{x:Bind Updater.StatusText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Updater.HasFailed, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}" />
                        <TextBlock
                            Text="{x:Bind Updater.StatusText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Updater.HasFailed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <!-- The server: up to date, or how to update it. -->
                        <TextBlock
                            Text="{x:Bind ViewModel.ServerUpdateText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasServerUpdateText, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ProgressBar
                            MaxWidth="360"
                            HorizontalAlignment="Stretch"
                            Minimum="0"
                            Maximum="100"
                            Value="{x:Bind Updater.ProgressPercent, Mode=OneWay}"
                            IsIndeterminate="{x:Bind Updater.IsProgressIndeterminate, Mode=OneWay}"
                            Visibility="{x:Bind Updater.IsInstalling, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Check for updates"
                                Click="OnCheckForUpdatesClick"
                                Visibility="{x:Bind Updater.CanCheck, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Content="{x:Bind Updater.UpdateLabel, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnInstallUpdateClick"
                                ToolTipService.ToolTip="Downloads the installer, checks it, then Marquee closes, updates and reopens"
                                Visibility="{x:Bind Updater.CanInstall, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Content="What's new"
                                Click="OnReleaseNotesClick"
                                Visibility="{x:Bind Updater.ShowsUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Content="Download manually"
                                Click="OnReleaseNotesClick"
                                Visibility="{x:Bind Updater.ShowsManualDownload, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsAboutLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsAboutLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Left" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasAboutError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.AboutError, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                        <Button Content="Try again" Command="{x:Bind ViewModel.LoadAboutCommand}" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.AboutRows, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FactRow">
                                <Grid ColumnSpacing="12" MinHeight="34" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind Label}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Value}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        VerticalAlignment="Center"
                                        IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.AboutLinks, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinkItem">
                                <HyperlinkButton Content="{x:Bind Label}" Command="{x:Bind Open}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
