<Project>
  <!--
    Shared by every project under windows/: the platform-neutral Core library,
    its tests and the WinUI app. Warnings are errors here for the same reason
    the Mac build fails on a single compiler warning: a warning that survives
    one release is invisible by the next.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <!--
      The release this source becomes (package.json's version; CI also
      passes it as -p:Version when it publishes). The updater compares it
      with GitHub's latest release, so it has to be the real one.
    -->
    <Version>0.38.0</Version>
    <Authors>Timmy Amant</Authors>
    <Product>Marquee</Product>
    <Copyright>Copyright (c) Timmy Amant</Copyright>
    <RepositoryUrl>https://github.com/TimmyAmant/marquee</RepositoryUrl>

    <!--
      Keep the informational version a plain "0.38.0": it is what the
      User-Agent header reports and what the updater compares, and the
      commit hash the SDK appends by default is noise in a server log.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
